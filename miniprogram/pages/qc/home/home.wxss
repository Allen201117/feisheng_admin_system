/* Compact list row variants */
.list-row-sm { display:flex; justify-content:space-between; align-items:center; gap:var(--sp-2); padding:12rpx 0; min-height:0; border-bottom:1rpx solid var(--border-light); }
.list-row-sm-last { display:flex; justify-content:space-between; align-items:center; gap:var(--sp-2); padding:12rpx 0; min-height:0; }
.list-row-footer { display:flex; align-items:center; justify-content:center; padding-top:12rpx; border-top:1rpx solid var(--border); margin-top:8rpx; }
.icon-sm { width:36rpx; height:36rpx; }
