/* pages/qc/home/home.wxss */
.container {
  background:
    radial-gradient(circle at 10% 8%, rgba(128, 196, 255, 0.16) 0%, transparent 24%),
    radial-gradient(circle at 88% 12%, rgba(176, 234, 222, 0.16) 0%, transparent 22%),
    linear-gradient(180deg, #eef7ff 0%, #f9fcff 100%);
}

.qc-header {
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 34rpx;
  background: linear-gradient(135deg, #0f558f, #1c79ba);
  border-radius: 26rpx;
  margin-bottom: 24rpx;
  color: #fff;
  border: 2rpx solid #c7def5;
  box-shadow: 0 14rpx 30rpx rgba(8, 82, 168, 0.2);
}

.user-avatar {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: 700;
  margin-right: 0;
}

.user-info {
  flex: 1;
}

.user-name {
  font-size: 40rpx;
  font-weight: 700;
  display: block;
}

.user-role {
  font-size: 28rpx;
  opacity: 0.85;
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  background: linear-gradient(180deg, #ffffff 0%, #f9fbfe 100%);
  border-radius: 999rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 2rpx solid #d8e4f3;
  padding: 8rpx;
}

.tab {
  flex: 1 1 220rpx;
  text-align: center;
  padding: 16rpx 0;
  font-size: 30rpx;
  color: #4f6584;
  position: relative;
  border-radius: 999rpx;
}

.tab-active {
  color: #0b62b4;
  font-weight: 700;
  background: linear-gradient(135deg, #eaf4ff 0%, #f5faff 100%);
}

.tab-active::after {
  display: none;
}

.log-card {
  padding: 24rpx;
  border: 2rpx solid #e8eef8;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 38, 84, 0.06);
}

.log-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.log-employee {
  font-size: 38rpx;
  font-weight: 700;
  color: #1f3554;
}

.log-body {
  margin-bottom: 16rpx;
}

.log-row {
  display: flex;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 8rpx 0;
  font-size: 32rpx;
}

.log-label {
  color: #7a8da4;
  width: 140rpx;
  flex-shrink: 0;
}

.log-footer {
  text-align: right;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf2f8;
}
