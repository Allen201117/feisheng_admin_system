/* Stepper */
.qc-inspect-page { padding-bottom: 188rpx; }
.stepper-row { display:flex; gap:var(--sp-1); margin-bottom:var(--sp-2); }
.stepper-btn { width:84rpx; height:96rpx; font-size:48rpx; font-weight:var(--fw-bold); border:none; background:var(--bg-elevated); color:var(--text-primary); border:1rpx solid var(--border); border-radius:var(--r-md); display:flex; align-items:center; justify-content:center; padding:0; }
button.stepper-btn::after { border:none; }
.stepper-input { flex:1; text-align:center; font-size:48rpx; font-weight:var(--fw-bold); }
/* Preview card */
.preview-card { border-radius:var(--r-lg); background:var(--bg-elevated); padding:var(--sp-2); margin:var(--sp-2) 0; border:1rpx solid var(--border-light); }
.preview-row { display:flex; justify-content:space-between; align-items:center; padding:12rpx 0; border-bottom:1rpx solid var(--border-light); }
.preview-row-last { display:flex; justify-content:space-between; align-items:center; padding:12rpx 0; }
.detail-row { display:flex; justify-content:space-between; align-items:center; padding:16rpx 0; border-bottom:1rpx solid var(--border-light); }
.detail-row-last { display:flex; justify-content:space-between; align-items:center; padding:16rpx 0; }
.d-block { display:block; } .mb-1 { margin-bottom:var(--sp-1); } .mb-2 { margin-bottom:var(--sp-2); }
