<view class="container qc-inspect-page" wx:if="{{logDetail}}">

  <view class="page-header">
    <view class="page-header-left">
      <text class="page-header-title">质检详情</text>
      <text class="page-header-subtitle">核对数量后提交质检结果</text>
    </view>
  </view>

  <!-- Worklog Detail -->
  <view class="card-bento">
    <text class="menu-group-title d-block mb-1">报工详情</text>
    <view class="detail-row">
      <text class="text-tertiary text-sm">员工</text>
      <text class="font-medium">{{logDetail.user_name}}</text>
    </view>
    <view class="detail-row">
      <text class="text-tertiary text-sm">订单</text>
      <text class="font-medium">{{logDetail.order_name}}</text>
    </view>
    <view class="detail-row">
      <text class="text-tertiary text-sm">工序</text>
      <text class="font-medium">{{logDetail.process_name}}</text>
    </view>
    <view class="detail-row">
      <text class="text-tertiary text-sm">提交数量</text>
      <text class="font-semibold">{{logDetail.quantity}} 件</text>
    </view>
    <view class="detail-row-last">
      <text class="text-tertiary text-sm">单价</text>
      <text class="font-medium">¥{{logDetail.snapshot_price}}/件</text>
    </view>
  </view>

  <!-- QC Operation -->
  <view class="card-bento">
    <text class="menu-group-title d-block mb-2">质检操作</text>

    <view class="field-group">
      <text class="field-label">合格数量</text>
      <view class="stepper-row">
        <button class="stepper-btn" bindtap="subQty" hover-class="tap-button-hover">-</button>
        <input class="field-input stepper-input" type="number" value="{{passedQty}}" bindinput="onPassedQtyInput" />
        <button class="stepper-btn" bindtap="addQty" hover-class="tap-button-hover">+</button>
      </view>
    </view>

    <button class="btn-secondary btn-block" bindtap="setAllPass" hover-class="tap-button-hover">全部合格</button>

    <!-- Inspect Preview -->
    <view class="preview-card">
      <view class="preview-row">
        <text class="text-secondary text-sm">合格率</text>
        <text class="font-semibold {{passRateClass}}">{{passRateDisplay}}%</text>
      </view>
      <view class="preview-row">
        <text class="text-secondary text-sm">不合格数</text>
        <text class="font-semibold text-red">{{rejectedQty}} 件</text>
      </view>
      <view class="preview-row-last">
        <text class="text-secondary text-sm">员工实得</text>
        <text class="font-semibold text-accent num">¥{{actualAmountDisplay}}</text>
      </view>
    </view>

  </view>

  <view class="bottom-action-bar">
    <button class="btn btn-primary btn-block" bindtap="onSubmitInspect" disabled="{{loading}}" hover-class="tap-button-hover">
      {{loading ? '提交中...' : '确认质检结果'}}
    </button>
  </view>

</view>

<view wx:else class="container">
  <view class="skeleton skeleton-title"></view>
  <view class="skeleton skeleton-card"></view>
  <view class="skeleton skeleton-card"></view>
</view>
