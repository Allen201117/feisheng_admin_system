page,
view,
text,
input,
button {
  box-sizing: border-box;
}

page {
  background: #f4f7fb;
  overflow-x: hidden;
}

.container {
  width: 100%;
  max-width: 100vw;
  min-height: 100vh;
  padding: 24rpx;
  overflow-x: hidden;
  background: #f4f7fb;
}

.platform-hero {
  width: 100%;
  padding: 30rpx;
  border-radius: 18rpx;
  background: #23415f;
  color: #fff;
}

.hero-copy {
  width: 100%;
  min-width: 0;
}

.hero-title,
.hero-subtitle,
.hero-user {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.hero-title {
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: bold;
}

.hero-subtitle {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.86);
}

.hero-user {
  margin-top: 8rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: rgba(255, 255, 255, 0.78);
}

.hero-logout {
  width: 100%;
  min-height: 84rpx;
  margin: 24rpx 0 0;
  padding: 0 24rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #fff;
  font-size: 32rpx;
  line-height: 84rpx;
  text-align: center;
}

.hero-logout::after,
.full-button::after,
.status-button::after,
.reset-btn::after {
  border: none;
}

.overview-panel {
  width: 100%;
  margin: 20rpx 0;
}

.overview-item {
  width: 100%;
  margin-bottom: 16rpx;
  padding: 24rpx;
  border: 2rpx solid #dde7f1;
  border-radius: 16rpx;
  background: #fff;
}

.overview-label,
.overview-value {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.overview-label {
  font-size: 28rpx;
  line-height: 1.4;
  color: #60768c;
}

.overview-value {
  margin-top: 8rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: bold;
  color: #1f3550;
}

.overview-code {
  font-size: 36rpx;
}

.current-panel {
  width: 100%;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 3rpx solid #2367a0;
  border-radius: 18rpx;
  background: #eef7ff;
}

.current-header,
.org-title-row {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
}

.current-label {
  display: block;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: bold;
  color: #2367a0;
}

.current-name,
.current-line {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.current-name {
  margin-top: 14rpx;
  font-size: 40rpx;
  line-height: 1.35;
  font-weight: bold;
  color: #1f3550;
}

.current-line {
  margin-top: 10rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #526b84;
}

.section-card {
  width: 100%;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 2rpx solid #dde7f1;
  border-radius: 18rpx;
  background: #fff;
  box-shadow: none;
}

.section-heading {
  display: flex;
  align-items: flex-start;
  gap: 18rpx;
  width: 100%;
  margin-bottom: 24rpx;
}

.section-number {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 0 0 52rpx;
  width: 52rpx;
  height: 52rpx;
  border-radius: 50%;
  background: #2367a0;
  color: #fff;
  font-size: 30rpx;
  line-height: 52rpx;
  font-weight: bold;
  text-align: center;
}

.section-copy {
  flex: 1;
  min-width: 0;
}

.section-title,
.section-note {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.section-title {
  margin: 0;
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: bold;
  color: #203650;
}

.section-note {
  margin-top: 6rpx;
  font-size: 28rpx;
  line-height: 1.45;
  color: #6d8197;
}

.org-card {
  width: 100%;
  margin-bottom: 18rpx;
  padding: 24rpx;
  border: 2rpx solid #dfe8f2;
  border-radius: 16rpx;
  background: #fbfdff;
}

.org-card-selected {
  border-width: 3rpx;
  border-color: #2367a0;
  background: #eef7ff;
}

.org-name,
.org-meta,
.selected-mark,
.admin-name,
.admin-phone {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.org-name,
.admin-name {
  flex: 1;
  min-width: 0;
  font-size: 34rpx;
  line-height: 1.4;
  font-weight: bold;
  color: #203650;
}

.org-meta,
.admin-phone {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #64798e;
}

.billing-line {
  display: flex;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 12rpx;
  width: 100%;
  margin-top: 14rpx;
}

.billing-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  padding: 8rpx 16rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: bold;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.billing-summary {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  line-height: 1.45;
  color: #64798e;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.billing-active {
  color: #1f7a3f;
  background: #edf8f0;
}

.billing-trial {
  color: #1d5f96;
  background: #eef7ff;
}

.billing-grace {
  color: #9a5b00;
  background: #fff7df;
}

.billing-expired {
  color: #b42318;
  background: #fff1f1;
}

.billing-muted {
  color: #53677d;
  background: #eef3f7;
}

.billing-status-box {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 24rpx;
  border: 2rpx solid #dbe8f3;
  border-radius: 16rpx;
  background: #f7fbff;
}

.billing-status-title,
.billing-status-text,
.history-title,
.history-main,
.history-sub {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.billing-status-title {
  font-size: 36rpx;
  line-height: 1.4;
  font-weight: bold;
  color: #203650;
}

.billing-status-text {
  margin-top: 8rpx;
  font-size: 30rpx;
  line-height: 1.5;
  color: #536b84;
}

.picker-field {
  width: 100%;
  min-height: 96rpx;
  padding: 22rpx 24rpx;
  border: 2rpx solid #d6e2ee;
  border-radius: 14rpx;
  background: #fbfdff;
  color: #203650;
  font-size: 34rpx;
  line-height: 1.45;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.billing-history {
  width: 100%;
  margin-top: 28rpx;
  padding-top: 4rpx;
}

.history-title {
  font-size: 32rpx;
  line-height: 1.45;
  font-weight: bold;
  color: #203650;
}

.history-row {
  width: 100%;
  margin-top: 16rpx;
  padding: 20rpx;
  border: 2rpx solid #dfe8f2;
  border-radius: 14rpx;
  background: #fbfdff;
}

.history-main {
  font-size: 30rpx;
  line-height: 1.45;
  font-weight: bold;
  color: #203650;
}

.history-sub {
  margin-top: 6rpx;
  font-size: 26rpx;
  line-height: 1.45;
  color: #6f8498;
}

.selected-mark {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #dcefff;
  color: #1d5f96;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: bold;
  text-align: center;
}

.status-chip {
  display: flex;
  align-items: center;
  justify-content: center;
  max-width: 100%;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: bold;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.status-active {
  color: #1f7a3f;
  background: #edf8f0;
}

.status-disabled {
  color: #a13a18;
  background: #fff1e9;
}

.form-list {
  width: 100%;
}

.input-group {
  width: 100%;
  margin-bottom: 24rpx;
}

.input-label {
  display: block;
  max-width: 100%;
  margin-bottom: 12rpx;
  font-size: 32rpx;
  line-height: 1.4;
  color: #526b84;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.input-field {
  width: 100%;
  min-height: 96rpx;
  padding: 0 24rpx;
  border: 2rpx solid #d6e2ee;
  border-radius: 14rpx;
  background: #fbfdff;
  color: #203650;
  font-size: 34rpx;
  line-height: 96rpx;
}

.code-input {
  font-weight: bold;
  letter-spacing: 0;
}

.button-stack {
  width: 100%;
}

.full-button,
.status-button,
.reset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 92rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 14rpx;
  font-size: 34rpx;
  line-height: 1.35;
  font-weight: bold;
  white-space: normal;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.status-button {
  margin-top: 18rpx;
}

.danger-btn {
  color: #b42318;
  background: #fff1f1;
}

.enable-btn {
  color: #1f7a3f;
  background: #edf8f0;
}

.admin-list {
  width: 100%;
  margin-top: 24rpx;
  padding-top: 4rpx;
}

.admin-row {
  width: 100%;
  margin-top: 18rpx;
  padding: 22rpx;
  border: 2rpx solid #dfe8f2;
  border-radius: 16rpx;
  background: #fbfdff;
}

.admin-info {
  width: 100%;
}

.reset-btn {
  margin-top: 18rpx;
  min-height: 84rpx;
  color: #2f4d69;
  background: #eef5fb;
  font-size: 32rpx;
}

.empty-row,
.empty-state {
  width: 100%;
  padding: 34rpx 10rpx;
  text-align: center;
  color: #768ca3;
  font-size: 30rpx;
  line-height: 1.5;
}

.empty-text {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-all;
}
