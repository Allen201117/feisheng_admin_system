/* Factory select cards */
.org-card { background:var(--bg-card); border-radius:var(--r-lg); padding:var(--sp-2); margin-bottom:var(--sp-1); border:1rpx solid var(--border); box-shadow:var(--shadow-card); }
.org-card-selected { border-color:var(--blue-600); }
.org-card:active { box-shadow:var(--shadow-elevated); }
/* Subscription current plan card */
.sub-current-plan { background:var(--bg-elevated); border-radius:var(--r-lg); padding:var(--sp-2); margin-bottom:var(--sp-2); border:1rpx solid var(--border-light); }
.sub-history { margin-top:var(--sp-2); }
.billing-record { background:var(--bg-card); border-radius:var(--r-md); padding:var(--sp-2); margin-bottom:var(--sp-1); border:1rpx solid var(--border); }
.admin-list { margin-top:var(--sp-2); }
.admin-card { background:var(--bg-card); border-radius:var(--r-md); padding:var(--sp-2); margin-bottom:var(--sp-1); border:1rpx solid var(--border); }
.d-block { display:block; } .mt-1 { margin-top:var(--sp-1); } .mt-2 { margin-top:var(--sp-2); }
.mt-8 { margin-top:8rpx; } .mt-12 { margin-top:12rpx; } .mt-4 { margin-top:4rpx; }
.mb-6 { margin-bottom:6rpx; } .mb-1 { margin-bottom:var(--sp-1); }
.hero-value-sm { display:block; font-size:var(--fs-lg); font-weight:var(--fw-bold); color:var(--text-primary); margin-top:var(--sp-1); }
