.container {
  min-height: 100vh;
  padding: 28rpx;
  background: #eef3f7;
}

.platform-hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 34rpx 30rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2f4761, #44627f);
  color: #fff;
}

.hero-title,
.hero-subtitle,
.hero-user {
  display: block;
}

.hero-title {
  font-size: 44rpx;
  font-weight: bold;
}

.hero-subtitle,
.hero-user {
  margin-top: 10rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.82);
}

.hero-action-pill {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255,255,255,0.16);
  font-size: 26rpx;
}

.section-card {
  margin-bottom: 22rpx;
  padding: 28rpx;
}

.panel-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #23384f;
}

.panel-title-note {
  font-size: 24rpx;
  color: #7a8ba0;
}

.input-group {
  margin-bottom: 18rpx;
}

.input-label {
  display: block;
  margin-bottom: 10rpx;
  font-size: 26rpx;
  color: #65758a;
}

.input-field,
.picker-field {
  min-height: 84rpx;
  padding: 0 22rpx;
  border-radius: 16rpx;
  border: 2rpx solid #dce5ee;
  background: #fbfcfd;
  font-size: 30rpx;
  color: #23384f;
}

.picker-field {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.action-btn {
  margin-top: 10rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999rpx;
  font-size: 32rpx;
}

.org-card {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #e8eef5;
}

.admin-list {
  margin-top: 22rpx;
  border-top: 1rpx solid #e8eef5;
}

.admin-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0 0;
}

.org-name,
.org-meta {
  display: block;
}

.org-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #203650;
}

.org-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #7b8da1;
}

.small-btn {
  width: 124rpx;
  min-width: 124rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
}

.small-btn::after {
  border: none;
}

.danger-btn {
  color: #b42318;
  background: #fff1f1;
}

.enable-btn {
  color: #1f7a3f;
  background: #edf8f0;
}

.reset-btn {
  color: #2f4d69;
  background: #eef5fb;
}
