<view class="container">
  <view class="platform-hero hero-panel">
    <view>
      <text class="hero-title">平台管理</text>
      <text class="hero-subtitle">工厂开通与状态管理</text>
      <text class="hero-user">{{userInfo.name}}</text>
    </view>
    <view class="hero-action-pill" bindtap="onLogout">退出</view>
  </view>

  <view class="card section-card">
    <view class="panel-title-row">
      <text class="section-title">创建工厂</text>
      <text class="panel-title-note">工厂码登录使用</text>
    </view>
    <view class="input-group">
      <text class="input-label">工厂名称</text>
      <input class="input-field" value="{{orgForm.org_name}}" data-field="org_name" bindinput="onOrgInput" placeholder="例如 测试一厂" />
    </view>
    <view class="input-group">
      <text class="input-label">工厂码</text>
      <input class="input-field" value="{{orgForm.factory_code}}" data-field="factory_code" bindinput="onOrgInput" placeholder="例如 A001" />
    </view>
    <view class="input-group">
      <text class="input-label">联系人</text>
      <input class="input-field" value="{{orgForm.contact_name}}" data-field="contact_name" bindinput="onOrgInput" placeholder="可选" />
    </view>
    <view class="input-group">
      <text class="input-label">联系电话</text>
      <input class="input-field" value="{{orgForm.contact_phone}}" data-field="contact_phone" bindinput="onOrgInput" placeholder="可选" />
    </view>
    <button class="btn-primary btn-block action-btn" bindtap="createOrganization">创建工厂</button>
  </view>

  <view class="card section-card">
    <view class="panel-title-row">
      <text class="section-title">创建工厂管理员</text>
      <text class="panel-title-note">默认需首次改密</text>
    </view>
    <picker mode="selector" range="{{organizations}}" range-key="org_name" bindchange="chooseAdminOrg">
      <view class="picker-field">
        <text>{{adminForm.org_id ? '已选择工厂' : '请选择工厂'}}</text>
      </view>
    </picker>
    <view class="input-group">
      <text class="input-label">姓名</text>
      <input class="input-field" value="{{adminForm.name}}" data-field="name" bindinput="onAdminInput" placeholder="管理员姓名" />
    </view>
    <view class="input-group">
      <text class="input-label">手机号</text>
      <input class="input-field" value="{{adminForm.phone}}" data-field="phone" bindinput="onAdminInput" placeholder="管理员手机号" type="number" />
    </view>
    <view class="input-group">
      <text class="input-label">初始密码</text>
      <input class="input-field" value="{{adminForm.password}}" data-field="password" bindinput="onAdminInput" placeholder="不填则默认为手机号" password="{{true}}" />
    </view>
    <button class="btn-primary btn-block action-btn" bindtap="createFactoryAdmin">创建管理员</button>

    <view wx:if="{{factoryAdmins.length > 0}}" class="admin-list">
      <view wx:for="{{factoryAdmins}}" wx:key="_id" class="admin-row">
        <view>
          <text class="org-name">{{item.name}}</text>
          <text class="org-meta">{{item.phone}}</text>
        </view>
        <button class="small-btn reset-btn" data-index="{{index}}" bindtap="resetFactoryAdminPassword">重置</button>
      </view>
    </view>
  </view>

  <view class="card section-card">
    <view class="panel-title-row">
      <text class="section-title">工厂列表</text>
      <text class="panel-title-note">{{organizations.length}} 家</text>
    </view>
    <view wx:if="{{organizations.length === 0 && !loading}}" class="empty-state">
      <text class="empty-text">暂无工厂</text>
    </view>
    <view wx:for="{{organizations}}" wx:key="_id" class="org-card">
      <view>
        <text class="org-name">{{item.org_name}}</text>
        <text class="org-meta">{{item.factory_code}} · {{item.status === 'active' ? '启用中' : '已停用'}}</text>
        <text class="org-meta" wx:if="{{item.contact_name || item.contact_phone}}">{{item.contact_name}} {{item.contact_phone}}</text>
      </view>
      <button class="small-btn {{item.status === 'active' ? 'danger-btn' : 'enable-btn'}}" data-index="{{index}}" bindtap="toggleOrganization">
        {{item.status === 'active' ? '停用' : '启用'}}
      </button>
    </view>
  </view>
</view>
