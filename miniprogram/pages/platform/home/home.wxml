<view class="container platform-page">

  <!-- Hero -->
  <view class="hero hero-boss">
    <view class="hero-top">
      <view class="hero-left">
        <text class="hero-title">平台管理</text>
        <text class="hero-subtitle">多工厂统一维护</text>
        <text class="hero-meta">{{userInfo.name}}</text>
      </view>
      <view class="hero-action" bindtap="onLogout">退出</view>
    </view>
  </view>

  <!-- 状态总览：点数字筛选，再点一次回到全部 -->
  <view class="org-overview">
    <view wx:for="{{overviewCards}}" wx:key="key" class="org-overview-item tone-{{item.key}} {{item.active ? 'is-active' : ''}}" data-key="{{item.key}}" bindtap="onOverviewTap" hover-class="tap-card-hover" hover-stay-time="80">
      <text class="org-overview-value">{{item.value}}</text>
      <text class="org-overview-label">{{item.label}}</text>
    </view>
  </view>

  <view class="list-search-row">
    <input class="field-input list-search-input" placeholder="搜索工厂名称、工厂码、联系人" value="{{orgSearchKeyword}}" bindinput="onOrgSearchInput" confirm-type="search" />
    <view wx:if="{{orgSearchKeyword}}" class="btn-sm btn-sm-secondary list-search-clear tappable" bindtap="clearOrgSearch" hover-class="tap-button-hover">清除</view>
  </view>

  <view class="org-toolbar">
    <text class="org-toolbar-count">{{rows.length}} 家<text wx:if="{{activeFilter !== 'all' || orgSearchKeyword}}">（已筛选）</text></text>
    <view class="org-sort tappable" bindtap="toggleSort" hover-class="tap-chip-hover">{{sortLabel}} · 切换</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading && organizations.length === 0}}">
    <view class="skeleton skeleton-box"></view>
    <view class="skeleton skeleton-box"></view>
    <view class="skeleton skeleton-box"></view>
  </view>

  <!-- 加载失败 -->
  <view wx:elif="{{loadError}}" class="empty">
    <text class="empty-title">工厂列表没加载出来</text>
    <text class="empty-desc d-block">{{loadError}}</text>
    <view class="empty-action tappable" bindtap="loadOrganizations" hover-class="tap-button-hover">重新加载</view>
  </view>

  <view wx:elif="{{organizations.length === 0}}" class="empty">
    <text class="empty-title">还没有工厂</text>
    <text class="empty-desc d-block">点下面的「新建工厂」开始</text>
  </view>

  <view wx:elif="{{rows.length === 0}}" class="empty">
    <text class="empty-title">没有符合条件的工厂</text>
    <text class="empty-desc d-block">换个名称、工厂码或联系人再试</text>
    <view class="empty-action secondary tappable" bindtap="clearAllFilters" hover-class="tap-button-hover">看全部工厂</view>
  </view>

  <view wx:else class="card-group org-list">
    <view wx:for="{{rows}}" wx:key="_id" class="card-group-row org-row tappable" data-id="{{item._id}}" bindtap="openOrg" hover-class="tap-row-hover">
      <view class="org-row-main">
        <view class="flex-row gap-1">
          <text class="list-row-title">{{item.org_name}}</text>
          <text class="badge badge-slate org-code">{{item.factory_code}}</text>
        </view>
        <text class="list-row-subtitle">{{item.contact_text}}</text>
      </view>
      <view class="org-row-side">
        <text class="badge {{item.bucket_badge_class}}">{{item.bucket_label}}</text>
        <text class="org-row-expiry {{item.expiry_text_class}}">{{item.expiry_text}}</text>
      </view>
      <text class="org-row-chevron">›</text>
    </view>
  </view>

  <view class="bottom-action-bar">
    <button class="btn btn-primary btn-block" bindtap="openCreate" hover-class="tap-button-hover">新建工厂</button>
  </view>

</view>

<!-- 新建工厂弹层 -->
<view wx:if="{{showCreate}}" class="modal-overlay" bindtap="closeCreate">
  <view class="modal-sheet modal-bottom-sheet" catchtap>
    <view class="sheet-head">
      <text class="sheet-title">新建工厂</text>
      <text class="btn-sm btn-ghost" bindtap="closeCreate">关闭</text>
    </view>
    <scroll-view scroll-y class="modal-sheet-body modal-scroll-body sheet-body">
      <view class="field-group">
        <text class="field-label">工厂名称 *</text>
        <input class="field-input" value="{{createForm.org_name}}" data-field="org_name" bindinput="onCreateInput" placeholder="例如 华锦服饰" />
      </view>
      <view class="field-group">
        <text class="field-label">工厂码 *</text>
        <input class="field-input font-bold" value="{{createForm.factory_code}}" data-field="factory_code" bindinput="onCreateInput" placeholder="例如 HJ01" maxlength="12" />
        <text class="field-hint d-block">员工登录时要输入。2–12 位字母或数字，会自动转成大写</text>
      </view>
      <view class="field-group">
        <text class="field-label">联系人</text>
        <input class="field-input" value="{{createForm.contact_name}}" data-field="contact_name" bindinput="onCreateInput" placeholder="选填" />
      </view>
      <view class="field-group">
        <text class="field-label">联系电话</text>
        <input class="field-input" value="{{createForm.contact_phone}}" data-field="contact_phone" bindinput="onCreateInput" placeholder="选填" type="number" />
      </view>
      <view wx:if="{{createError}}" class="notice notice-red">{{createError}}</view>
      <view class="notice notice-blue">创建后直接进入这家工厂，接着添加老板账号、开通订阅</view>
      <button class="btn btn-primary btn-block" bindtap="submitCreate" loading="{{creating}}" disabled="{{creating}}">创建并进入</button>
    </scroll-view>
  </view>
</view>
