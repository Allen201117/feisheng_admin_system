/* 平台管理 · 工厂详情（只放本页特有的布局，颜色/字号全部走 app.wxss 设计 Token） */
.d-block { display: block; }
.org-code { font-variant-numeric: tabular-nums; letter-spacing: 0.04em; }

.onboard { flex-direction: column; align-items: flex-start; gap: 6rpx; }

.detail-head { align-items: flex-start; gap: var(--sp-2); }
.detail-head-main { min-width: 0; }
.detail-name {
  display: block;
  font-size: var(--fs-lg);
  font-weight: var(--fw-bold);
  color: var(--text-primary);
  line-height: 1.25;
  word-break: break-all;
}
.detail-badges { margin-top: 10rpx; }
.detail-meta { margin-top: 10rpx; font-size: var(--fs-xs); color: var(--text-secondary); line-height: 1.5; }

.section-head { margin-bottom: var(--sp-1); }

/* 订阅卡 */
.sub-plan { margin-top: 10rpx; font-size: var(--fs-sm); color: var(--text-secondary); }
.sub-date {
  margin-top: 6rpx;
  font-size: var(--fs-xl);
  font-weight: var(--fw-bold);
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}
.sub-expiry { margin-top: 6rpx; font-size: var(--fs-sm); font-weight: var(--fw-semibold); }
.sub-btn { margin-top: var(--sp-2); }

/* 老板账号（动作按钮与员工列表同一套样式语言） */
.admin-item { padding: var(--sp-1) 0; border-bottom: 1rpx solid var(--border-light); }
.admin-item:last-of-type { border-bottom: none; }
.admin-row { padding: 0; border-bottom: none; }
.admin-actions {
  display: grid;
  grid-template-columns: 1.3fr 1fr 0.8fr;
  gap: 10rpx;
  padding-top: 16rpx;
}
.admin-action {
  min-height: 60rpx;
  border-radius: 999rpx;
  background: var(--surface-strong);
  color: var(--text-primary);
  font-size: var(--fs-2xs);
  font-weight: var(--fw-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
}
.admin-action.primary { background: var(--blue-100); color: var(--blue-600); }
.admin-action.danger { background: var(--red-50); color: var(--red-600); }
.admin-action.success { background: var(--green-100); color: var(--green-600); }

/* 开通记录 */
.record-main { min-width: 0; }
.record-empty { padding: var(--sp-2) 0 var(--sp-1); }

.danger-zone { margin-top: var(--sp-3); }
.danger-zone .field-hint { margin-top: var(--sp-1); }

/* 底部弹层（与订单详情弹层同结构） */
.sheet-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-2) var(--sp-2) 0;
}
.sheet-title { font-size: var(--fs-md); font-weight: var(--fw-bold); color: var(--text-primary); }
.sheet-body { text-align: left; }
.sheet-body .notice { margin-top: var(--sp-1); }
.sheet-body .btn { margin-top: var(--sp-1); }

/* 续费预览 */
.renew-preview {
  padding: var(--sp-2);
  border-radius: 20rpx;
  background: var(--blue-50);
  border: 1rpx solid var(--blue-100);
}
.renew-dates { margin-top: 6rpx; align-items: baseline; font-variant-numeric: tabular-nums; }
.renew-old { font-size: var(--fs-sm); color: var(--text-secondary); text-decoration: line-through; }
.renew-new { font-size: var(--fs-lg); font-weight: var(--fw-bold); color: var(--text-primary); }

/* 续费提交失败后锁定的选项 */
.is-locked { opacity: 0.5; }
