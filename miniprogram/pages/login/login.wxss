.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 24rpx 222rpx;
  background: #F5F5F7;
}

.login-content {
  max-width: 720rpx;
  margin: 0 auto;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 12rpx 6rpx 34rpx;
}

.login-logo {
  width: 94rpx;
  height: 94rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: #FFFFFF;
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.06);
}

.login-brand-copy {
  flex: 1;
  min-width: 0;
}

.login-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #1D1D1F;
}

.login-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.35;
  color: #6E6E73;
}

.login-card {
  padding: 32rpx;
  border-radius: 30rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(229,229,234,0.86);
  box-shadow: 0 2rpx 10rpx rgba(15,23,42,0.04);
}

.login-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.login-card-copy {
  flex: 1;
  min-width: 0;
}

.login-card-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 700;
  color: #1D1D1F;
}

.login-card-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.4;
  color: #6E6E73;
}

.login-status-badge {
  flex-shrink: 0;
  margin-top: 2rpx;
}

.login-field {
  margin-bottom: 21rpx;
}

.login-field:last-child {
  margin-bottom: 0;
}

.login-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #6E6E73;
}

.login-input {
  width: 100%;
  height: 86rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid rgba(229,229,234,0.95);
  background: #F8FAFC;
  color: #1D1D1F;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-input::placeholder {
  color: #B0B3BA;
}

.login-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: #A0A4AC;
}

.login-password-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.login-password-input {
  flex: 1;
  min-width: 0;
}

.login-pwd-toggle {
  width: 84rpx;
  min-height: 70rpx;
  border-radius: 999rpx;
  color: #007AFF;
  font-size: 27rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.login-tip-card {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.72);
  border: 1rpx solid rgba(229,229,234,0.72);
}

.login-tip-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.45;
  color: #8A8F98;
}

.login-tip-text + .login-tip-text {
  margin-top: 4rpx;
}

.login-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(245,245,247,0.94);
  backdrop-filter: blur(24rpx);
  border-top: 1rpx solid rgba(229,229,234,0.86);
  box-sizing: border-box;
}

.login-consent-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 2rpx 10rpx;
}

.login-privacy-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.35;
  color: #6E6E73;
  white-space: nowrap;
}

.login-primary-btn {
  width: 100%;
  min-height: 82rpx;
  border-radius: 22rpx;
  border: none;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.3;
  box-shadow: none;
}

.login-primary-btn::after {
  border: none;
}

.login-primary-btn[disabled] {
  opacity: 0.48;
}

.login-quick-entry {
  min-height: 60rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  color: #007AFF;
  font-size: 25rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal-body {
  text-align: left;
}

.block {
  display: block;
}
