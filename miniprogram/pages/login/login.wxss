.login-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 42rpx 24rpx 222rpx;
  background: linear-gradient(180deg, #F7F8FA 0%, #EEF2F7 100%);
}

.login-content {
  max-width: 720rpx;
  margin: 0 auto;
}

.login-brand {
  display: flex;
  align-items: center;
  gap: 22rpx;
  padding: 12rpx 6rpx 34rpx;
}

.login-logo {
  width: 94rpx;
  height: 94rpx;
  border-radius: 24rpx;
  flex-shrink: 0;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-card);
}

.login-brand-copy {
  flex: 1;
  min-width: 0;
}

.login-title {
  display: block;
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #1D1D1F;
}

.login-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.35;
  color: var(--text-secondary);
}

.login-card {
  padding: 32rpx;
  border-radius: 30rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-elevated);
}

.login-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.login-card-copy {
  flex: 1;
  min-width: 0;
}

.login-card-title {
  display: block;
  font-size: 38rpx;
  line-height: 1.18;
  font-weight: 700;
  color: #1D1D1F;
}

.login-card-subtitle {
  display: block;
  margin-top: 6rpx;
  font-size: 25rpx;
  line-height: 1.4;
  color: var(--text-secondary);
}

.login-status-badge {
  flex-shrink: 0;
  margin-top: 2rpx;
}

.login-field {
  margin-bottom: 21rpx;
}

.login-field:last-child {
  margin-bottom: 0;
}

.login-label {
  display: block;
  margin-bottom: 8rpx;
  font-size: 25rpx;
  line-height: 1.35;
  font-weight: 600;
  color: var(--text-secondary);
}

.login-input {
  width: 100%;
  height: 86rpx;
  padding: 0 24rpx;
  border-radius: 20rpx;
  border: 1rpx solid var(--hairline);
  background: var(--bg-card-soft);
  color: #1D1D1F;
  font-size: 30rpx;
  box-sizing: border-box;
}

.login-input::placeholder {
  color: var(--text-placeholder);
}

.login-hint {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--text-tertiary);
}

.login-password-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.login-password-input {
  flex: 1;
  min-width: 0;
}

.login-pwd-toggle {
  width: 84rpx;
  min-height: 70rpx;
  border-radius: 999rpx;
  color: #007AFF;
  font-size: 27rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.login-forgot-wrap {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-top: 10rpx;
}

.login-forgot-link {
  font-size: 23rpx;
  font-weight: 600;
  color: #007AFF;
  padding: 4rpx 4rpx;
}

.login-forgot-bubble {
  margin-top: 8rpx;
  max-width: 520rpx;
  padding: 16rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(0,122,255,0.08);
  border: 1rpx solid rgba(0,122,255,0.22);
}

.login-forgot-bubble-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.45;
  color: var(--text-secondary);
}

.login-tip-card {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 24rpx;
  background: rgba(255,255,255,0.86);
  border: 1rpx solid var(--hairline);
  box-shadow: 0 8rpx 20rpx rgba(15,23,42,0.05);
}

.login-tip-text {
  display: block;
  font-size: 23rpx;
  line-height: 1.45;
  color: var(--text-tertiary);
}

.login-tip-text + .login-tip-text {
  margin-top: 4rpx;
}

.login-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 50;
  padding: 14rpx 24rpx;
  padding-bottom: calc(14rpx + env(safe-area-inset-bottom));
  background: rgba(251,252,254,0.94);
  backdrop-filter: blur(24rpx);
  border-top: 1rpx solid var(--hairline);
  box-shadow: 0 -10rpx 30rpx rgba(15,23,42,0.08);
  box-sizing: border-box;
}

.login-consent-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 0 2rpx 10rpx;
}

.login-privacy-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 1.35;
  color: var(--text-secondary);
  white-space: nowrap;
}

.login-primary-btn {
  width: 100%;
  min-height: 82rpx;
  border-radius: 22rpx;
  border: none;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1.3;
  box-shadow: var(--shadow-blue);
}

.login-primary-btn::after {
  border: none;
}

.login-primary-btn[disabled] {
  opacity: 0.48;
}

.login-quick-entry {
  min-height: 60rpx;
  margin-top: 10rpx;
  border-radius: 999rpx;
  color: #007AFF;
  font-size: 25rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-modal-body {
  text-align: left;
}

.block {
  display: block;
}
