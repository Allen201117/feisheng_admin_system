<view class="login-page">

  <view class="login-content">
    <view class="login-brand">
      <image class="login-logo" src="/images/logo.png" mode="aspectFit" />
      <view class="login-brand-copy">
        <text class="login-title">工厂记账系统</text>
        <text class="login-subtitle">考勤、报工、质检和工资统一协同</text>
      </view>
    </view>

    <view class="login-card">
      <view class="login-card-head">
        <view class="login-card-copy">
          <text class="login-card-title">账号登录</text>
          <text class="login-card-subtitle">{{hasRememberedLoginInfo ? '已带出上次账号，请输入密码登录' : '请输入工厂码、姓名、手机号与密码'}}</text>
        </view>
        <view wx:if="{{existingUser}}" class="badge badge-green login-status-badge">已有登录态</view>
      </view>

      <view class="login-field">
        <text class="login-label">工厂码</text>
        <input
          class="login-input"
          placeholder="例如 A001"
          value="{{factoryCode}}"
          bindinput="onInputFactoryCode"
          maxlength="20"
        />
      </view>

      <view class="login-field">
        <text class="login-label">姓名</text>
        <input
          class="login-input"
          placeholder="请输入真实姓名"
          value="{{name}}"
          bindinput="onInputName"
          maxlength="20"
        />
      </view>

      <view class="login-field">
        <text class="login-label">手机号</text>
        <input
          class="login-input"
          placeholder="请输入手机号"
          type="number"
          value="{{phone}}"
          bindinput="onInputPhone"
          maxlength="11"
        />
        <text class="login-hint">同一手机号可在不同工厂分别开通账号</text>
      </view>

      <view class="login-field">
        <text class="login-label">密码</text>
        <view class="login-password-row">
          <input
            class="login-input login-password-input"
            placeholder="请输入密码"
            password="{{!showPassword}}"
            value="{{password}}"
            bindinput="onInputPassword"
            maxlength="20"
          />
          <text class="login-pwd-toggle" bindtap="togglePassword" hover-class="tap-chip-hover">{{showPassword ? '隐藏' : '显示'}}</text>
        </view>
      </view>
    </view>

    <view class="login-tip-card">
      <text class="login-tip-text">首次登录请联系管理员开通账号；登录成功后会记住登录态。</text>
      <text class="login-tip-text">未勾选同意前不会登录，也不会采集手机号用于账号绑定。</text>
    </view>
  </view>

  <view class="login-bottom-bar">
    <checkbox-group bindchange="onConsentCheck">
      <label class="login-consent-row">
        <checkbox value="agree" checked="{{consentChecked}}" color="#007AFF" />
        <text class="login-privacy-text">我已阅读并同意<text class="text-accent" catchtap="openPrivacyPolicy">《隐私政策》</text>和<text class="text-accent" catchtap="openUserAgreement">《用户服务协议》</text></text>
      </label>
    </checkbox-group>

    <button
      class="login-primary-btn"
      bindtap="onLogin"
      disabled="{{loading}}"
      hover-class="tap-button-hover"
    >
      {{loading ? '登录中...' : '登录'}}
    </button>

    <view
      wx:if="{{existingUser}}"
      class="login-quick-entry"
      bindtap="onQuickEnterStored"
      hover-class="tap-chip-hover"
    >
      使用当前登录态快速进入
    </view>
  </view>

  <!-- 强制改密弹窗 -->
  <view wx:if="{{showChangePwd}}">
    <view class="modal-overlay" bindtap="onCancelChangePwd"></view>
    <view class="modal-sheet" catchtap="true">
      <view class="modal-sheet-title">首次登录，请修改密码</view>
      <view class="modal-sheet-body login-modal-body">
        <view class="text-tertiary" style="margin-bottom:var(--sp-2);font-size:var(--fs-sm);">为保障账号安全，首次登录须修改默认密码</view>
        <view class="field-group">
          <text class="field-label">旧密码</text>
          <input class="field-input" password="{{true}}" placeholder="输入当前密码" value="{{changePwdData.oldPassword}}" bindinput="onOldPwdInput" maxlength="20" />
        </view>
        <view class="field-group">
          <text class="field-label">新密码</text>
          <view class="flex-row gap-1">
            <input class="field-input flex-1" password="{{!showNewPwd}}" placeholder="至少8位，含字母和数字" value="{{changePwdData.newPassword}}" bindinput="onNewPwdInput" maxlength="20" />
            <text class="font-medium text-accent login-pwd-toggle" bindtap="toggleNewPwd">{{showNewPwd ? '隐藏' : '显示'}}</text>
          </view>
        </view>
        <view class="field-group">
          <text class="field-label">确认新密码</text>
          <input class="field-input" password="{{true}}" placeholder="再次输入新密码" value="{{changePwdData.confirmPassword}}" bindinput="onConfirmPwdInput" maxlength="20" />
        </view>
      </view>
      <view class="modal-sheet-footer">
        <button class="modal-sheet-btn" bindtap="onCancelChangePwd" disabled="{{changePwdLoading}}">取消</button>
        <button class="modal-sheet-btn" bindtap="onSubmitChangePwd" disabled="{{changePwdLoading}}">
          {{changePwdLoading ? '修改中...' : '确认修改'}}
        </button>
      </view>
    </view>
  </view>

</view>
