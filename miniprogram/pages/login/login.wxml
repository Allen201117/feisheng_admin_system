<!--pages/login/login.wxml-->
<view class="login-page">
  <view class="login-hero">
    <image class="login-logo" src="/images/logo.png" mode="aspectFit"></image>
    <view class="app-title">工厂记账系统</view>
    <view class="app-desc">考勤、报工、质检和工资管理统一协同。</view>
  </view>

  <view class="login-form-shell">
    <view class="login-form card">
      <view class="form-head">
        <view>
          <text class="form-title">账号登录</text>
          <text class="form-subtitle">{{hasRememberedLoginInfo ? '已带出上次账号，请输入密码登录' : '首次登录请输入完整账号信息'}}</text>
        </view>
        <view wx:if="{{existingUser}}" class="stored-badge">已有登录态</view>
      </view>

      <view class="field-card">
        <text class="field-label">工厂码</text>
        <input
          class="field-input"
          placeholder="例如 A001"
          value="{{factoryCode}}"
          bindinput="onInputFactoryCode"
          maxlength="20"
        />
      </view>

      <view class="field-card">
        <text class="field-label">姓名</text>
        <input
          class="field-input"
          placeholder="请输入真实姓名"
          value="{{name}}"
          bindinput="onInputName"
          maxlength="20"
        />
      </view>

      <view class="field-card">
        <text class="field-label">手机号</text>
        <input
          class="field-input"
          placeholder="请输入手机号"
          type="number"
          value="{{phone}}"
          bindinput="onInputPhone"
          maxlength="11"
        />
        <text class="field-tip">同一手机号可在不同工厂分别开通账号。</text>
      </view>

      <view class="field-card password-card">
        <text class="field-label">密码</text>
        <view class="password-wrap">
          <input
            class="field-input password-input"
            placeholder="请输入密码"
            password="{{!showPassword}}"
            value="{{password}}"
            bindinput="onInputPassword"
            maxlength="20"
          />
          <view class="toggle-pwd" bindtap="togglePassword">
            <text>{{showPassword ? '隐藏' : '显示'}}</text>
          </view>
        </view>
      </view>

      <view class="privacy-consent-card">
        <checkbox-group bindchange="onConsentCheck" class="privacy-checkbox-group">
          <label class="privacy-checkbox-line">
            <checkbox value="agree" checked="{{consentChecked}}" color="#1890FF" />
            <view class="privacy-copy">
              <text>我已阅读并同意</text>
              <text class="text-primary privacy-link" catchtap="openPrivacyPolicy">《隐私政策》</text>
              <text>和</text>
              <text class="text-primary privacy-link" catchtap="openUserAgreement">《用户服务协议》</text>
              <text wx:if="{{consentVersion}}">（版本 {{consentVersion}}）</text>
            </view>
          </label>
        </checkbox-group>
      </view>

      <button
        class="btn-primary btn-block btn-lg login-btn"
        bindtap="onLogin"
        disabled="{{loading}}"
      >
        <text class="login-btn-text">{{loading ? '登录中...' : '登录'}}</text>
      </button>

      <button
        wx:if="{{existingUser}}"
        class="quick-enter-btn"
        bindtap="onQuickEnterStored"
      >
        使用当前登录态快速进入
      </button>

      <view class="login-notice-panel">
        <text class="login-notice-title">登录提示</text>
        <text class="login-tip text-sm text-gray">首次登录请联系管理员开通账号；登录成功后会记住登录态，下次可自动进入。</text>
        <text class="login-tip text-sm text-gray">未勾选同意前不会登录，也不会采集手机号用于账号绑定。</text>
        <view class="agreement-row">
          <text class="text-primary" bindtap="openPrivacyPolicy">《隐私政策》</text>
          <text class="agreement-divider">/</text>
          <text class="text-primary" bindtap="openUserAgreement">《用户服务协议》</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 强制改密弹窗 -->
  <view wx:if="{{showChangePwd}}" class="modal-mask">
    <view class="modal-dialog">
      <view class="modal-header">
        <text class="modal-title">首次登录，请修改密码</text>
        <text class="modal-desc text-sm text-gray">为保障账号安全，首次登录须修改默认密码</text>
      </view>
      <view class="modal-body">
        <view class="input-group">
          <text class="input-label">旧密码</text>
          <input class="input-field" password="{{true}}" placeholder="输入当前密码" value="{{changePwdData.oldPassword}}" bindinput="onOldPwdInput" maxlength="20" />
        </view>
        <view class="input-group">
          <text class="input-label">新密码</text>
          <view class="password-wrap">
            <input class="input-field password-input" password="{{!showNewPwd}}" placeholder="至少8位，含字母和数字" value="{{changePwdData.newPassword}}" bindinput="onNewPwdInput" maxlength="20" />
            <view class="toggle-pwd" bindtap="toggleNewPwd">
              <text>{{showNewPwd ? '隐藏' : '显示'}}</text>
            </view>
          </view>
        </view>
        <view class="input-group">
          <text class="input-label">确认新密码</text>
          <input class="input-field" password="{{true}}" placeholder="再次输入新密码" value="{{changePwdData.confirmPassword}}" bindinput="onConfirmPwdInput" maxlength="20" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-default modal-btn" bindtap="onCancelChangePwd" disabled="{{changePwdLoading}}">取消</button>
        <button class="btn-primary modal-btn" bindtap="onSubmitChangePwd" disabled="{{changePwdLoading}}">
          {{changePwdLoading ? '修改中...' : '确认修改'}}
        </button>
      </view>
    </view>
  </view>
</view>
