/* pages/employee/profile/profile.wxss */
.container {
  background:
    radial-gradient(circle at 10% 8%, rgba(130, 196, 255, 0.16) 0%, transparent 24%),
    radial-gradient(circle at 88% 12%, rgba(255, 212, 150, 0.16) 0%, transparent 24%),
    linear-gradient(180deg, #eef6ff 0%, #f9fcff 100%);
}

.card {
  border: 2rpx solid #e8eef8;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 22rpx rgba(17, 38, 84, 0.06);
  background: linear-gradient(145deg, #ffffff 0%, #fafdff 100%);
}

.section-title {
  color: #1f3554;
}

.stat-card {
  border: 2rpx solid #cfe1f6;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 28rpx rgba(14, 56, 104, 0.16);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2fa;
}

.detail-row:last-child {
  border-bottom: none;
}

.detail-total {
  border-top: 2rpx solid #e2e9f3;
  margin-top: 10rpx;
  padding-top: 24rpx;
}

.detail-label {
  font-size: 34rpx;
  color: #666;
}

.detail-value {
  font-size: 36rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-between;
  gap: 14rpx;
  text-align: center;
}

.stat-box {
  flex: 1;
  padding: 22rpx 14rpx;
  border: 2rpx solid #edf2fa;
  border-radius: 18rpx;
  background: #fbfcff;
}

.stat-box-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #1766b7;
  display: block;
  margin-bottom: 8rpx;
}

.stat-box-label {
  font-size: 28rpx;
  color: #999;
}

.adj-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2fa;
}

.adj-item:last-child {
  border-bottom: none;
}

.adj-reason {
  font-size: 34rpx;
  display: block;
}

.adj-date {
  display: block;
  margin-top: 4rpx;
}

.adj-amount {
  font-size: 38rpx;
  font-weight: bold;
}

.att-item {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #edf2fa;
  gap: 16rpx;
}

.att-item:last-child {
  border-bottom: none;
}

.att-date {
  font-size: 32rpx;
  color: #333;
  width: 170rpx;
}

.att-time {
  flex: 1;
  font-size: 30rpx;
  color: #666;
}

.att-hours {
  font-size: 32rpx;
  color: #1890FF;
  font-weight: bold;
  margin-right: 10rpx;
}

/* 已发薪标记 */
.paid-badge {
  display: inline-block;
  font-size: 30rpx;
  color: #2f9558;
  background: #edf9f1;
  border: 1rpx solid #c6e6d2;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  margin-top: 12rpx;
}

.privacy-notice {
  font-size: 30rpx;
  color: #5f728b;
  background: #f6f9fe;
  border: 2rpx solid #e1eaf6;
  padding: 18rpx;
  border-radius: 12rpx;
  margin-top: 16rpx;
  text-align: center;
}

/* 修改密码弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-dialog {
  width: 85%;
  background: linear-gradient(145deg, #ffffff 0%, #fbfdff 100%);
  border: 2rpx solid #e6eef8;
  border-radius: 20rpx;
  box-shadow: 0 14rpx 30rpx rgba(17, 38, 84, 0.16);
  overflow: hidden;
}
.modal-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  padding: 32rpx 0 16rpx;
}
.modal-body {
  padding: 16rpx 32rpx;
}
.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}
.modal-btn {
  flex: 1;
  border-radius: 0 !important;
  font-size: 32rpx;
  margin: 0 !important;
  padding: 24rpx 0 !important;
  background: none;
  line-height: 1.5;
}
.modal-btn.btn-primary {
  background: #1890FF;
  color: #fff;
}
.pwd-input-wrap {
  display: flex;
  align-items: center;
}
.pwd-input-wrap .input-field {
  flex: 1;
}
.pwd-toggle {
  font-size: 30rpx;
  color: #1890FF;
  padding: 0 10rpx;
  white-space: nowrap;
}
