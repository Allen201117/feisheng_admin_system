.stats-card { width: calc(33.33% - 11rpx); }
.stats-card.indigo {
  border-left: none;
  background: #F8FAFC;
}
.profile-modal-body { text-align: left; }
.profile-list-meta { display: block; margin-top: 4rpx; }
.profile-divider-wide { margin: var(--sp-1) calc(-1 * var(--sp-3)); }
.profile-empty-inline { padding: var(--sp-3) 0; }
.profile-pwd-toggle { flex-shrink: 0; }
.block-mb-2 { display: block; margin-bottom: var(--sp-2); }
