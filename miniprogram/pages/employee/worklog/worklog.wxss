.worklog-input-lg { height: 116rpx; text-align: center; }
.worklog-submit-bar { margin: var(--sp-2) calc(-1 * var(--sp-3)) calc(-1 * var(--sp-3)); }
.worklog-qty-clear { margin-top: 8rpx; display: flex; justify-content: flex-end; }
.worklog-modal-body { text-align: left; }
.worklog-list-row { flex-wrap: wrap; padding: 22rpx 0; }
.worklog-list-meta { display: block; margin-top: 4rpx; }
.worklog-gap-12 { gap: 12rpx; }
.worklog-truncate { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.worklog-quick-section { margin-top: 14rpx; }
.worklog-quick-label { display: block; margin-bottom: 8rpx; }
.worklog-full-width { width: 100%; }
.icon-sm { width: 36rpx; height: 36rpx; }
.icon-xs { width: 28rpx; height: 28rpx; }
.block-mb-2 { display: block; margin-bottom: var(--sp-2); }
