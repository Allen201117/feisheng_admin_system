<view class="container">

  <view class="page-header">
    <view class="page-header-left">
      <text class="page-header-title">计件报工</text>
      <text class="page-header-subtitle">选择工序并提交本次完成数量</text>
    </view>
  </view>

  <!-- 报工表单 -->
  <view class="card-bento">
    <text class="menu-group-title block-mb-2">提交报工</text>

    <view wx:if="{{processes.length === 0}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/worklog.svg" mode="aspectFit" class="icon-sm" />
      </view>
      <text class="empty-title">暂无负责工序</text>
      <text class="empty-desc">管理员分配后会显示在这里。</text>
      <view class="empty-action secondary" bindtap="loadAssignedProcesses" hover-class="tap-button-hover">刷新工序</view>
    </view>

    <view wx:else>
      <view class="field-group">
        <text class="field-label">选择工序</text>
        <picker
          mode="selector"
          range="{{processes}}"
          range-key="display"
          value="{{selectedProcessIndex}}"
          bindchange="onProcessChange"
        >
          <view class="picker-field" hover-class="tap-row-hover">
            <text wx:if="{{selectedProcess}}" class="flex-1 worklog-truncate">{{selectedProcess.display}}</text>
            <text wx:else class="text-tertiary flex-1 worklog-truncate">请选择工序</text>
            <text class="picker-arrow">&#x276F;</text>
          </view>
        </picker>
      </view>

      <view class="field-group">
        <text class="field-label">完成数量</text>
        <input
          class="field-input worklog-input-lg"
          type="number"
          placeholder="请输入本次报工数量"
          value="{{quantity > 0 ? quantity : ''}}"
          bindinput="onQuantityInput"
          confirm-type="done"
        />
        <view wx:if="{{quantity > 0}}" class="worklog-qty-clear">
          <button class="btn-sm btn-sm-danger" bindtap="onClearQuantity" hover-class="tap-button-hover">清空</button>
        </view>

        <view class="worklog-quick-section">
          <text class="text-tertiary worklog-quick-label">快捷输入</text>
          <view class="filter-chips">
            <view wx:for="{{quickQuantities}}" wx:key="index" class="filter-chip" data-value="{{item}}" bindtap="onQuickQuantityTap" hover-class="tap-chip-hover">{{item}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{selectedProcess && !quotaLoading && quotaInfo}}" class="notice notice-green">
        <view style="flex:1;display:flex;flex-direction:column;gap:4rpx;">
          <view class="flex-between"><text class="text-xs">订单数量：</text><text class="font-semibold num">{{quotaInfo.order_total_quantity}}</text></view>
          <view class="flex-between"><text class="text-xs">已报数量：</text><text class="font-semibold num">{{quotaInfo.current_total}}</text></view>
          <view class="flex-between"><text class="text-xs">剩余可报：</text><text class="font-semibold num text-green">{{quotaInfo.remaining_quantity}}</text></view>
        </view>
      </view>
      <view wx:if="{{selectedProcess && quotaLoading}}" class="text-tertiary text-xs" style="margin-top:var(--sp-1);">正在获取可报数量...</view>

      <view wx:if="{{selectedProcess && quantity > 0 && !selectedProcess.price_hidden}}" class="notice notice-amber" style="margin-top:var(--sp-1);">
        <text>预估金额：<text class="font-bold text-accent num">¥{{quantity * selectedProcess.current_price}}</text> <text class="text-tertiary text-xs">（{{quantity}}件 x ¥{{selectedProcess.current_price}}）</text></text>
      </view>
      <view wx:elif="{{selectedProcess && quantity > 0 && selectedProcess.price_hidden}}" class="notice notice-amber" style="margin-top:var(--sp-1);">
        <text>预估金额：<text class="text-tertiary">已隐藏</text></text>
      </view>

      <view class="bottom-action-bar worklog-submit-bar">
        <button
          class="btn-primary btn-block btn-lg"
          bindtap="onSubmit"
          disabled="{{loading || !selectedProcess || quantity <= 0 || (quotaInfo && quantity > quotaInfo.remaining_quantity)}}"
          hover-class="tap-button-hover"
        >
          {{loading ? '提交中...' : '提交报工'}}
        </button>
      </view>
    </view>
  </view>

</view>
