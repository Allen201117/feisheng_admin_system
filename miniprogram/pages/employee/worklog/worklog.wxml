<view class="container">

  <view class="page-header">
    <view class="page-header-left">
      <text class="page-header-title">报工</text>
      <text class="page-header-subtitle">选择工序，填写数量后提交</text>
    </view>
  </view>

  <!-- 今日预估工资 -->
  <view class="stat-card accent-blue">
    <text class="stat-card-label">今日预估工资</text>
    <text class="stat-card-value">¥{{todayTotal}}</text>
  </view>

  <!-- 报工表单 -->
  <view class="card-bento">
    <text class="menu-group-title block-mb-2">提交报工</text>

    <view class="field-group">
      <text class="field-label">选择工序</text>
      <picker
        mode="selector"
        range="{{processes}}"
        range-key="display"
        value="{{selectedProcessIndex}}"
        bindchange="onProcessChange"
      >
        <view class="picker-field" hover-class="tap-row-hover">
          <text wx:if="{{selectedProcess}}" class="flex-1 worklog-truncate">{{selectedProcess.display}}</text>
          <text wx:else class="text-tertiary flex-1 worklog-truncate">请选择工序</text>
          <text class="picker-arrow">&#x276F;</text>
        </view>
      </picker>
    </view>

    <view class="field-group">
      <text class="field-label">完成数量</text>
      <input
        class="field-input worklog-input-lg"
        type="number"
        placeholder="请输入本次报工数量"
        value="{{quantity > 0 ? quantity : ''}}"
        bindinput="onQuantityInput"
        confirm-type="done"
      />
      <view wx:if="{{quantity > 0}}" class="worklog-qty-clear">
        <button class="btn-sm btn-sm-danger" bindtap="onClearQuantity" hover-class="tap-button-hover">清空</button>
      </view>

      <view class="worklog-quick-section">
        <text class="text-tertiary worklog-quick-label">快捷输入</text>
        <view class="filter-chips">
          <view wx:for="{{quickQuantities}}" wx:key="index" class="filter-chip" data-value="{{item}}" bindtap="onQuickQuantityTap" hover-class="tap-chip-hover">{{item}}</view>
        </view>
      </view>
    </view>

    <view wx:if="{{selectedProcess && !quotaLoading && quotaInfo}}" class="notice notice-green">
      <view style="flex:1;display:flex;flex-direction:column;gap:4rpx;">
        <view class="flex-between"><text class="text-xs">订单数量：</text><text class="font-semibold num">{{quotaInfo.order_total_quantity}}</text></view>
        <view class="flex-between"><text class="text-xs">已报数量：</text><text class="font-semibold num">{{quotaInfo.current_total}}</text></view>
        <view class="flex-between"><text class="text-xs">剩余可报：</text><text class="font-semibold num text-green">{{quotaInfo.remaining_quantity}}</text></view>
      </view>
    </view>
    <view wx:if="{{selectedProcess && quotaLoading}}" class="text-tertiary text-xs" style="margin-top:var(--sp-1);">正在获取可报数量...</view>

    <view wx:if="{{selectedProcess && quantity > 0 && !selectedProcess.price_hidden}}" class="notice notice-amber" style="margin-top:var(--sp-1);">
      <text>预估金额：<text class="font-bold text-accent num">¥{{quantity * selectedProcess.current_price}}</text> <text class="text-tertiary text-xs">（{{quantity}}件 x ¥{{selectedProcess.current_price}}）</text></text>
    </view>
    <view wx:elif="{{selectedProcess && quantity > 0 && selectedProcess.price_hidden}}" class="notice notice-amber" style="margin-top:var(--sp-1);">
      <text>预估金额：<text class="text-tertiary">已隐藏</text></text>
    </view>

    <view class="bottom-action-bar worklog-submit-bar">
      <button
        class="btn-primary btn-block btn-lg"
        bindtap="onSubmit"
        disabled="{{loading || !selectedProcess || quantity <= 0 || (quotaInfo && quantity > quotaInfo.remaining_quantity)}}"
        hover-class="tap-button-hover"
      >
        {{loading ? '提交中...' : '提交报工'}}
      </button>
    </view>
  </view>

  <!-- 今日报工记录 -->
  <view class="card-bento">
    <text class="menu-group-title block-mb-2">今日报工记录</text>

    <view wx:if="{{todayLogs.length === 0}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/worklog.svg" mode="aspectFit" class="icon-sm" />
      </view>
      <text class="empty-title">今日还没有报工</text>
      <text class="empty-desc">完成工序后在上方填写数量，提交后会显示在这里。</text>
      <view class="empty-action secondary" bindtap="loadTodayLogs" hover-class="tap-button-hover">刷新记录</view>
    </view>

    <view wx:for="{{todayLogs}}" wx:key="_id" class="list-row worklog-list-row" hover-class="tap-row-hover" hover-stay-time="80">
      <view class="flex-1">
        <text class="font-semibold">{{item.process_name}}</text>
        <text class="text-tertiary worklog-list-meta">{{item.order_name}}</text>
      </view>
      <text class="font-bold">{{item.quantity}}件</text>

      <view class="flex-between worklog-full-width" style="margin-top:6rpx;">
        <view class="flex-row worklog-gap-12">
          <text wx:if="{{!item.price_hidden}}" class="text-accent font-bold num">¥{{item.quantity * item.snapshot_price}}</text>
          <text wx:else class="text-tertiary text-xs">已隐藏</text>
          <text class="badge {{item.status === 'inspected' ? 'badge-green' : 'badge-amber'}}">
            {{item.status === 'inspected' ? '已质检' : '待质检'}}
          </text>
        </view>
        <text class="text-tertiary text-xs">{{item.report_time_text}}</text>
      </view>

      <view wx:if="{{item.status === 'inspected'}}" class="text-xs text-secondary worklog-full-width" style="margin-top:4rpx;">
        合格: {{item.passed_qty}}件
      </view>

      <view wx:if="{{item.is_today && !item.is_locked}}" class="flex-row worklog-full-width" style="gap:12rpx;margin-top:8rpx;">
        <button class="btn-sm btn-sm-primary" bindtap="onEditLog" data-log="{{item}}" hover-class="tap-button-hover">编辑数量</button>
        <button class="btn-sm btn-sm-danger" bindtap="onCancelLog" data-log="{{item}}" hover-class="tap-button-hover">撤销本条</button>
      </view>
      <view wx:elif="{{item.is_locked}}" class="flex-row worklog-full-width" style="gap:8rpx;margin-top:8rpx;">
        <image src="/images/icons/lock.svg" mode="aspectFit" class="icon-xs" />
        <text class="text-tertiary text-xs">{{item.lock_reason}}</text>
      </view>
    </view>
  </view>

  <!-- 编辑报工弹窗 -->
  <view wx:if="{{showEditLog}}">
    <view class="modal-overlay" bindtap="closeEditLog"></view>
    <view class="modal-sheet" catchtap="true">
      <view class="modal-sheet-title">修改报工记录</view>
      <view class="modal-sheet-body worklog-modal-body">
        <view class="notice notice-blue" style="margin-bottom:var(--sp-2);">
          <text class="text-xs">工序：{{editLog.process_name}} | 订单：{{editLog.order_name}}</text>
        </view>
        <view class="field-group">
          <text class="field-label">报工数量</text>
          <input class="field-input" type="number" value="{{editQuantity}}" bindinput="onEditQtyInput" />
        </view>
        <view class="field-group">
          <text class="field-label">备注</text>
          <input class="field-input" placeholder="可选" value="{{editNote}}" bindinput="onEditNoteInput" />
        </view>
        <view class="field-group">
          <text class="field-label">修改原因 *</text>
          <picker mode="selector" range="{{editReasons}}" value="{{editReasonIndex}}" bindchange="onEditReasonChange">
            <view class="picker-field" hover-class="tap-row-hover">
              <text wx:if="{{editReasonIndex >= 0}}">{{editReasons[editReasonIndex]}}</text>
              <text wx:else class="text-tertiary">请选择原因</text>
              <text class="picker-arrow">&#x276F;</text>
            </view>
          </picker>
        </view>
        <view wx:if="{{editReasonIndex === 3}}" class="field-group">
          <text class="field-label">详细原因</text>
          <input class="field-input" placeholder="请输入具体原因" value="{{editReason}}" bindinput="onEditReasonInput" />
        </view>
      </view>
      <view class="modal-sheet-footer">
        <button class="modal-sheet-btn" bindtap="closeEditLog" hover-class="tap-row-hover">取消</button>
        <button class="modal-sheet-btn" bindtap="onSaveEditLog" hover-class="tap-row-hover">保存</button>
      </view>
    </view>
  </view>

</view>
