.rank-item { display:flex; align-items:center; padding:22rpx 0; border-bottom:1rpx solid var(--border-light); gap:16rpx; }
.rank-item:last-child { border-bottom:none; }
.rank-item-me { background:var(--blue-50); border-radius:var(--r-sm); padding:22rpx 16rpx; margin:4rpx -16rpx; }
.rank-num { width:52rpx; height:52rpx; border-radius:50%; background:var(--border-light); display:flex; align-items:center; justify-content:center; font-size:var(--fs-sm); font-weight:var(--fw-bold); color:var(--text-tertiary); flex-shrink:0; }
.rank-top { color:#fff; }
.rank-top-1 { background:#FFD700; }
.rank-top-2 { background:#C0C0C0; }
.rank-top-3 { background:#CD7F32; }
.rank-info { flex:1; min-width:0; }
.rank-name { font-size:var(--fs-base); font-weight:var(--fw-semibold); color:var(--text-primary); display:block; }
.rank-sub { font-size:var(--fs-xs); color:var(--text-secondary); display:block; margin-top:2rpx; }
.rank-value { font-size:var(--fs-base); font-weight:var(--fw-bold); color:var(--blue-600); flex-shrink:0; font-variant-numeric:tabular-nums; }
