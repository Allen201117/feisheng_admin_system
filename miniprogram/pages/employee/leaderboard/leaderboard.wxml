<view class="container" wx:if="{{visible}}">
  <view class="page-header">
    <text class="page-header-title">排行榜</text>
  </view>

  <!-- 周期 Tabs -->
  <view class="tab-bar">
    <view wx:for="{{periodTabs}}" wx:key="key"
      class="tab-item {{periodTab === item.key ? 'tab-item-active' : ''}}"
      bindtap="switchPeriod" data-key="{{item.key}}">
      {{item.label}}
    </view>
  </view>

  <!-- 月份选择 -->
  <view wx:if="{{periodTab === 'monthly'}}" class="card-bento">
    <picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange">
      <view class="picker-field">
        <text>{{monthDisplay}}</text>
        <text class="picker-arrow">&#x276F;</text>
      </view>
    </picker>
  </view>

  <!-- 年份选择 -->
  <view wx:if="{{periodTab === 'yearly'}}" class="card-bento">
    <picker range="{{['2026','2025','2024','2023','2022','2021']}}" value="0" bindchange="onYearChange">
      <view class="picker-field">
        <text>{{yearDisplay}}</text>
        <text class="picker-arrow">&#x276F;</text>
      </view>
    </picker>
  </view>

  <!-- 维度 Tabs -->
  <view class="tab-bar">
    <view wx:for="{{dimTabs}}" wx:key="key"
      class="tab-item {{dimTab === item.key ? 'tab-item-active' : ''}}"
      bindtap="switchDim" data-key="{{item.key}}">
      {{item.label}}
    </view>
  </view>

  <!-- 排行列表 -->
  <view class="card-bento">
    <view class="flex-between" style="margin-bottom:var(--sp-1);padding:0 0 var(--sp-1);">
      <text class="text-tertiary text-xs">共 {{totalEmployees}} 名员工</text>
      <text class="text-tertiary text-xs">{{visibility === 'self' ? '仅显示我的排名' : '全员榜'}}</text>
    </view>

    <view wx:if="{{rankList.length === 0 && !loading}}" class="empty">
      <text class="empty-desc">暂无排行数据</text>
    </view>

    <view wx:for="{{rankList}}" wx:key="user_id" class="list-row rank-item {{item.user_id === myUserId ? 'rank-item-me' : ''}}">
      <view class="rank-num {{item.rank <= 3 ? 'rank-top rank-top-' + item.rank : ''}}">
        {{item.rank}}
      </view>
      <view class="rank-info">
        <text class="rank-name">{{item.user_name}}{{item.user_id === myUserId ? '(我)' : ''}}</text>
        <text wx:if="{{item.displaySub}}" class="rank-sub">{{item.displaySub}}</text>
      </view>
      <text class="rank-value">{{item.displayValue}}</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="flex-center" style="padding:var(--sp-2);">
    <text class="text-tertiary">加载中...</text>
  </view>
</view>
