.employee-home-page { padding-bottom: 80rpx; }

.clock-section {
  margin-bottom: var(--sp-3);
}

.home-hero {
  margin-bottom: var(--sp-3);
}

.home-hero-top {
  align-items: flex-start;
}

.home-hero-metrics {
  margin-top: 22rpx;
  display: flex;
  align-items: stretch;
  gap: 14rpx;
}

.home-hero-primary {
  flex: 1;
  min-width: 0;
  min-height: 156rpx;
  padding: 22rpx 24rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, var(--surface-green) 0%, #FFFFFF 100%);
  border: 1rpx solid var(--green-100);
  box-shadow: 0 8rpx 20rpx rgba(36,138,61,0.10);
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  font-variant-numeric: tabular-nums;
}

.home-hero-secondary {
  width: 218rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.home-hero-mini {
  min-height: 72rpx;
  padding: 12rpx 16rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: 0 6rpx 16rpx rgba(15,23,42,0.05);
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  font-variant-numeric: tabular-nums;
}

.home-hero-metric-label {
  display: block;
  font-size: 22rpx;
  line-height: 1.25;
  color: var(--text-secondary);
  font-weight: var(--fw-medium);
}

.home-hero-money {
  display: block;
  margin-top: 4rpx;
  font-size: 46rpx;
  line-height: 1.05;
  color: var(--green-600);
  font-weight: var(--fw-bold);
}

.home-hero-metric-note {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.25;
  color: var(--green-600);
}

.home-hero-metric-value {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  line-height: 1.15;
  color: var(--text-primary);
  font-weight: var(--fw-bold);
}

.home-hero-date {
  font-size: 24rpx;
  line-height: 1.2;
  word-break: keep-all;
}

.home-worklog-head,
.home-section-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.home-section-copy { flex: 1; min-width: 0; }

.home-section-title {
  display: block;
  font-size: var(--fs-md);
  line-height: 1.28;
  font-weight: var(--fw-bold);
  color: var(--text-primary);
}

.home-section-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-xs);
  line-height: 1.4;
  color: var(--text-secondary);
}

.home-process-section { margin-bottom: var(--sp-3); }

.home-process-loading { margin-top: var(--sp-1); }

.home-process-empty {
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border-radius: 28rpx;
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-card);
}

.home-process-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.home-process-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.home-process-card.is-complete { opacity: 0.82; }

.home-process-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
}

.home-process-main { flex: 1; min-width: 0; }

.home-process-name {
  display: block;
  font-size: 34rpx;
  line-height: 1.32;
  font-weight: var(--fw-bold);
  color: var(--text-primary);
  word-break: break-word;
}

.home-process-order {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-xs);
  line-height: 1.35;
  color: var(--text-secondary);
}

.home-process-price {
  flex-shrink: 0;
  max-width: 190rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--r-full);
  background: var(--amber-50);
  color: var(--amber-600);
  font-size: var(--fs-sm);
  line-height: 1.2;
  font-weight: var(--fw-bold);
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.home-process-side {
  flex-shrink: 0;
  max-width: 220rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10rpx;
}

.home-process-multi-badge {
  max-width: 220rpx;
  padding: 9rpx 16rpx;
  border-radius: var(--r-full);
  background: linear-gradient(180deg, var(--green-50) 0%, #FFFFFF 100%);
  border: 1rpx solid var(--green-100);
  color: var(--green-600);
  font-size: var(--fs-xs);
  line-height: 1.2;
  font-weight: var(--fw-bold);
  text-align: center;
  box-shadow: 0 6rpx 14rpx rgba(36,138,61,0.10);
  box-sizing: border-box;
}

.home-process-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: var(--sp-2);
}

.home-process-tag {
  min-height: 50rpx;
  padding: 0 16rpx;
  border-radius: var(--r-full);
  background: var(--surface-strong);
  color: var(--text-secondary);
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  display: flex;
  align-items: center;
  font-variant-numeric: tabular-nums;
}

.home-process-tag.is-ready {
  background: var(--green-50);
  color: var(--green-600);
}

.home-process-tag.is-muted {
  background: var(--bg-elevated);
  color: var(--text-tertiary);
}

.home-process-progress {
  height: 12rpx;
  border-radius: var(--r-full);
  background: var(--surface-strong);
  overflow: hidden;
  margin-top: var(--sp-2);
}

.home-process-progress-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: var(--r-full);
  background: var(--blue-500);
}

.home-process-progress-fill.is-complete { background: var(--green-500); }

.home-process-foot {
  min-height: 56rpx;
  margin-top: var(--sp-2);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-process-foot-text {
  color: var(--blue-600);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
}

.home-more-row {
  min-height: 82rpx;
  padding: 0 var(--sp-2);
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-card);
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--blue-600);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
}

.home-clock-header { margin-bottom: var(--sp-2); }
.home-clock-divider { margin: var(--sp-2) calc(-1 * var(--sp-3)) 0; }
.home-clock-summary { margin-top: var(--sp-2); }

.home-clock-compact {
  padding: 22rpx;
  border-radius: 26rpx;
}

.home-clock-compact .home-clock-header {
  align-items: center;
  margin-bottom: 14rpx;
}

.home-clock-compact .font-semibold {
  font-size: 30rpx;
  line-height: 1.25;
}

.home-clock-compact .clock-hint {
  font-size: 22rpx;
  line-height: 1.35;
}

.home-clock-compact .clock-btns {
  flex-direction: row;
  gap: 12rpx;
  margin-top: 14rpx;
}

.home-clock-compact .clock-btn {
  flex: 1;
  width: auto;
  min-height: 112rpx;
  padding: 16rpx 10rpx;
  border-radius: 24rpx;
}

.home-clock-compact .clock-btn-label {
  font-size: 22rpx;
}

.home-clock-compact .clock-btn-text {
  margin-top: 4rpx;
  font-size: 30rpx;
}

.home-clock-compact .clock-btn-time {
  margin-top: 2rpx;
  font-size: 22rpx;
}

.home-clock-compact .home-clock-divider {
  margin: 16rpx 0 0;
}

.home-clock-compact .home-clock-summary {
  margin-top: 12rpx;
  font-size: 22rpx;
  line-height: 1.35;
  text-align: center;
}

.home-quick-divider { margin: var(--sp-2) calc(-1 * var(--sp-3)); }
.home-modal-body { text-align: left; }
.home-pwd-toggle { flex-shrink: 0; }
.icon-sm { width: 36rpx; height: 36rpx; }
.block-mb-2 { display: block; margin-bottom: var(--sp-2); }
