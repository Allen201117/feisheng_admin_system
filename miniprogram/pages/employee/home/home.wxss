.employee-home-page { padding-bottom: 80rpx; }

.home-worklog-head,
.home-section-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.home-section-copy { flex: 1; min-width: 0; }

.home-section-title {
  display: block;
  font-size: var(--fs-md);
  line-height: 1.28;
  font-weight: var(--fw-bold);
  color: var(--text-primary);
}

.home-section-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-xs);
  line-height: 1.4;
  color: var(--text-secondary);
}

.home-earnings-pill {
  min-width: 178rpx;
  padding: 12rpx 18rpx;
  border-radius: 22rpx;
  background: var(--green-50);
  border: 1rpx solid var(--green-100);
  text-align: right;
  box-sizing: border-box;
}

.home-earnings-label {
  display: block;
  font-size: var(--fs-2xs);
  color: var(--green-600);
  line-height: 1.2;
}

.home-earnings-value {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-base);
  line-height: 1.15;
  font-weight: var(--fw-bold);
  color: var(--green-600);
  font-variant-numeric: tabular-nums;
}

.home-report-panel {
  padding: 30rpx;
  border-radius: 30rpx;
  background: var(--bg-card);
  border: 1rpx solid rgba(229,229,234,0.86);
  box-shadow: var(--shadow-card);
  margin-bottom: var(--sp-3);
}

.home-selected-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
  margin-bottom: var(--sp-2);
}

.home-selected-main { flex: 1; min-width: 0; }

.home-selected-kicker {
  display: block;
  font-size: var(--fs-2xs);
  color: var(--text-secondary);
  line-height: 1.3;
  margin-bottom: 6rpx;
}

.home-selected-name {
  display: block;
  font-size: 38rpx;
  line-height: 1.25;
  font-weight: var(--fw-bold);
  color: var(--text-primary);
  word-break: break-word;
}

.home-selected-order {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-xs);
  color: var(--text-secondary);
  line-height: 1.35;
}

.home-selected-price {
  flex-shrink: 0;
  max-width: 190rpx;
  padding: 10rpx 16rpx;
  border-radius: var(--r-full);
  background: var(--amber-50);
  color: var(--amber-600);
  font-size: var(--fs-sm);
  line-height: 1.2;
  font-weight: var(--fw-bold);
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.home-quota-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: var(--sp-2);
}

.home-quota-cell {
  min-height: 104rpx;
  padding: 14rpx 8rpx;
  border-radius: 22rpx;
  background: #F8FAFC;
  border: 1rpx solid rgba(229,229,234,0.7);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
}

.home-quota-value {
  font-size: var(--fs-md);
  line-height: 1.1;
  font-weight: var(--fw-bold);
  color: var(--text-primary);
  font-variant-numeric: tabular-nums;
}

.home-quota-label {
  margin-top: 8rpx;
  font-size: var(--fs-2xs);
  line-height: 1.2;
  color: var(--text-secondary);
}

.home-qty-row {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 214rpx;
  gap: var(--sp-2);
  align-items: end;
}

.home-qty-input-wrap { min-width: 0; }

.home-qty-input {
  height: 104rpx;
  font-size: var(--fs-lg);
  font-weight: var(--fw-bold);
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.home-estimate-box {
  min-height: 104rpx;
  padding: 14rpx 12rpx;
  border-radius: 22rpx;
  background: var(--blue-50);
  border: 1rpx solid var(--blue-100);
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
}

.home-estimate-label {
  font-size: var(--fs-2xs);
  line-height: 1.2;
  color: var(--blue-600);
}

.home-estimate-value,
.home-estimate-muted {
  margin-top: 8rpx;
  font-size: var(--fs-base);
  line-height: 1.12;
  font-weight: var(--fw-bold);
  color: var(--blue-600);
  font-variant-numeric: tabular-nums;
}

.home-estimate-muted { color: var(--text-secondary); }

.home-quick-qty {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: var(--sp-2) 0 0;
}

.home-quick-chip {
  min-width: 92rpx;
  min-height: 62rpx;
  padding: 0 22rpx;
  border-radius: var(--r-full);
  background: #F2F4F7;
  color: var(--text-primary);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  transition: all 0.16s var(--ease-apple);
}

.home-quick-chip.is-clear {
  background: var(--red-50);
  color: var(--red-600);
}

.home-field-error,
.home-quota-loading {
  display: block;
  margin-top: var(--sp-1);
}

.home-quota-loading {
  font-size: var(--fs-2xs);
  color: var(--text-tertiary);
}

.home-submit-btn {
  margin-top: var(--sp-2);
  min-height: 96rpx;
}

.home-report-empty {
  min-height: 156rpx;
  display: flex;
  align-items: center;
  gap: var(--sp-2);
}

.home-report-empty-icon {
  width: 86rpx;
  height: 86rpx;
  border-radius: 26rpx;
  background: var(--green-50);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.home-report-empty-title {
  display: block;
  font-size: var(--fs-base);
  line-height: 1.28;
  font-weight: var(--fw-semibold);
  color: var(--text-primary);
}

.home-report-empty-desc {
  display: block;
  margin-top: 6rpx;
  font-size: var(--fs-xs);
  line-height: 1.4;
  color: var(--text-secondary);
}

.home-process-section { margin-bottom: var(--sp-3); }

.home-section-link {
  min-width: 82rpx;
  min-height: 56rpx;
  padding: 0 18rpx;
  border-radius: var(--r-full);
  background: #F2F4F7;
  color: var(--blue-600);
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  flex-shrink: 0;
}

.home-process-loading { margin-top: var(--sp-1); }

.home-process-empty {
  background: var(--bg-card);
  border-radius: 28rpx;
  border: 1rpx solid rgba(229,229,234,0.86);
}

.home-process-list {
  display: flex;
  flex-direction: column;
  gap: var(--sp-2);
}

.home-process-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: var(--bg-card);
  border: 1rpx solid rgba(229,229,234,0.86);
  box-shadow: var(--shadow-card);
  box-sizing: border-box;
}

.home-process-card.is-selected {
  border-color: rgba(52,199,89,0.72);
  box-shadow: var(--shadow-green);
}

.home-process-card.is-complete { opacity: 0.84; }

.home-process-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--sp-2);
}

.home-process-main { flex: 1; min-width: 0; }

.home-process-name {
  display: block;
  font-size: 34rpx;
  line-height: 1.32;
  font-weight: var(--fw-bold);
  color: var(--text-primary);
  word-break: break-word;
}

.home-process-order {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-xs);
  line-height: 1.35;
  color: var(--text-secondary);
}

.home-process-price {
  flex-shrink: 0;
  max-width: 190rpx;
  padding: 8rpx 14rpx;
  border-radius: var(--r-full);
  background: var(--amber-50);
  color: var(--amber-600);
  font-size: var(--fs-sm);
  line-height: 1.2;
  font-weight: var(--fw-bold);
  text-align: center;
  font-variant-numeric: tabular-nums;
}

.home-process-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: var(--sp-2);
}

.home-process-tag {
  min-height: 50rpx;
  padding: 0 16rpx;
  border-radius: var(--r-full);
  background: #F5F5F7;
  color: var(--text-secondary);
  font-size: var(--fs-xs);
  font-weight: var(--fw-semibold);
  display: flex;
  align-items: center;
  font-variant-numeric: tabular-nums;
}

.home-process-tag.is-ready {
  background: var(--green-50);
  color: var(--green-600);
}

.home-process-tag.is-muted {
  background: var(--bg-elevated);
  color: var(--text-tertiary);
}

.home-process-progress {
  height: 12rpx;
  border-radius: var(--r-full);
  background: #ECEEF2;
  overflow: hidden;
  margin-top: var(--sp-2);
}

.home-process-progress-fill {
  height: 100%;
  min-width: 8rpx;
  border-radius: var(--r-full);
  background: var(--blue-500);
}

.home-process-progress-fill.is-complete { background: var(--green-500); }

.home-process-foot {
  min-height: 56rpx;
  margin-top: var(--sp-2);
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.home-process-foot-text {
  color: var(--blue-600);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
}

.home-process-check {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: var(--green-500);
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: var(--fs-sm);
  font-weight: var(--fw-bold);
}

.home-more-row {
  min-height: 82rpx;
  padding: 0 var(--sp-2);
  border-radius: 24rpx;
  background: var(--bg-card);
  border: 1rpx solid rgba(229,229,234,0.86);
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: var(--blue-600);
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
}

.home-summary-grid { margin-bottom: var(--sp-3); }
.home-join-value { font-size: var(--fs-sm); line-height: 1.28; word-break: keep-all; }

.home-clock-header { margin-bottom: var(--sp-2); }
.home-clock-divider { margin: var(--sp-2) calc(-1 * var(--sp-3)) 0; }
.home-clock-summary { margin-top: var(--sp-2); }
.home-quick-divider { margin: var(--sp-2) calc(-1 * var(--sp-3)); }
.home-modal-body { text-align: left; }
.home-pwd-toggle { flex-shrink: 0; }
.icon-sm { width: 36rpx; height: 36rpx; }
.block-mb-2 { display: block; margin-bottom: var(--sp-2); }
