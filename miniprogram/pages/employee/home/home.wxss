/* pages/employee/home/home.wxss */
.container {
  background:
    radial-gradient(circle at 12% 8%, rgba(130, 202, 255, 0.18) 0%, transparent 24%),
    radial-gradient(circle at 86% 12%, rgba(255, 225, 158, 0.18) 0%, transparent 22%),
    linear-gradient(180deg, #eef6ff 0%, #f7fbff 42%, #fbfcfe 100%);
}

.card {
  border: 2rpx solid #e8eef8;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 26rpx rgba(17, 38, 84, 0.07);
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
}

.section-title {
  color: #1e3550;
}

.hero-panel {
  border: 2rpx solid #d5e7fb;
  box-shadow: 0 14rpx 30rpx rgba(21, 84, 155, 0.16);
}

.employee-hero {
  padding: 28rpx;
  border-radius: 28rpx;
  margin-bottom: 24rpx;
  color: #fff;
  background: linear-gradient(135deg, #134a8a 0%, #1f76cc 52%, #42a0f5 100%);
}

.employee-top-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.user-avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 28rpx;
  background: rgba(255,255,255,0.18);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 42rpx;
  font-weight: bold;
  margin-right: 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.18);
}

.user-info {
  flex: 1;
}

.user-name {
  display: block;
  font-size: 42rpx;
  font-weight: bold;
}

.user-role {
  display: block;
  margin-top: 4rpx;
  font-size: 26rpx;
  color: rgba(255,255,255,0.84);
}

.user-join-date {
  display: block;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: rgba(255,255,255,0.78);
}

.time-panel {
  min-width: 132rpx;
  flex-shrink: 0;
  text-align: right;
}

.date-text {
  display: block;
  font-size: 26rpx;
  color: rgba(255,255,255,0.82);
}

.time-text {
  display: block;
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: bold;
}

.hero-status-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 26rpx;
}

.hero-status-card {
  flex: 1 1 160rpx;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: rgba(255,255,255,0.12);
  min-width: 0;
}

.hero-status-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255,255,255,0.76);
}

.hero-status-value {
  display: block;
  margin-top: 8rpx;
  font-size: 34rpx;
  font-weight: bold;
}

.stats-row {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-item {
  flex: 1 1 280rpx;
  padding: 28rpx 22rpx;
  min-width: 0;
}

.stat-wage {
  background: linear-gradient(135deg, #fff4e4 0%, #fffaf2 100%);
  border-color: #f3dfc2;
}

.stat-hours {
  background: linear-gradient(135deg, #eef8f2 0%, #fbfffc 100%);
  border-color: #d7eede;
}

.stat-label-top {
  display: block;
  font-size: 26rpx;
  color: #6f7f90;
}

.stat-value {
  display: block;
  margin-top: 12rpx;
  font-size: 48rpx;
  font-weight: bold;
  color: #1f3855;
}

.stat-foot {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #95a3b1;
}

.clock-section {
  margin-top: 18rpx;
  border-color: #dce9f6;
}

.clock-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 12rpx;
}

.clock-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #8294a7;
}

.scan-chip {
  padding: 10rpx 16rpx;
  border-radius: 999rpx;
  background: #edf7ff;
  color: #1c71c5;
  font-size: 24rpx;
  font-weight: bold;
  flex-shrink: 0;
}

.clock-buttons {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  margin-top: 24rpx;
}

.clock-btn-wrap {
  width: 100%;
}

.clock-btn {
  width: 100%;
  min-height: 164rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: none;
  color: #fff;
  padding: 24rpx 22rpx;
  line-height: 1.4;
  box-sizing: border-box;
  text-align: center;
}

.clock-btn::after {
  border: none;
}

.clock-btn-in {
  background: linear-gradient(135deg, #2b9b5d, #59c07d);
  box-shadow: 0 12rpx 24rpx rgba(43, 155, 93, 0.24);
}

.clock-btn-out {
  background: linear-gradient(135deg, #db6b39, #f79a54);
  box-shadow: 0 12rpx 24rpx rgba(219, 107, 57, 0.24);
}

.clock-btn-done {
  background: linear-gradient(135deg, #7a8fa3, #9fb0c0);
}

.clock-btn-disabled {
  background: linear-gradient(135deg, #dce4ec, #edf2f7);
  color: #7d8ea0;
}

.clock-btn-caption {
  font-size: 24rpx;
  opacity: 0.82;
  text-align: center;
}

.clock-btn-text {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  white-space: normal;
  word-break: break-all;
}

.clock-btn-time {
  margin-top: 10rpx;
  font-size: 30rpx;
  opacity: 0.92;
  text-align: center;
}

.session-info {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #58708a;
}

.session-divider {
  margin: 0 12rpx;
  color: #9bb0c4;
}

.quick-panel {
  margin-top: 18rpx;
}

.panel-title-row {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 18rpx;
}

.panel-title-note {
  font-size: 24rpx;
  color: #91a2b3;
}

.quick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.quick-card {
  width: calc(50% - 8rpx);
  padding: 24rpx 20rpx;
  border-radius: 22rpx;
  border: 2rpx solid #edf2f8;
  background: #fff;
  box-sizing: border-box;
  min-width: 0;
}

.menu-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 38rpx;
  margin-bottom: 16rpx;
  box-shadow: 0 8rpx 16rpx rgba(33, 66, 122, 0.12);
}

.bg-blue { background: #e8f4ff; }
.bg-green { background: #edfdf3; }
.bg-red { background: #fff1f0; }
.bg-orange { background: #fff6e9; }
.bg-purple { background: #eef0ff; }

.menu-text {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #28455f;
  word-break: break-all;
}

.menu-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #8da0b4;
  line-height: 1.55;
  word-break: break-all;
}

.logout-bar {
  display: flex;
  align-items: center;
  margin-top: 18rpx;
  padding: 22rpx 10rpx 4rpx;
  border-top: 1rpx solid #edf2f8;
}

.logout-text-main {
  flex: 1;
  font-size: 32rpx;
  color: #26425d;
}

.logout-arrow {
  font-size: 40rpx;
  color: #9cb0c3;
}

/* 修改密码弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
}
.modal-dialog {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  background: linear-gradient(145deg, #ffffff 0%, #fbfdff 100%);
  border: 2rpx solid #e6eef8;
  border-radius: 24rpx;
  box-shadow: 0 14rpx 30rpx rgba(17, 38, 84, 0.16);
  z-index: 1001;
}
.modal-title {
  text-align: center;
  font-size: 36rpx;
  font-weight: bold;
  padding: 32rpx 0 16rpx;
}
.modal-body {
  padding: 16rpx 32rpx;
}
.modal-footer {
  display: flex;
  border-top: 1rpx solid #eee;
}
.modal-btn {
  flex: 1;
  border-radius: 0 !important;
  font-size: 32rpx;
  margin: 0 !important;
  padding: 24rpx 0 !important;
  background: none;
  line-height: 1.5;
}
.modal-btn.btn-primary {
  background: #1890FF;
  color: #fff;
}
.pwd-input-wrap {
  display: flex;
  align-items: center;
}
.pwd-input-wrap .input-field {
  flex: 1;
}
.pwd-toggle {
  font-size: 30rpx;
  color: #1890FF;
  padding: 0 10rpx;
  white-space: nowrap;
}
