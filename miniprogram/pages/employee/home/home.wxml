<!--pages/employee/home/home.wxml-->
<view class="container">
  <view class="employee-hero hero-panel">
    <view class="employee-top-row">
      <view class="user-avatar">{{userInfo.name[0]}}</view>
      <view class="user-info">
        <text class="user-name">{{userInfo.name}}</text>
        <text class="user-role">员工工作台</text>
        <text class="user-join-date" wx:if="{{joinDateDisplay}}">入厂时间：{{joinDateDisplay}}</text>
      </view>
      <view class="time-panel">
        <text class="date-text">{{todayDate}}</text>
        <text class="time-text">{{currentTime}}</text>
      </view>
    </view>

    <view class="hero-status-row">
      <view class="hero-status-card">
        <text class="hero-status-label">今日状态</text>
        <text class="hero-status-value">{{clockedIn ? '在岗中' : '未上班'}}</text>
      </view>
      <view class="hero-status-card">
        <text class="hero-status-label">今日工时</text>
        <text class="hero-status-value">{{todayHours}}h</text>
      </view>
      <view class="hero-status-card">
        <text class="hero-status-label">打卡次数</text>
        <text class="hero-status-value">{{sessionCount}}</text>
      </view>
    </view>
  </view>

  <view class="stats-row">
    <view class="stat-item stat-wage card">
      <text class="stat-label-top">今日预估工资</text>
      <text class="stat-value">¥{{todayEarnings}}</text>
      <text class="stat-foot">基于今日报工实时计算</text>
    </view>
    <view class="stat-item stat-hours card">
      <text class="stat-label-top">本月累计工时</text>
      <text class="stat-value">{{monthHours}}h</text>
      <text class="stat-foot">含今日已完成工时</text>
    </view>
  </view>

  <view class="clock-section card">
    <view class="clock-head">
      <view>
        <text class="section-title">考勤打卡</text>
        <text class="clock-subtitle">请在进入工厂后完成上班打卡，离厂前完成下班打卡。</text>
      </view>
      <view wx:if="{{clockSource === 'scan'}}" class="scan-chip">扫码入口</view>
    </view>

    <view class="clock-buttons">
      <view class="clock-btn-wrap">
        <button
          class="clock-btn {{clockedIn ? 'clock-btn-done' : 'clock-btn-in'}}"
          bindtap="onClockIn"
          disabled="{{clockedIn || loading}}"
        >
          <text class="clock-btn-caption">上班状态</text>
          <text class="clock-btn-text">{{clockedIn ? '已开始工作' : '上班打卡'}}</text>
          <text class="clock-btn-time" wx:if="{{clockInTime}}">{{clockInTime}}</text>
        </button>
      </view>

      <view class="clock-btn-wrap">
        <button
          class="clock-btn {{clockedIn ? 'clock-btn-out' : 'clock-btn-disabled'}}"
          bindtap="onClockOut"
          disabled="{{!clockedIn || loading}}"
        >
          <text class="clock-btn-caption">下班状态</text>
          <text class="clock-btn-text">下班打卡</text>
          <text class="clock-btn-time" wx:if="{{clockOutTime}}">{{clockOutTime}}</text>
        </button>
      </view>
    </view>

    <view class="session-info">
      <text>今日已打卡 {{sessionCount}} 次</text>
      <text class="session-divider">·</text>
      <text>累计工时 {{todayHours}}h</text>
    </view>
  </view>

  <view class="card quick-panel">
    <view class="panel-title-row">
      <text class="section-title">快捷操作</text>
      <text class="panel-title-note">常用入口</text>
    </view>

    <view class="quick-grid">
      <view class="quick-card" bindtap="onScanQR">
        <view class="menu-icon bg-purple">📷</view>
        <text class="menu-text">扫码打卡</text>
        <text class="menu-desc">扫描管理员生成的考勤码</text>
      </view>
      <view class="quick-card" bindtap="goToWorklog">
        <view class="menu-icon bg-blue">📝</view>
        <text class="menu-text">计件报工</text>
        <text class="menu-desc">填写今日产量与工序记录</text>
      </view>
      <view class="quick-card" bindtap="goToProfile">
        <view class="menu-icon bg-green">👤</view>
        <text class="menu-text">我的工资</text>
        <text class="menu-desc">查看工资与奖惩明细</text>
      </view>
      <view class="quick-card" bindtap="openChangePwd">
        <view class="menu-icon bg-orange">🔒</view>
        <text class="menu-text">修改密码</text>
        <text class="menu-desc">定期更新密码更安全</text>
      </view>
    </view>

    <view class="logout-bar" bindtap="onLogout">
      <view class="menu-icon bg-red">🚪</view>
      <text class="logout-text-main">退出当前登录</text>
      <text class="logout-arrow">›</text>
    </view>
  </view>

  <!-- 修改密码弹窗 -->
  <view wx:if="{{showChangePwd}}">
    <view class="modal-mask" bindtap="closeChangePwd"></view>
    <view class="modal-dialog">
      <view class="modal-title">修改密码</view>
      <view class="modal-body">
        <view class="input-group">
          <text class="input-label">旧密码</text>
          <view class="pwd-input-wrap">
            <input class="input-field" type="{{showOldPwd ? 'text' : 'password'}}" placeholder="请输入旧密码" value="{{changePwdData.oldPassword}}" bindinput="onOldPwdInput" />
            <text class="pwd-toggle" bindtap="toggleOldPwd">{{showOldPwd ? '隐藏' : '显示'}}</text>
          </view>
        </view>
        <view class="input-group">
          <text class="input-label">新密码</text>
          <view class="pwd-input-wrap">
            <input class="input-field" type="{{showNewPwd ? 'text' : 'password'}}" placeholder="至少8位，含字母和数字" value="{{changePwdData.newPassword}}" bindinput="onNewPwdInput" />
            <text class="pwd-toggle" bindtap="toggleNewPwd">{{showNewPwd ? '隐藏' : '显示'}}</text>
          </view>
        </view>
        <view class="input-group">
          <text class="input-label">确认新密码</text>
          <input class="input-field" type="password" placeholder="再次输入新密码" value="{{changePwdData.confirmPassword}}" bindinput="onConfirmPwdInput" />
        </view>
      </view>
      <view class="modal-footer">
        <button class="btn-default modal-btn" bindtap="closeChangePwd">取消</button>
        <button class="btn-primary modal-btn" bindtap="onSubmitChangePwd" disabled="{{changePwdLoading}}">
          {{changePwdLoading ? '提交中...' : '确认修改'}}
        </button>
      </view>
    </view>
  </view>
</view>
