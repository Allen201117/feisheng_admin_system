<import src="/templates/shared.wxml" />

<view class="container employee-home-page">

  <!-- Hero-employee -->
  <view class="hero hero-employee home-hero">
    <view class="hero-top home-hero-top">
      <view class="hero-avatar">{{userInfo.name[0]}}</view>
      <view class="hero-left">
        <text class="hero-title">{{userInfo.name}}</text>
        <text class="hero-subtitle">员工工作台</text>
        <text class="hero-meta" wx:if="{{userInfo.org_name}}">{{userInfo.org_name}}</text>
      </view>
      <view class="hero-time-col">
        <text class="hero-meta">{{todayDate}}</text>
        <text class="hero-time-text">{{currentTime}}</text>
      </view>
    </view>
    <view class="home-hero-metrics">
      <view class="home-hero-primary" bindtap="goToProfile" hover-class="tap-card-hover" hover-stay-time="80">
        <text class="home-hero-metric-label">今日预估工资</text>
        <text class="home-hero-money">¥{{todayEarnings}}</text>
        <text class="home-hero-metric-note">按今日报工实时估算</text>
      </view>
      <view class="home-hero-secondary">
        <view class="home-hero-mini" bindtap="goToProfile" hover-class="tap-card-hover" hover-stay-time="80">
          <text class="home-hero-metric-label">本月累计工时</text>
          <text class="home-hero-metric-value">{{monthHours}}h</text>
        </view>
        <view class="home-hero-mini" bindtap="goToProfile" hover-class="tap-card-hover" hover-stay-time="80">
          <text class="home-hero-metric-label">入厂时间</text>
          <text class="home-hero-metric-value home-hero-date">{{joinDateDisplay || '未登记'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 考勤打卡 -->
  <view class="clock-section home-clock-compact">
    <view class="flex-between home-clock-header">
      <view>
        <text class="font-semibold">考勤打卡</text>
        <text class="clock-hint">上班与下班状态</text>
      </view>
      <view wx:if="{{clockSource === 'scan'}}" class="badge badge-blue">扫码入口</view>
    </view>
    <view class="clock-btns">
      <button class="clock-btn {{clockedIn ? 'clock-btn-done' : 'clock-btn-in'}}" bindtap="onClockIn" disabled="{{clockedIn || loading}}" hover-class="tap-button-hover">
        <text class="clock-btn-label">上班</text>
        <text class="clock-btn-text">{{clockedIn ? '已开始' : '打卡'}}</text>
        <text class="clock-btn-time" wx:if="{{clockInTime}}">{{clockInTime}}</text>
      </button>
      <button class="clock-btn {{clockedIn ? 'clock-btn-out' : 'clock-btn-disabled'}}" bindtap="onClockOut" disabled="{{!clockedIn || loading}}" hover-class="tap-button-hover">
        <text class="clock-btn-label">下班</text>
        <text class="clock-btn-text">打卡</text>
        <text class="clock-btn-time" wx:if="{{clockOutTime}}">{{clockOutTime}}</text>
      </button>
    </view>
    <view class="divider home-clock-divider"></view>
    <view class="clock-hint home-clock-summary">今日已打卡 {{sessionCount}} 次 · 累计工时 {{todayHours}}h</view>
  </view>

  <!-- 今日报工 -->
  <view class="home-process-section">
    <view class="home-worklog-head">
      <view class="home-section-copy">
        <text class="home-section-title">今日报工</text>
        <text class="home-section-subtitle">负责工序 {{assignedProcessTotal}} 道，点击工序进入报工</text>
      </view>
    </view>

    <view wx:if="{{homeProcessLoading}}" class="home-process-loading">
      <view class="skeleton skeleton-card"></view>
      <view class="skeleton skeleton-card"></view>
    </view>

    <view wx:elif="{{assignedProcessTotal === 0}}" class="empty home-process-empty">
      <view class="empty-icon">
        <image src="/images/icons/worklog.svg" mode="aspectFit" class="icon-sm" />
      </view>
      <text class="empty-title">暂无负责工序</text>
      <text class="empty-desc">管理员分配后会显示在这里</text>
      <view class="empty-action secondary" bindtap="loadHomeAssignedProcesses" hover-class="tap-button-hover">刷新</view>
    </view>

    <view wx:else class="home-process-list">
      <view
        wx:for="{{displayedHomeProcesses}}"
        wx:for-item="item"
        wx:key="_id"
        class="home-process-card tappable {{item.isComplete ? 'is-complete' : ''}}"
        bindtap="goToWorklog"
        data-id="{{item._id}}"
        hover-class="tap-card-hover"
        hover-stay-time="80"
      >
        <view class="home-process-card-head">
          <view class="home-process-main">
            <text class="home-process-name">{{item.process_name}}</text>
            <text class="home-process-order">{{item.order_name}}</text>
          </view>
          <text class="home-process-price">{{item.priceText}}</text>
        </view>

        <view class="home-process-tags">
          <text class="home-process-tag {{item.isComplete ? 'is-muted' : 'is-ready'}}">{{item.statusText}}</text>
          <text class="home-process-tag">{{item.quotaText}}</text>
          <text class="home-process-tag">已报 {{item.current_total}} 件</text>
        </view>

        <view class="home-process-progress">
          <view class="home-process-progress-fill {{item.isComplete ? 'is-complete' : ''}}" style="width: {{item.progressPercent}}%;"></view>
        </view>

        <view class="home-process-foot">
          <text class="home-process-foot-text">{{item.actionText}}</text>
        </view>
      </view>

      <view wx:if="{{hasMoreAssignedProcesses}}" class="home-more-row" bindtap="goToWorklog" hover-class="tap-row-hover">
        <text>查看全部 {{assignedProcessTotal}} 道工序</text>
      </view>
    </view>
  </view>

  <!-- 快捷操作 -->
  <view class="card-bento">
    <text class="menu-group-title block-mb-2">快捷操作</text>
    <view class="quick-grid">
      <view class="quick-item" bindtap="onScanQR" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="quick-item-icon blue">
          <image src="/images/icons/camera.svg" mode="aspectFit" class="icon-sm" />
        </view>
        <text class="quick-item-label">扫码打卡</text>
        <text class="quick-item-desc">管理员考勤码</text>
      </view>
      <view class="quick-item" bindtap="goToWorklog" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="quick-item-icon blue">
          <image src="/images/icons/edit.svg" mode="aspectFit" class="icon-sm" />
        </view>
        <text class="quick-item-label">报工记录</text>
        <text class="quick-item-desc">今日记录与修改</text>
      </view>
      <view class="quick-item" bindtap="goToProfile" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="quick-item-icon green">
          <image src="/images/icons/profile.svg" mode="aspectFit" class="icon-sm" />
        </view>
        <text class="quick-item-label">我的工资</text>
        <text class="quick-item-desc">工资与奖惩明细</text>
      </view>
      <view class="quick-item" bindtap="goToLeaderboard" wx:if="{{leaderboardVisible}}" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="quick-item-icon slate">
          <image src="/images/icons/leaderboard.svg" mode="aspectFit" class="icon-sm" />
        </view>
        <text class="quick-item-label">排行榜</text>
        <text class="quick-item-desc">排名统计</text>
      </view>
    </view>
    <view class="divider home-quick-divider"></view>
    <view class="logout-row" bindtap="onLogout" hover-class="tap-row-hover" hover-stay-time="80">
      <view class="quick-item-icon red">
        <image src="/images/icons/logout.svg" mode="aspectFit" class="icon-sm" />
      </view>
      <text class="logout-row-text">退出当前登录</text>
    </view>
  </view>

  <!-- 修改密码弹窗 -->
  <view wx:if="{{showChangePwd}}">
    <view class="modal-overlay" bindtap="closeChangePwd"></view>
    <view class="modal-sheet" catchtap="true">
      <view class="modal-sheet-title">修改密码</view>
      <view class="modal-sheet-body home-modal-body">
        <view class="field-group">
          <text class="field-label">旧密码</text>
          <view class="flex-row gap-1">
            <input class="field-input flex-1" type="{{showOldPwd ? 'text' : 'password'}}" placeholder="请输入旧密码" value="{{changePwdData.oldPassword}}" bindinput="onOldPwdInput" />
            <text class="font-medium text-accent home-pwd-toggle" bindtap="toggleOldPwd" hover-class="tap-chip-hover">{{showOldPwd ? '隐藏' : '显示'}}</text>
          </view>
        </view>
        <view class="field-group">
          <text class="field-label">新密码</text>
          <view class="flex-row gap-1">
            <input class="field-input flex-1" type="{{showNewPwd ? 'text' : 'password'}}" placeholder="至少8位，含字母和数字" value="{{changePwdData.newPassword}}" bindinput="onNewPwdInput" />
            <text class="font-medium text-accent home-pwd-toggle" bindtap="toggleNewPwd" hover-class="tap-chip-hover">{{showNewPwd ? '隐藏' : '显示'}}</text>
          </view>
        </view>
        <view class="field-group">
          <text class="field-label">确认新密码</text>
          <input class="field-input" type="password" placeholder="再次输入新密码" value="{{changePwdData.confirmPassword}}" bindinput="onConfirmPwdInput" />
        </view>
      </view>
      <view class="modal-sheet-footer">
        <button class="modal-sheet-btn" bindtap="closeChangePwd" hover-class="tap-row-hover">取消</button>
        <button class="modal-sheet-btn" bindtap="onSubmitChangePwd" disabled="{{changePwdLoading}}" hover-class="tap-row-hover">
          {{changePwdLoading ? '提交中...' : '确认修改'}}
        </button>
      </view>
    </view>
  </view>

</view>
