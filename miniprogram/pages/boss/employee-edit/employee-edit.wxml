<view class="container employee-edit-page">
  <view class="card-bento">
    <view class="field-group">
      <text class="field-label">姓名 *</text>
      <input class="field-input" placeholder="请输入员工姓名" value="{{name}}" bindinput="onInputName" maxlength="20" />
    </view>

    <view class="field-group">
      <text class="field-label">手机号 *</text>
      <input class="field-input" placeholder="请输入手机号" type="number" value="{{phone}}" bindinput="onInputPhone" maxlength="11" />
    </view>

    <view class="field-group">
      <text class="field-label">角色 *</text>
      <picker mode="selector" range="{{roleNames}}" value="{{roleIndex}}" bindchange="onRoleChange">
        <view class="picker-field">
          <text>{{roleNames[roleIndex]}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="field-group">
      <text class="field-label">密码 <text class="text-tertiary text-xs">（不填则默认为手机号）</text></text>
      <input class="field-input" placeholder="默认为手机号" password="{{true}}" value="{{password}}" bindinput="onInputPassword" maxlength="20" />
    </view>

    <view class="field-group">
      <text class="field-label">入厂时间 <text class="text-tertiary text-xs">（选填，仅老板可设置）</text></text>
      <picker mode="date" value="{{joinDate}}" bindchange="onJoinDateChange">
        <view class="picker-field">
          <text wx:if="{{joinDate}}">{{joinDate}}</text>
          <text wx:else class="text-secondary">请选择入厂时间</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

  </view>

  <view class="bottom-action-bar">
    <button class="btn-primary btn-block" bindtap="onSave" disabled="{{loading}}" hover-class="tap-button-hover">{{loading ? '保存中...' : (isEdit ? '保存修改' : '添加员工')}}</button>
  </view>
</view>
