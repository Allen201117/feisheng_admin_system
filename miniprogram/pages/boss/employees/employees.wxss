/* pages/boss/employees/employees.wxss */
.container {
  background:
    radial-gradient(circle at 10% 8%, rgba(142, 183, 223, 0.16) 0%, transparent 24%),
    radial-gradient(circle at 88% 10%, rgba(205, 216, 228, 0.18) 0%, transparent 24%),
    linear-gradient(180deg, #eef3f7 0%, #f8fbfd 100%);
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.add-btn {
  font-size: 28rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  line-height: 1.5;
  min-height: 0;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.26);
  max-width: 100%;
}

.emp-card {
  padding: 24rpx;
  border: 2rpx solid #edf1f8;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 38, 84, 0.06);
}

.emp-header {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 16rpx;
}

.emp-avatar {
  width: 84rpx;
  height: 84rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1766b7 0%, #3f94ef 100%);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  font-weight: 700;
  margin-right: 0;
}

.emp-info {
  flex: 1;
}

.emp-name {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  color: #1f3554;
}

.emp-phone {
  display: block;
  margin-top: 4rpx;
}

.emp-body {
  padding: 8rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 6rpx;
}

.emp-role {
  font-size: 32rpx;
  color: #5f7490;
}

.emp-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf1f8;
}

.btn-sm {
  font-size: 28rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: none;
  min-height: 0;
  line-height: 1.8;
  flex: 1 1 180rpx;
}

.btn-sm::after { border: none; }

.btn-edit {
  background: #ebf4ff;
  color: #175bb0;
}

.btn-disable {
  background: #FFF1F0;
  color: #FF4D4F;
}

.btn-enable {
  background: #F6FFED;
  color: #52C41A;
}

.btn-reset {
  background: #fff2e8;
  color: #cf4b11;
}
