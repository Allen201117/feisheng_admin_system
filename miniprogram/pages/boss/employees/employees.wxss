.container { padding-bottom: 60rpx; }

.employees-page {
  background: var(--bg-page);
}

.employees-page .page-header {
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.employees-page .page-header-title {
  font-size: 46rpx;
  line-height: 1.12;
}

.employee-add-btn {
  flex-shrink: 0;
  min-width: 108rpx;
  min-height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #007AFF;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-blue);
}

.employee-card {
  padding: 28rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-card);
  margin-bottom: 18rpx;
}

.employee-card .emp-row {
  padding: 0 0 22rpx;
  border-bottom: 1rpx solid var(--hairline);
}

.employee-card .emp-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 20rpx;
  font-size: 32rpx;
}

.employee-card .emp-name {
  font-size: 32rpx;
  line-height: 1.35;
}

.employee-card .emp-meta {
  display: block;
  font-size: 25rpx;
  line-height: 1.45;
  color: var(--text-secondary);
}

.employee-actions {
  display: grid;
  grid-template-columns: 1fr 1.15fr 1fr;
  gap: 10rpx;
  padding-top: 18rpx;
}

.employee-action {
  min-height: 60rpx;
  border-radius: 999rpx;
  background: var(--surface-strong);
  color: var(--text-primary);
  font-size: 25rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.16s var(--ease-apple);
}

.employee-action.primary {
  background: rgba(0,122,255,0.12);
  color: #007AFF;
}

.employee-action.danger {
  background: rgba(255,59,48,0.09);
  color: #D92D20;
}

.employee-action.success {
  background: rgba(52,199,89,0.13);
  color: #248A3D;
}
