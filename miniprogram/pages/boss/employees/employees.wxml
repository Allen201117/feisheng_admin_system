<view class="container employees-page">

  <view class="page-header">
    <view class="page-header-left">
      <text class="page-header-title">员工列表</text>
      <text class="page-header-subtitle">{{employeeSearchKeyword ? filteredEmployees.length + '/' + employees.length : employees.length}}人</text>
    </view>
    <view class="employee-add-btn tappable" bindtap="goAddEmployee" hover-class="tap-button-hover">添加</view>
  </view>

  <view class="list-search-row">
    <input class="field-input list-search-input" placeholder="搜索姓名、手机号、角色" value="{{employeeSearchKeyword}}" bindinput="onEmployeeSearchInput" confirm-type="search" />
    <view wx:if="{{employeeSearchKeyword}}" class="btn-sm btn-sm-secondary list-search-clear tappable" bindtap="clearEmployeeSearch" hover-class="tap-button-hover">清除</view>
  </view>

  <view wx:if="{{employees.length === 0 && !loading}}" class="empty">
    <view class="empty-icon">
      <image src="/images/icons/employees.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
    </view>
    <text class="empty-title">暂无员工</text>
    <text class="empty-desc">请添加员工以开始使用</text>
  </view>
  <view wx:elif="{{filteredEmployees.length === 0 && !loading}}" class="empty">
    <view class="empty-icon">
      <image src="/images/icons/employees.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
    </view>
    <text class="empty-title">没有匹配的员工</text>
    <text class="empty-desc">换个姓名、手机号或角色再试</text>
  </view>

  <view wx:for="{{filteredEmployees}}" wx:key="_id" class="employee-card">
    <view class="emp-row tappable" bindtap="goSalaryArchive" data-id="{{item._id}}" data-name="{{item.name}}" data-role="{{item.role_name}}" hover-class="tap-row-hover">
      <view class="emp-avatar blue">{{item.name[0]}}</view>
      <view class="emp-info">
        <view class="flex-row gap-1" style="margin-bottom:4rpx;">
          <text class="emp-name">{{item.name}}</text>
          <text class="badge {{item.status === 'active' ? 'badge-green' : 'badge-red'}}">{{item.status_text}}</text>
        </view>
        <text class="emp-meta">{{item.phone}}</text>
        <text class="emp-meta">角色: {{item.role_name}}<text wx:if="{{item.join_date}}"> | 入厂: {{item.join_date}}</text><text wx:else> | 入厂时间: 未设置</text></text>
      </view>
      <text class="text-accent text-xs" style="flex-shrink:0;">工资档案 ›</text>
    </view>
    <view class="employee-actions">
      <view class="employee-action primary" bindtap="goEditEmployee" data-id="{{item._id}}" hover-class="tap-button-hover">编辑</view>
      <view class="employee-action" bindtap="resetPassword" data-emp="{{item}}" hover-class="tap-button-hover">重置密码</view>
      <view class="employee-action {{item.status === 'active' ? 'danger' : 'success'}}" bindtap="toggleStatus" data-emp="{{item}}" hover-class="tap-button-hover">{{item.status === 'active' ? '停用' : '启用'}}</view>
    </view>
  </view>

</view>
