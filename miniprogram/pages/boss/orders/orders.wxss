/* pages/boss/orders/orders.wxss */
.container {
  background:
    radial-gradient(circle at 10% 8%, rgba(142, 183, 223, 0.16) 0%, transparent 24%),
    radial-gradient(circle at 88% 10%, rgba(205, 216, 228, 0.18) 0%, transparent 24%),
    linear-gradient(180deg, #eef3f7 0%, #f8fbfd 100%);
}

.hero-panel {
  margin-bottom: 22rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fbfdff 100%);
  border: 2rpx solid #dde6ef;
  border-radius: 24rpx;
}

.top-bar {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #132544;
}

.hero-subtitle {
  display: block;
  margin-top: 4rpx;
  font-size: 28rpx;
  color: #6d7e95;
}

.add-btn {
  font-size: 28rpx;
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  line-height: 1.5;
  min-height: 0;
  box-shadow: 0 8rpx 20rpx rgba(24, 144, 255, 0.26);
  max-width: 100%;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  margin-bottom: 18rpx;
}

.stat-item {
  border-radius: 14rpx;
  padding: 18rpx;
  display: flex;
  flex-direction: column;
  border: 2rpx solid transparent;
}

.stat-neutral {
  background: #eef4ff;
  border-color: #dce8ff;
}

.stat-active {
  background: #e9f9f1;
  border-color: #c9efd9;
}

.stat-completed {
  background: #eaf6ff;
  border-color: #d3eafd;
}

.stat-overdue {
  background: #fff1ef;
  border-color: #ffd8d2;
}

.stat-value {
  font-size: 48rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #1b304f;
}

.stat-label {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #667892;
}

.filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #d8e4f3;
  font-size: 28rpx;
  color: #4e6483;
  background: #fff;
}

.filter-chip-active {
  border-color: #1890ff;
  background: #e8f4ff;
  color: #0b62b4;
  font-weight: 700;
}

.picker-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  border: 2rpx solid #D9D9D9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  background: #fff;
  font-size: 34rpx;
}

.picker-arrow {
  font-size: 28rpx;
  color: #666;
}

.order-card {
  padding: 24rpx;
  margin-bottom: 18rpx;
  border: 2rpx solid #edf1f8;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 38, 84, 0.06);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.order-title-wrap {
  flex: 1;
  min-width: 0;
}

.order-name {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: #152a45;
  line-height: 1.3;
}

.order-date {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #556677;
}

.timeline-box {
  margin-bottom: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #f7faff;
}

.timeline-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.timeline-label {
  font-size: 24rpx;
  color: #60738c;
}

.timeline-text {
  font-size: 24rpx;
}

.timeline-track {
  height: 12rpx;
  border-radius: 999rpx;
  background: #dfe9f8;
  overflow: hidden;
}

.timeline-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #52c41a 0%, #1890ff 100%);
}

.timeline-fill-overdue {
  background: linear-gradient(90deg, #ff7a45 0%, #ff4d4f 100%);
}

.order-body {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.metric-item {
  flex: 1 1 220rpx;
  background: #fbfcff;
  border: 2rpx solid #edf2fa;
  border-radius: 12rpx;
  padding: 12rpx 16rpx;
  min-width: 0;
}

.metric-label {
  display: block;
  font-size: 24rpx;
  color: #7588a0;
}

.metric-value {
  margin-top: 6rpx;
  display: block;
  font-size: 32rpx;
  color: #24415d;
  font-weight: 700;
}

.order-footer {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 14rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #F0F0F0;
}

.order-actions {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  width: 100%;
}

.btn-sm {
  font-size: 30rpx;
  padding: 10rpx 28rpx;
  border-radius: 8rpx;
  border: none;
  min-height: 0;
  line-height: 1.8;
  flex: 1 1 200rpx;
}

.btn-sm::after { border: none; }

.btn-complete {
  background: #e8f7eb;
  color: #2c9e3f;
}

.btn-status {
  background: #ebf4ff;
  color: #175bb0;
}

.btn-delete {
  background: #fff1f0;
  color: #cf1322;
}
