.orders-page {
  padding: 24rpx 24rpx 72rpx;
  background: #F5F5F7;
}

.orders-page .page-header {
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.orders-create-btn {
  flex-shrink: 0;
  min-width: 116rpx;
  min-height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: none;
  background: #0A84FF;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
}

.orders-create-btn.is-cancel {
  background: #F2F4F7;
  color: #475467;
}

button.orders-create-btn::after { border: none; }

.orders-summary,
.orders-page .card-bento,
.orders-page .order-card {
  border-radius: 28rpx;
  border: 1rpx solid rgba(226,232,240,0.88);
  box-shadow: 0 8rpx 24rpx rgba(15,23,42,0.045);
}

.orders-summary {
  padding: 26rpx;
}

.orders-page .stats-card {
  border: none;
  border-radius: 22rpx;
  background: #F8FAFC;
  box-shadow: none;
  padding: 26rpx;
}

.orders-page .stats-card.blue,
.orders-page .stats-card.green,
.orders-page .stats-card.amber,
.orders-page .stats-card.red,
.orders-page .stats-card.slate {
  border-left: none;
}

.orders-page .stats-card-value {
  font-size: 42rpx;
  line-height: 1;
  color: #111827;
}

.orders-page .stats-card-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: #667085;
}

.orders-page .filter-chips {
  padding: 6rpx;
  border-radius: 999rpx;
  background: #F2F4F7;
  flex-wrap: nowrap;
  gap: 0;
}

.orders-page .filter-chip {
  flex: 1;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: #667085;
  font-size: 27rpx;
  padding: 0 12rpx;
}

.orders-page .filter-chip-active {
  background: #FFFFFF;
  color: #111827;
  box-shadow: 0 4rpx 12rpx rgba(15,23,42,0.08);
}

.orders-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.orders-page .order-card-name {
  font-size: 34rpx;
  line-height: 1.25;
  color: #111827;
}

.orders-page .order-card-date {
  color: #98A2B3;
  font-size: 25rpx;
}

.orders-page .badge {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
}

.orders-mini-metric {
  padding: 18rpx 20rpx;
  margin-bottom: 0;
  border: none;
  border-radius: 18rpx;
  background: #F8FAFC;
  box-shadow: none;
}

.orders-tool-btn {
  min-width: 96rpx;
  min-height: 58rpx;
  border-radius: 999rpx;
  border: none;
  background: #F2F4F7;
  color: #475467;
  font-size: 25rpx;
  padding: 0 20rpx;
}

.orders-tool-btn.success {
  background: rgba(52,199,89,0.13);
  color: #248A3D;
}

.orders-tool-btn.danger {
  color: #D92D20;
  background: rgba(255,59,48,0.09);
  border: none;
}

.orders-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding-top: 18rpx;
}

.orders-detail-hint {
  flex: 1;
  min-width: 0;
  color: #007AFF;
  font-size: 26rpx;
  font-weight: 600;
}

.orders-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 10rpx;
  flex-wrap: wrap;
}

.badge.tag-success { background: var(--green-100); color: var(--green-600); }
.badge.tag-danger  { background: var(--red-100); color: var(--red-600); }
.badge.tag-info    { background: var(--blue-100); color: var(--blue-600); }
.badge.tag-warning { background: var(--amber-100); color: var(--amber-600); }
