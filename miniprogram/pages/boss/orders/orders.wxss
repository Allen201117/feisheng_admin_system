.orders-page {
  padding: 24rpx 24rpx 72rpx;
  background: var(--bg-page);
}

.orders-page .page-header {
  align-items: flex-start;
  margin-bottom: 22rpx;
}

.orders-create-btn {
  flex-shrink: 0;
  min-width: 116rpx;
  min-height: 62rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: none;
  background: #0A84FF;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: var(--shadow-blue);
}

.orders-create-btn.is-cancel {
  background: var(--surface-strong);
  color: var(--text-primary);
  box-shadow: none;
}

button.orders-create-btn::after { border: none; }

.orders-summary,
.orders-page .card-bento,
.orders-page .order-card {
  border-radius: 28rpx;
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-card);
}

.orders-summary {
  padding: 26rpx;
}

.orders-page .stats-card {
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  box-shadow: var(--shadow-card);
  padding: 26rpx;
}

.orders-page .stats-card.blue,
.orders-page .stats-card.green,
.orders-page .stats-card.amber,
.orders-page .stats-card.red,
.orders-page .stats-card.slate {
  border-left: none;
}

.orders-page .stats-card-value {
  font-size: 42rpx;
  line-height: 1;
  color: #111827;
}

.orders-page .stats-card-label {
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--text-primary);
}

.orders-page .filter-chips {
  padding: 6rpx;
  border-radius: 999rpx;
  background: var(--surface-strong);
  border: 1rpx solid var(--hairline);
  flex-wrap: nowrap;
  gap: 0;
}

.orders-page .filter-chip {
  flex: 1;
  min-height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  color: var(--text-primary);
  font-size: 27rpx;
  padding: 0 12rpx;
}

.orders-page .filter-chip-active {
  background: #FFFFFF;
  color: #111827;
  box-shadow: 0 6rpx 16rpx rgba(15,23,42,0.12);
}

.orders-card {
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.orders-page .order-card-name {
  font-size: 34rpx;
  line-height: 1.25;
  color: #111827;
}

.orders-page .order-card-date {
  color: var(--text-tertiary);
  font-size: 25rpx;
}

.orders-page .badge {
  padding: 8rpx 18rpx;
  font-size: 24rpx;
}

.orders-mini-metric {
  padding: 18rpx 20rpx;
  margin-bottom: 0;
  border: 1rpx solid var(--hairline);
  border-radius: 18rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  box-shadow: 0 6rpx 16rpx rgba(15,23,42,0.05);
}

.orders-tool-btn {
  width: 100%;
  min-width: 0;
  min-height: 66rpx;
  border-radius: 14rpx;
  border: none;
  background: var(--surface-strong);
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 600;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.orders-tool-btn::after { border: none; }

.orders-tool-btn.success {
  background: rgba(52,199,89,0.13);
  color: #248A3D;
}

.orders-tool-btn.danger {
  color: #D92D20;
  background: rgba(255,59,48,0.09);
  border: none;
}

.orders-card-footer {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  padding-top: 18rpx;
}

.orders-detail-hint {
  color: #007AFF;
  font-size: 25rpx;
  font-weight: 600;
}

/* 三个操作按钮横向等宽一行，不再换行堆叠 */
.orders-actions {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.badge.tag-success { background: var(--green-100); color: var(--green-600); }
.badge.tag-danger  { background: var(--red-100); color: var(--red-600); }
.badge.tag-info    { background: var(--blue-100); color: var(--blue-600); }
.badge.tag-warning { background: var(--amber-100); color: var(--amber-600); }
