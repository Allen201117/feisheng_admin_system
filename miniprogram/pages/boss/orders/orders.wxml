<view class="container orders-page">

  <view class="page-header">
    <view class="page-header-left">
      <text class="page-header-title">订单管理</text>
      <text class="page-header-subtitle">跟踪订单进度与工序配置</text>
    </view>
    <button class="orders-create-btn {{showAddForm ? 'is-cancel' : ''}}" bindtap="toggleAddForm" hover-class="tap-button-hover">{{showAddForm ? '收起' : '新建'}}</button>
  </view>

  <view class="orders-summary card-bento">
    <view class="stats-grid">
      <view wx:for="{{statCards}}" wx:for-item="item" wx:key="key" class="stats-card tappable {{item.key === 'active' ? 'amber' : item.key === 'completed' ? 'green' : item.key === 'cancelled' ? 'red' : 'blue'}}" hover-class="tap-card-hover" hover-stay-time="80">
        <text class="stats-card-value">{{item.value}}</text>
        <text class="stats-card-label">{{item.label}}</text>
      </view>
    </view>
    <view class="filter-chips" style="margin-top:var(--sp-1);">
      <view wx:for="{{filterTabs}}" wx:for-item="item" wx:key="key" class="filter-chip {{activeFilter === item.key ? 'filter-chip-active' : ''}}" bindtap="onFilterChange" data-key="{{item.key}}" hover-class="tap-chip-hover">{{item.label}}</view>
    </view>
  </view>

  <view class="list-search-row">
    <input class="field-input list-search-input" placeholder="搜索订单名称、日期、状态" value="{{orderSearchKeyword}}" bindinput="onOrderSearchInput" confirm-type="search" />
    <view wx:if="{{orderSearchKeyword}}" class="btn-sm btn-sm-secondary list-search-clear tappable" bindtap="clearOrderSearch" hover-class="tap-button-hover">清除</view>
  </view>
  <text wx:if="{{orderSearchKeyword}}" class="list-search-meta">匹配 {{filteredOrders.length}} / {{orders.length}} 个订单</text>

  <!-- 新建订单表单 -->
  <view wx:if="{{showAddForm}}" class="card-bento">
    <text class="menu-group-title" style="margin-bottom:var(--sp-1);">新建订单</text>
    <view class="field-group">
      <text class="field-label">订单名称 *</text>
      <input class="field-input" placeholder="如：XX客户-T恤1000件" value="{{newOrder.order_name}}" bindinput="onInputOrderName" />
    </view>
    <view class="field-group">
      <text class="field-label">开始日期 *</text>
      <picker mode="date" value="{{newOrder.start_date}}" bindchange="onStartDateChange">
        <view class="picker-field" hover-class="tap-row-hover">
          <text>{{newOrder.start_date || '请选择日期'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
    <view class="field-group">
      <text class="field-label">截止日期</text>
      <picker mode="date" value="{{newOrder.end_date}}" bindchange="onEndDateChange">
        <view class="picker-field" hover-class="tap-row-hover">
          <text>{{newOrder.end_date || '请选择日期（可选）'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>
    <view class="field-group">
      <text class="field-label">总数量 *</text>
      <input class="field-input" type="number" placeholder="订单总件数" value="{{newOrder.total_quantity}}" bindinput="onInputQuantity" />
    </view>
    <button class="btn-primary btn-block" style="margin-top:var(--sp-1);" bindtap="onAddOrder" disabled="{{loading}}" hover-class="tap-button-hover">{{loading ? '创建中...' : '创建订单'}}</button>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{filteredOrders.length === 0 && !loading}}" class="empty">
    <view class="empty-icon">
      <image src="/images/icons/orders.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
    </view>
    <text class="empty-title">暂无订单</text>
    <text class="empty-desc">点击上方按钮创建新订单</text>
    <view class="empty-action secondary" bindtap="toggleAddForm" hover-class="tap-button-hover">新建订单</view>
  </view>

  <!-- 订单列表 -->
  <view wx:for="{{filteredOrders}}" wx:for-item="item" wx:key="_id" class="order-card tappable orders-card" bindtap="goOrderDetail" data-id="{{item._id}}" hover-class="tap-card-hover" hover-stay-time="80">
    <view class="order-card-head">
      <view class="flex-1">
        <text class="order-card-name">{{item.order_name}}</text>
        <text class="order-card-date">{{item.start_date}} ~ {{item.end_date || '未设置截止'}}</text>
      </view>
      <text class="badge {{item.status_class}}">{{item.status_text}}</text>
    </view>

    <view wx:if="{{item.end_date}}" style="margin-bottom:var(--sp-1);">
      <view class="flex-between" style="margin-bottom:6rpx;">
        <text class="text-secondary text-xs">时间进度</text>
        <text class="{{item.overdue ? 'text-red' : 'text-secondary'}} text-xs">{{item.days_left_text}}</text>
      </view>
      <view class="progress-bar">
        <view class="progress-bar-fill {{item.overdue ? 'red' : 'green'}}" style="width: {{item.timeline_progress}}%;"></view>
      </view>
    </view>

    <view class="flex-row gap-1" style="margin-bottom:var(--sp-1);">
      <view class="flex-1 card orders-mini-metric">
        <text class="text-tertiary text-xs">总数量</text>
        <text class="font-semibold text-primary text-sm">{{item.total_quantity}} 件</text>
      </view>
      <view class="flex-1 card orders-mini-metric">
        <text class="text-tertiary text-xs">工序数</text>
        <text class="font-semibold text-primary text-sm">{{item.process_count || 0}} 道</text>
      </view>
    </view>

    <view class="divider"></view>

    <view class="orders-card-footer">
      <text class="orders-detail-hint">点击卡片查看订单详情 ›</text>
      <view class="orders-actions" catchtap="stopPropagation">
        <button class="btn-sm btn-sm-ghost orders-tool-btn" bindtap="onChangeStatus" data-order="{{item}}" hover-class="tap-button-hover">状态</button>
        <button wx:if="{{item.status === 'active'}}" class="btn-sm btn-sm-success orders-tool-btn success" bindtap="onCompleteOrder" data-order="{{item}}" hover-class="tap-button-hover">完成</button>
        <button wx:if="{{item.status === 'completed'}}" class="btn-sm btn-sm-success orders-tool-btn success" bindtap="onReactivateOrder" data-order="{{item}}" hover-class="tap-button-hover">恢复</button>
        <button class="btn-sm btn-sm-outline orders-tool-btn danger" bindtap="onDeleteOrder" data-order="{{item}}" hover-class="tap-button-hover">删除</button>
      </view>
    </view>
  </view>

</view>
