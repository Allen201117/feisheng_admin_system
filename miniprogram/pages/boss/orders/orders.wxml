<!--pages/boss/orders/orders.wxml-->
<view class="container">
  <view class="hero-panel card">
    <view class="top-bar">
      <view>
        <text class="hero-title">订单管理</text>
        <text class="hero-subtitle">共 {{orders.length}} 个订单</text>
      </view>
      <button class="btn-primary add-btn" bindtap="toggleAddForm">
        {{showAddForm ? '取消' : '+ 新建订单'}}
      </button>
    </view>

    <view class="stat-grid">
      <view wx:for="{{statCards}}" wx:key="key" class="stat-item {{item.className}}">
        <text class="stat-value">{{item.value}}</text>
        <text class="stat-label">{{item.label}}</text>
      </view>
    </view>

    <view class="filter-tabs">
      <view
        wx:for="{{filterTabs}}"
        wx:key="key"
        class="filter-chip {{activeFilter === item.key ? 'filter-chip-active' : ''}}"
        bindtap="onFilterChange"
        data-key="{{item.key}}"
      >
        {{item.label}}
      </view>
    </view>
  </view>

  <view wx:if="{{showAddForm}}" class="card">
    <view class="section-title">新建订单</view>

    <view class="input-group">
      <text class="input-label">订单名称 *</text>
      <input
        class="input-field"
        placeholder="如：XX客户-T恤1000件"
        value="{{newOrder.order_name}}"
        bindinput="onInputOrderName"
      />
    </view>

    <view class="input-group">
      <text class="input-label">开始日期 *</text>
      <picker mode="date" value="{{newOrder.start_date}}" bindchange="onStartDateChange">
        <view class="picker-field">
          <text>{{newOrder.start_date || '请选择日期'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="input-group">
      <text class="input-label">截止日期</text>
      <picker mode="date" value="{{newOrder.end_date}}" bindchange="onEndDateChange">
        <view class="picker-field">
          <text>{{newOrder.end_date || '请选择日期（可选）'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="input-group">
      <text class="input-label">总数量 *</text>
      <input
        class="input-field"
        type="number"
        placeholder="订单总件数"
        value="{{newOrder.total_quantity}}"
        bindinput="onInputQuantity"
      />
    </view>

    <button class="btn-success btn-block mt-20" bindtap="onAddOrder">确认创建</button>
  </view>

  <view wx:if="{{filteredOrders.length === 0 && !loading}}" class="empty-state">
    <text class="empty-text">暂无订单</text>
  </view>

  <view
    wx:for="{{filteredOrders}}"
    wx:key="_id"
    class="card order-card"
    bindtap="goOrderDetail"
    data-id="{{item._id}}"
  >
    <view class="order-header">
      <view class="order-title-wrap">
        <text class="order-name">{{item.order_name}}</text>
        <text class="order-date">{{item.start_date}} ~ {{item.end_date || '未设置截止'}}</text>
      </view>
      <text class="tag {{item.status_class}}">{{item.status_text}}</text>
    </view>

    <view class="timeline-box" wx:if="{{item.end_date}}">
      <view class="timeline-header">
        <text class="timeline-label">时间进度</text>
        <text class="timeline-text {{item.overdue ? 'text-danger' : 'text-gray'}}">{{item.days_left_text}}</text>
      </view>
      <view class="timeline-track">
        <view class="timeline-fill {{item.overdue ? 'timeline-fill-overdue' : ''}}" style="width: {{item.timeline_progress}}%;"></view>
      </view>
    </view>

    <view class="order-body">
      <view class="metric-item">
        <text class="metric-label">总数量</text>
        <text class="metric-value">{{item.total_quantity}} 件</text>
      </view>
      <view class="metric-item">
        <text class="metric-label">工序数</text>
        <text class="metric-value">{{item.process_count || 0}} 道</text>
      </view>
    </view>

    <view class="order-footer">
      <text class="text-primary text-sm">点击卡片查看详情 / 管理工序</text>
      <view class="order-actions" catchtap="true">
        <button class="btn-sm btn-status" bindtap="onChangeStatus" data-order="{{item}}">改状态</button>
        <button wx:if="{{item.status === 'active'}}" class="btn-sm btn-complete" bindtap="onCompleteOrder" data-order="{{item}}">完成</button>
        <button class="btn-sm btn-delete" bindtap="onDeleteOrder" data-order="{{item}}">删除订单</button>
      </view>
    </view>
  </view>
</view>
