<view class="container" wx:if="{{salaryData}}">
  <!-- 薪资概览 -->
  <view class="card-bento hero-boss" style="color:#fff;">
    <text class="text-sm" style="color:rgba(255,255,255,0.7);">{{userName}} 本月应发工资</text>
    <text class="font-bold" style="font-size:var(--fs-2xl);color:#fff;margin-top:8rpx;display:block;">¥{{salaryData.finalSalary}}</text>
  </view>

  <!-- 薪资构成 -->
  <view class="card-bento">
    <text class="menu-group-title" style="margin-bottom:var(--sp-2);display:block;">薪资构成</text>
    <view class="list-row">
      <text class="list-row-title">计件工资</text>
      <text class="font-semibold">¥{{salaryData.baseSalary}}</text>
    </view>
    <view class="list-row">
      <text class="list-row-title">奖惩合计</text>
      <text class="font-semibold">¥{{salaryData.adjustmentTotal}}</text>
    </view>
    <view class="divider-thick"></view>
    <view class="list-row">
      <text class="list-row-title font-semibold text-primary">应发合计</text>
      <text class="font-bold text-red text-md">¥{{salaryData.finalSalary}}</text>
    </view>
  </view>

  <!-- 工作统计 -->
  <view class="card-bento">
    <text class="menu-group-title" style="margin-bottom:var(--sp-2);display:block;">工作统计</text>
    <view class="stats-grid">
      <view class="stats-card blue">
        <text class="stats-card-value">{{salaryData.monthlyHours}}h</text>
        <text class="stats-card-label">工时</text>
      </view>
      <view class="stats-card green">
        <text class="stats-card-value">{{salaryData.totalOutput}}</text>
        <text class="stats-card-label">总产出</text>
      </view>
      <view class="stats-card blue">
        <text class="stats-card-value">{{salaryData.totalPassed}}</text>
        <text class="stats-card-label">合格数</text>
      </view>
      <view class="stats-card amber">
        <text class="stats-card-value">{{salaryData.passRate}}%</text>
        <text class="stats-card-label">合格率(仅参考)</text>
      </view>
    </view>
  </view>

  <view class="card-bento">
    <view class="list-search-row">
      <input class="field-input list-search-input" placeholder="搜索订单、工序、日期、奖惩原因" value="{{salaryDetailSearchKeyword}}" bindinput="onSalaryDetailSearchInput" confirm-type="search" />
      <view wx:if="{{salaryDetailSearchKeyword}}" class="btn-sm btn-sm-secondary list-search-clear tappable" bindtap="clearSalaryDetailSearch" hover-class="tap-button-hover">清除</view>
    </view>
    <text wx:if="{{salaryDetailSearchKeyword}}" class="list-search-meta">奖惩 {{adjustments.length}} / {{rawAdjustments.length}}，报工 {{workLogs.length}} / {{rawWorkLogs.length}}</text>
  </view>

  <!-- 奖惩管理 -->
  <view class="card-bento">
    <view class="flex-between" style="margin-bottom:var(--sp-2);">
      <text class="menu-group-title">奖惩记录</text>
      <button class="btn-sm btn-sm-ghost" bindtap="toggleAddAdj">
        {{showAddAdj ? '取消' : '添加'}}
      </button>
    </view>

    <!-- 添加奖惩表单 -->
    <view wx:if="{{showAddAdj}}" class="card" style="margin-bottom:var(--sp-2);padding:var(--sp-2);">
      <view class="flex-row gap-1" style="margin-bottom:var(--sp-2);background:var(--bg-elevated);border-radius:var(--r-full);overflow:hidden;padding:6rpx;">
        <text class="tappable" style="flex:1;text-align:center;padding:var(--sp-1);font-size:var(--fs-sm);border-radius:var(--r-full);{{newAdj.isReward ? 'background:var(--green-600);color:#fff;' : 'color:var(--text-tertiary);'}}" bindtap="toggleAdjType">奖励</text>
        <text class="tappable" style="flex:1;text-align:center;padding:var(--sp-1);font-size:var(--fs-sm);border-radius:var(--r-full);{{!newAdj.isReward ? 'background:var(--red-600);color:#fff;' : 'color:var(--text-tertiary);'}}" bindtap="toggleAdjType">扣款</text>
      </view>
      <view class="field-group">
        <text class="field-label">金额（元）</text>
        <input class="field-input" type="digit" placeholder="请输入金额" value="{{newAdj.amount}}" bindinput="onAdjAmountInput" />
      </view>
      <view class="field-group">
        <text class="field-label">原因</text>
        <input class="field-input" placeholder="请输入奖惩原因" value="{{newAdj.reason}}" bindinput="onAdjReasonInput" />
      </view>
      <button class="btn-primary btn-block" bindtap="onSubmitAdj">确认提交</button>
    </view>

    <!-- 奖惩列表 -->
    <view wx:if="{{adjustments.length === 0 && !showAddAdj}}" class="empty" style="padding:var(--sp-3) 0;">
      <text class="text-tertiary text-xs">暂无奖惩记录</text>
    </view>
    <view wx:for="{{adjustments}}" wx:for-item="item" wx:key="_id" class="list-row flex-wrap">
      <view class="flex-1">
        <text class="list-row-title">{{item.reason}}</text>
        <text class="list-row-subtitle">{{item.date}}</text>
      </view>
      <view style="text-align:right;">
        <text class="font-semibold text-sm" style="{{item.type === 'reward' ? 'color:var(--green-600)' : 'color:var(--red-600)'}}">
          {{item.type === 'reward' ? '+' : '-'}}¥{{item.amount}}
        </text>
        <view class="flex-row gap-2" style="justify-content:flex-end;margin-top:8rpx;">
          <text class="text-accent tappable text-xs" bindtap="onEditAdj" data-adj="{{item}}">编辑</text>
          <text class="text-red tappable text-xs" bindtap="onDeleteAdj" data-adj="{{item}}">删除</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 报工记录 -->
  <view class="card-bento">
    <text class="menu-group-title" style="margin-bottom:var(--sp-2);display:block;">本月报工记录</text>
    <view wx:if="{{workLogs.length === 0}}" class="empty" style="padding:var(--sp-3) 0;">
      <text class="text-tertiary text-xs">暂无报工记录</text>
    </view>
    <view wx:for="{{workLogs}}" wx:for-item="item" wx:key="_id" class="list-row flex-wrap">
      <view class="flex-1">
        <text class="list-row-title">{{item.process_name}}</text>
        <text class="list-row-subtitle">{{item.order_name}} | {{item.date}}</text>
        <text class="list-row-subtitle">结算价 <text class="price-strong">¥{{item.snapshot_price}}</text><text wx:if="{{item.price_changed}}"> · 当前价 <text class="price-strong">¥{{item.current_price}}</text></text></text>
      </view>
      <view style="text-align:right;">
        <text class="list-row-subtitle">{{item.quantity}}件</text>
        <text wx:if="{{item.status === 'inspected'}}" class="list-row-subtitle"> (合格{{item.passed_qty}})</text>
        <text class="font-bold text-amber text-sm" style="display:block;">¥{{item.amount_display}}</text>
        <button wx:if="{{!item.is_locked}}" class="btn-sm btn-sm-ghost" bindtap="onEditWorkLog" data-log="{{item}}">编辑</button>
        <text wx:if="{{item.is_locked}}" class="text-tertiary text-xs">
          <image src="/images/icons/lock.svg" mode="aspectFit" style="width:28rpx;height:28rpx;vertical-align:middle;" /> 已锁定</text>
      </view>
    </view>
  </view>
</view>

<!-- 编辑报工弹窗 -->
<view wx:if="{{showEditWorkLog}}" class="modal-overlay" bindtap="closeEditWorkLog">
  <view class="modal-sheet" catchtap="true">
    <text class="modal-sheet-title">修改报工记录</text>
    <view class="modal-sheet-body" style="text-align:left;">
      <view class="card" style="margin-bottom:var(--sp-2);padding:var(--sp-2);">
        <text class="text-secondary text-xs">员工：{{userName}} | 工序：{{editWL.process_name}} | 日期：{{editWL.date}}</text>
      </view>
      <view class="field-group">
        <text class="field-label">报工数量</text>
        <input class="field-input" type="number" value="{{editWLQuantity}}" bindinput="onEditWLQtyInput" />
      </view>
      <view class="field-group">
        <text class="field-label">备注</text>
        <input class="field-input" placeholder="可选" value="{{editWLNote}}" bindinput="onEditWLNoteInput" />
      </view>
      <view class="field-group">
        <text class="field-label">修改原因 *</text>
        <picker mode="selector" range="{{editWLReasons}}" value="{{editWLReasonIndex}}" bindchange="onEditWLReasonChange">
          <view class="picker-field">
            <text wx:if="{{editWLReasonIndex >= 0}}">{{editWLReasons[editWLReasonIndex]}}</text>
            <text wx:else class="text-secondary">请选择原因</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view wx:if="{{editWLReasonIndex === 4}}" class="field-group">
        <text class="field-label">详细原因</text>
        <input class="field-input" placeholder="请输入具体原因" value="{{editWLReason}}" bindinput="onEditWLReasonCustom" />
      </view>
    </view>
    <view class="modal-sheet-footer">
      <button class="modal-sheet-btn" bindtap="closeEditWorkLog">取消</button>
      <button class="modal-sheet-btn" bindtap="onSaveEditWorkLog">保存</button>
    </view>
  </view>
</view>

<!-- 编辑奖惩弹窗 -->
<view wx:if="{{showEditAdj}}" class="modal-overlay" bindtap="closeEditAdj">
  <view class="modal-sheet" catchtap="true">
    <text class="modal-sheet-title">修改奖惩记录</text>
    <view class="modal-sheet-body" style="text-align:left;">
      <view class="card" style="margin-bottom:var(--sp-2);padding:var(--sp-2);">
        <text class="text-secondary text-xs">类型：{{editAdj.type === 'reward' ? '奖励' : '处罚'}}
        <text wx:if="{{isPaidLocked}}" class="text-red">（已发薪，将通过冲正修改）</text></text>
      </view>
      <view class="field-group">
        <text class="field-label">金额（元）</text>
        <input class="field-input" type="digit" value="{{editAdjAmount}}" bindinput="onEditAdjAmountInput" />
      </view>
      <view class="field-group">
        <text class="field-label">原因</text>
        <input class="field-input" value="{{editAdjReason}}" bindinput="onEditAdjReasonInput" />
      </view>
      <view class="field-group">
        <text class="field-label">修改原因 *</text>
        <input class="field-input" placeholder="请输入修改原因" value="{{editAdjEditReason}}" bindinput="onEditAdjEditReasonInput" />
      </view>
    </view>
    <view class="modal-sheet-footer">
      <button class="modal-sheet-btn" bindtap="closeEditAdj">取消</button>
      <button class="modal-sheet-btn" bindtap="onSaveEditAdj">保存</button>
    </view>
  </view>
</view>
