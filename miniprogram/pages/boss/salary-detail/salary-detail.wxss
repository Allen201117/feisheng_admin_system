/* pages/boss/salary-detail/salary-detail.wxss */
.container {
  background:
    radial-gradient(circle at 10% 8%, rgba(142, 183, 223, 0.16) 0%, transparent 24%),
    radial-gradient(circle at 88% 10%, rgba(205, 216, 228, 0.18) 0%, transparent 24%),
    linear-gradient(180deg, #eef3f7 0%, #f8fbfd 100%);
}

.card {
  border: 2rpx solid #e8eef8;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgba(17, 38, 84, 0.08);
}

.detail-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2f8;
  font-size: 34rpx;
}

.total-row {
  border-top: 2rpx solid #e5edf8;
  border-bottom: none;
  padding-top: 20rpx;
  margin-top: 10rpx;
}

.stats-grid {
  display: flex;
  justify-content: space-around;
  flex-wrap: wrap;
  gap: 12rpx;
  text-align: center;
}

.stat-box {
  flex: 1 1 140rpx;
  padding: 16rpx;
}

.stat-box-val {
  font-size: 40rpx;
  font-weight: 700;
  color: #135ea8;
  display: block;
}

.stat-box-lbl {
  font-size: 28rpx;
  color: #666;
}

.btn-sm {
  font-size: 28rpx;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: none;
  min-height: 0;
  line-height: 1.8;
  background: #FFF7E6;
  color: #FA8C16;
}

.btn-sm::after { border: none; }

.btn-add-adj {
  background: #ebf4ff;
  color: #175bb0;
}

.salary-detail-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14rpx;
}

.adj-form {
  background: #fbfcff;
  border-radius: 18rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #edf2fa;
}

.adj-type-toggle {
  display: flex;
  margin-bottom: 20rpx;
  background: #f4f8ff;
  border-radius: 999rpx;
  overflow: hidden;
  border: 2rpx solid #d8e4f3;
  padding: 6rpx;
}

.adj-type {
  flex: 1;
  text-align: center;
  padding: 16rpx;
  font-size: 32rpx;
  color: #6b7f97;
  border-radius: 999rpx;
}

.adj-reward-active {
  background: #52C41A;
  color: #fff;
  border-radius: 8rpx;
}

.adj-punish-active {
  background: #FF4D4F;
  color: #fff;
  border-radius: 8rpx;
}

.adj-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.adj-item:last-child { border-bottom: none; }

.adj-reason {
  font-size: 32rpx;
  display: block;
  word-break: break-all;
}

.adj-date { display: block; margin-top: 4rpx; }

.adj-amount {
  font-size: 36rpx;
  font-weight: 700;
}

.work-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 14rpx;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.work-item:last-child { border-bottom: none; }

.work-process {
  font-size: 32rpx;
  font-weight: 700;
  display: block;
  color: #1f3554;
}

.work-detail {
  text-align: right;
  flex-shrink: 0;
}

.work-amount {
  font-size: 32rpx;
  color: #c45a25;
  font-weight: 700;
  display: block;
}

.adj-right {
  text-align: right;
  flex-shrink: 0;
}

.adj-btns {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 8rpx;
  justify-content: flex-end;
}

.adj-edit-btn {
  font-size: 26rpx;
  color: #1890FF;
}

.adj-del-btn {
  font-size: 26rpx;
  color: #FF4D4F;
}

.btn-edit-wl {
  font-size: 26rpx;
  padding: 6rpx 20rpx;
  background: #ebf4ff;
  color: #175bb0;
  border: none;
  border-radius: 8rpx;
  min-height: 0;
  line-height: 1.8;
  margin-top: 8rpx;
}
.btn-edit-wl::after { border: none; }

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}
.modal-dialog {
  background: #fff;
  width: 85%;
  max-width: calc(100vw - 56rpx);
  border-radius: 24rpx;
  padding: 40rpx;
  max-height: 80vh;
  overflow-y: auto;
  border: 2rpx solid #e6edf5;
  box-shadow: 0 18rpx 36rpx rgba(17, 38, 84, 0.16);
}
.modal-title {
  font-size: 40rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 30rpx;
}
.modal-body {
  margin-bottom: 30rpx;
}
.modal-footer {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.modal-btn {
  flex: 1;
  font-size: 34rpx;
}

.edit-info {
  background: #fbfcff;
  padding: 16rpx;
  border-radius: 8rpx;
  border: 2rpx solid #edf2fa;
}

.picker-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  border: 2rpx solid #d8e4f3;
  border-radius: 12rpx;
  padding: 0 24rpx;
  background: #fff;
  font-size: 34rpx;
}

.picker-arrow {
  font-size: 28rpx;
  color: #666;
}
