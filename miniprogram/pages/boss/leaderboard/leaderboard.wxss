/* pages/boss/leaderboard/leaderboard.wxss */
.container {
  background:
    radial-gradient(circle at 20% 0%, #f0f9ff 0%, transparent 34%),
    radial-gradient(circle at 90% 10%, #fff3e8 0%, transparent 30%),
    #f7f8fb;
}

.board-header {
  text-align: center;
  padding: 20rpx 24rpx 24rpx;
  border-radius: 18rpx;
  border: 2rpx solid #e8eef8;
  background: linear-gradient(145deg, #ffffff 0%, #f8fbff 100%);
  margin-bottom: 18rpx;
}

.board-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f3554;
}

/* 周期 Tabs */
.period-tabs {
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 2rpx solid #d8e4f3;
  box-shadow: 0 8rpx 20rpx rgba(17, 38, 84, 0.06);
  padding: 8rpx;
}

.dim-tabs {
  display: flex;
  background: #fff;
  border-radius: 999rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  border: 2rpx solid #d8e4f3;
  padding: 8rpx;
}

.tabs .tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 30rpx;
  color: #4f6584;
  position: relative;
  transition: all 0.3s;
  border-radius: 999rpx;
}

.tab-active {
  color: #0b62b4;
  font-weight: 700;
  background: #e8f4ff;
}

.tab-active::after {
  display: none;
}

.dim-active {
  background: #e8f4ff;
  color: #0b62b4 !important;
  border-radius: 999rpx;
}

.dim-active::after {
  display: none;
}

/* picker 卡片 */
.picker-card {
  padding: 16rpx 24rpx;
  margin-bottom: 20rpx;
  border: 2rpx solid #e8eef8;
}

.picker-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 80rpx;
  font-size: 34rpx;
  color: #333;
}

.picker-arrow {
  font-size: 28rpx;
  color: #666;
}

/* 排行卡片 */
.rank-card {
  padding: 24rpx;
  border: 2rpx solid #e8eef8;
}

.rank-summary {
  margin-bottom: 16rpx;
  text-align: right;
}

.rank-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #edf2f8;
}

.rank-item:last-child { border-bottom: none; }

.rank-num {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: bold;
  color: #666;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.rank-top {
  background: #FFF7E6;
  color: #FA8C16;
}

.rank-top-1 { background: #FFD700; color: #fff; }
.rank-top-2 { background: #C0C0C0; color: #fff; }
.rank-top-3 { background: #CD7F32; color: #fff; }

.rank-info {
  flex: 1;
  min-width: 0;
}

.rank-name {
  font-size: 36rpx;
  font-weight: 700;
  display: block;
  color: #1f3554;
}

.rank-sub {
  display: block;
  margin-top: 4rpx;
}

.rank-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890FF;
  margin-right: 12rpx;
  flex-shrink: 0;
}

.rank-medal {
  font-size: 36rpx;
  flex-shrink: 0;
}

/* 空状态 & loading */
.empty-state {
  padding: 60rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 32rpx;
  color: #666;
}

.loading-mask {
  text-align: center;
  padding: 40rpx 0;
}

.loading-text {
  font-size: 32rpx;
  color: #666;
}