<view class="container">
  <view class="page-header">
    <view class="page-header-left">
      <text class="page-header-title">排行榜</text>
    </view>
    <image src="/images/icons/leaderboard.svg" mode="aspectFit" style="width:44rpx;height:44rpx;" />
  </view>

  <view class="card-bento">
    <view class="list-row">
      <view class="flex-1">
        <text class="list-row-title">公开给员工</text>
        <text class="list-row-subtitle">关闭时员工只看自己的名次，开启后员工可看完整排行榜</text>
      </view>
      <switch checked="{{leaderboard_visible}}" data-field="leaderboard_visible" bindchange="onLeaderboardVisibleChange" disabled="{{visibilitySaving}}" color="#2563EB" />
    </view>
  </view>

  <!-- 周期 Tabs -->
  <view class="tab-bar">
    <view wx:for="{{periodTabs}}" wx:for-item="item" wx:key="key"
      class="tab-item {{periodTab === item.key ? 'tab-item-active' : ''}}"
      bindtap="switchPeriod" data-key="{{item.key}}">
      {{item.label}}
    </view>
  </view>

  <!-- 月份选择（月维度时显示） -->
  <view wx:if="{{periodTab === 'monthly'}}" class="card-bento">
    <picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange">
      <view class="picker-field">
        <text>{{monthDisplay}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 年份选择（年维度时显示） -->
  <view wx:if="{{periodTab === 'yearly'}}" class="card-bento">
    <picker range="{{['2026','2025','2024','2023','2022','2021']}}" value="0" bindchange="onYearChange">
      <view class="picker-field">
        <text>{{yearDisplay}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 订单选择（订单维度时显示） -->
  <view wx:if="{{periodTab === 'order'}}" class="card-bento">
    <picker range="{{orderNames}}" value="{{selectedOrderIdx}}" bindchange="onOrderChange">
      <view class="picker-field">
        <text>{{orderNames[selectedOrderIdx] || '请选择订单'}}</text>
        <text class="picker-arrow">▼</text>
      </view>
    </picker>
  </view>

  <!-- 维度 Tabs -->
  <view class="tab-bar">
    <view wx:for="{{dimTabs}}" wx:for-item="item" wx:key="key"
      class="tab-item {{dimTab === item.key ? 'tab-item-active' : ''}}"
      bindtap="switchDim" data-key="{{item.key}}">
      {{item.label}}
    </view>
  </view>

  <!-- 排行列表 -->
  <view class="card-bento">
    <view class="flex-between" style="margin-bottom:var(--sp-2);">
      <text class="text-secondary text-xs">共 {{totalEmployees}} 名员工</text>
    </view>

    <view class="list-search-row">
      <input class="field-input list-search-input" placeholder="搜索员工姓名" value="{{rankSearchKeyword}}" bindinput="onRankSearchInput" confirm-type="search" />
      <view wx:if="{{rankSearchKeyword}}" class="btn-sm btn-sm-secondary list-search-clear tappable" bindtap="clearRankSearch" hover-class="tap-button-hover">清除</view>
    </view>
    <text wx:if="{{rankSearchKeyword}}" class="list-search-meta">匹配 {{rankList.length}} / {{rawRankList.length}} 名员工</text>

    <view wx:if="{{rankList.length === 0 && !loading}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/leaderboard.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
      </view>
      <text class="empty-title">暂无数据</text>
      <text class="empty-desc">暂无排行数据</text>
    </view>

    <view wx:for="{{rankList}}" wx:for-item="item" wx:key="user_id" class="list-row">
      <view style="width:56rpx;height:56rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:var(--fs-base);font-weight:var(--fw-bold);{{item.rank <= 3 ? 'background:' + (item.rank === 1 ? '#FFD700' : item.rank === 2 ? '#C0C0C0' : '#CD7F32') + ';color:#fff;' : 'background:var(--bg-elevated);color:var(--text-tertiary);'}}">
        {{item.rank}}
      </view>
      <view class="flex-1">
        <text class="list-row-title">{{item.user_name}}</text>
        <text wx:if="{{item.displaySub}}" class="list-row-subtitle">{{item.displaySub}}</text>
      </view>
      <view class="list-row-extra font-semibold text-primary">{{item.displayValue}}</view>
    </view>
  </view>

  <view wx:if="{{loading}}" class="flex-center" style="padding:var(--sp-5);">
    <text class="text-secondary text-xs">加载中...</text>
  </view>
</view>
