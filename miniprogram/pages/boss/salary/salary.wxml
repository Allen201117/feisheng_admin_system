<view class="container">

  <!-- 顶部：请假提醒入口（红点） -->
  <view class="salary-topbar">
    <text class="page-header-title">薪资管理</text>
    <view class="leave-remind tappable" bindtap="goLeaveRecords" hover-class="tap-button-hover">
      <image src="/images/icons/attendance.svg" mode="aspectFit" style="width:34rpx;height:34rpx;" />
      <text class="leave-remind-text">请假提醒</text>
      <text wx:if="{{leaveUnread > 0}}" class="leave-remind-badge">{{leaveUnread}}</text>
    </view>
  </view>

  <!-- 月份 / 订单切换 -->
  <scroll-view scroll-x class="month-scroll" wx:if="{{payrollMode === 'monthly' && availableMonths.length > 0}}">
    <view class="month-pills">
      <view wx:for="{{availableMonths}}" wx:key="*this" class="month-pill {{selectedMonthIndex === index ? 'month-pill-active' : ''}}" bindtap="onMonthTap" data-idx="{{index}}">{{monthLabels[index]}}</view>
    </view>
  </scroll-view>

  <scroll-view scroll-x class="month-scroll" wx:if="{{payrollMode === 'order' && orders.length > 0}}">
    <view class="month-pills">
      <view wx:for="{{orders}}" wx:key="_id" class="month-pill {{selectedOrderIndex === index ? 'month-pill-active' : ''}}" bindtap="onOrderTap" data-idx="{{index}}">{{orderLabels[index]}}</view>
    </view>
  </scroll-view>

  <!-- 统计卡片 -->
  <view class="stat-card accent-blue">
    <text class="stat-card-label">{{payrollMode === 'order' ? '订单' : ''}}{{currentMonth}} 薪资总支出</text>
    <text class="stat-card-value">¥{{totalSalary}}</text>
    <text class="stat-card-footer">已发 {{paidCount}}/{{employees.length}} 人</text>
  </view>

  <!-- 员工薪资列表 -->
  <view class="card-bento">
    <text class="menu-group-title" style="margin-bottom:var(--sp-1);">员工薪资明细</text>

    <view class="list-search-row">
      <input class="field-input list-search-input" placeholder="搜索员工姓名" value="{{salarySearchKeyword}}" bindinput="onSalarySearchInput" confirm-type="search" />
      <view wx:if="{{salarySearchKeyword}}" class="btn-sm btn-sm-secondary list-search-clear tappable" bindtap="clearSalarySearch" hover-class="tap-button-hover">清除</view>
    </view>
    <text wx:if="{{salarySearchKeyword}}" class="list-search-meta">匹配 {{filteredEmployees.length}} / {{employees.length}} 人</text>

    <view wx:if="{{employees.length === 0}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/salary.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
      </view>
      <text class="empty-title">暂无薪资数据</text>
      <text class="empty-desc">{{payrollMode === 'order' ? '选择订单查看薪资明细' : '选择月份查看薪资明细'}}</text>
    </view>
    <view wx:elif="{{filteredEmployees.length === 0}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/salary.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
      </view>
      <text class="empty-title">没有匹配的员工</text>
      <text class="empty-desc">换个员工姓名、金额或发放状态再试</text>
    </view>

    <view wx:for="{{filteredEmployees}}" wx:for-item="item" wx:key="user_id" class="salary-row">
      <view class="salary-check {{item.paid ? 'done' : ''}}" catchtap="onTogglePaid" data-id="{{item.user_id}}" data-name="{{item.user_name}}" data-idx="{{item._sourceIndex}}">
        <text wx:if="{{item.paid}}">✓</text>
      </view>
      <view class="salary-info tappable" bindtap="goDetail" data-id="{{item.user_id}}" data-name="{{item.user_name}}">
        <view class="flex-row gap-1">
          <text class="salary-name">{{item.user_name}}</text>
          <text class="badge {{item.attendFull ? 'badge-solid-green' : 'badge-solid-red'}}">{{item.attendBadgeText}}</text>
          <text class="badge {{item.paid ? 'badge-green' : 'badge-slate'}}">{{item.paid ? '已发' : '未发'}}</text>
        </view>
        <text class="salary-detail">计件: ¥{{item.baseSalary}} | 奖惩: ¥{{item.adjustmentTotal}}</text>
      </view>
      <view class="salary-amount tappable" bindtap="goDetail" data-id="{{item.user_id}}" data-name="{{item.user_name}}">¥{{item.finalSalary}}
        <text class="text-accent text-xs" style="display:block;margin-top:2rpx;">详情 →</text>
      </view>
    </view>
  </view>

</view>
