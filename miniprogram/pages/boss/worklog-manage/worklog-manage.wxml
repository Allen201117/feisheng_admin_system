<view class="container worklog-manage-page">
  <!-- 主Tab：进度总览 / 报工明细 -->
  <view class="tab-bar">
    <view class="tab-item {{mainTab === 'progress' ? 'tab-item-active' : ''}}" bindtap="switchMainTab" data-tab="progress">进度总览</view>
    <view class="tab-item {{mainTab === 'detail' ? 'tab-item-active' : ''}}" bindtap="switchMainTab" data-tab="detail">报工明细</view>
  </view>

  <!-- ========== 进度总览 ========== -->
  <block wx:if="{{mainTab === 'progress'}}">
    <view class="card-bento">
      <view class="field-group">
        <text class="field-label">选择订单</text>
        <picker mode="selector" range="{{orders}}" range-key="display" value="{{progressOrderIndex}}" bindchange="onProgressOrderChange">
          <view class="picker-field">
            <text wx:if="{{progressOrder}}">{{progressOrder.display}}</text>
            <text wx:else class="text-secondary">请选择订单</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
    </view>

    <block wx:if="{{progressData}}">
      <!-- 整体进度卡片 -->
      <view class="worklog-progress-card">
        <view class="worklog-progress-head">
          <text class="worklog-progress-title">{{progressData.order_name}}</text>
        </view>
        <view class="worklog-stat-row">
          <view class="worklog-stat-cell">
            <text class="worklog-stat-value">{{progressData.overall_reported}}</text>
            <text class="worklog-stat-label">已报工件数</text>
          </view>
          <view class="worklog-stat-cell">
            <text class="worklog-stat-value">{{progressData.total_quantity}}</text>
            <text class="worklog-stat-label">订单总量</text>
          </view>
          <view class="worklog-stat-cell">
            <text class="worklog-stat-value">{{progressData.overall_percent}}%</text>
            <text class="worklog-stat-label">整体完成</text>
          </view>
        </view>
        <view class="progress-bar worklog-overall-bar">
          <view class="progress-bar-fill {{progressData.overall_percent >= 100 ? 'green' : ''}}" style="width: {{progressData.overall_percent}}%;"></view>
        </view>
      </view>

      <!-- 各工序进度 -->
      <view class="card-bento" wx:if="{{progressData.processes.length > 0}}">
        <view class="flex-between" style="margin-bottom:var(--sp-2);">
          <text class="font-semibold text-sm">工序进度明细</text>
          <text wx:if="{{progressProcessKeyword}}" class="field-hint process-search-meta">匹配 {{filteredProgressProcesses.length}} / {{progressData.processes.length}}</text>
        </view>
        <view class="process-search-row">
          <input class="field-input process-search-input" placeholder="搜索工序名称" value="{{progressProcessKeyword}}" bindinput="onProgressProcessSearchInput" confirm-type="search" />
          <view wx:if="{{progressProcessKeyword}}" class="btn-sm btn-sm-secondary process-search-clear tappable" bindtap="clearProgressProcessSearch" hover-class="tap-button-hover">清除</view>
        </view>
        <view wx:if="{{filteredProgressProcesses.length === 0}}" class="empty" style="padding:60rpx 0;">
          <view class="empty-icon">
            <image src="/images/icons/worklog.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
          </view>
          <text class="empty-title">没有匹配的工序</text>
        </view>
        <view wx:for="{{filteredProgressProcesses}}" wx:for-item="item" wx:key="_id" class="worklog-process-card tappable" bindtap="goProcessWorklogs" data-process="{{item}}" hover-class="tap-card-hover">
          <view class="worklog-process-head">
            <text class="worklog-process-name">{{item.process_name}}</text>
            <text class="worklog-price-pill" wx:if="{{item.current_price != null}}">¥{{item.current_price}}/件</text>
          </view>
          <view class="progress-bar">
            <view class="progress-bar-fill {{item.progress_percent >= 100 ? 'green' : ''}}" style="width: {{item.progress_percent}}%;"></view>
          </view>
          <view class="worklog-process-meta">
            <text class="worklog-process-progress">{{item.total_reported}} / {{progressData.total_quantity}} 件 ({{item.progress_percent}}%)</text>
            <text class="worklog-process-people">{{item.employee_count}} 人参与 · 分配 {{item.assigned_count}} 人</text>
          </view>
          <text class="worklog-process-link">查看明细</text>
        </view>
      </view>

      <view wx:if="{{progressData.processes.length === 0}}" class="empty">
        <view class="empty-icon">
          <image src="/images/icons/worklog.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
        </view>
        <text class="empty-title">暂无工序</text>
        <text class="empty-desc">该订单暂无工序</text>
      </view>
    </block>

    <view wx:if="{{!progressData && !loading && progressOrder}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/worklog.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
      </view>
      <text class="empty-title">暂无数据</text>
      <text class="empty-desc">暂无进度数据</text>
    </view>
    <view wx:if="{{!progressOrder && !loading}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/worklog.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
      </view>
      <text class="empty-title">选择订单</text>
      <text class="empty-desc">请先选择一个订单</text>
    </view>
  </block>

  <!-- ========== 工序报工明细 ========== -->
  <block wx:if="{{mainTab === 'process'}}">
    <view class="card-bento">
      <view class="worklog-detail-head">
        <view class="flex-1">
          <text class="font-semibold text-primary text-md">{{processDetail.process_name}}</text>
          <text class="text-secondary text-xs" style="margin-top:4rpx;display:block;">{{processDetail.order_name}} · 该工序下所有报工明细</text>
        </view>
        <view class="worklog-add-btn tappable" bindtap="openAddWorkLog" hover-class="tap-button-hover">新增</view>
      </view>
    </view>

    <view class="card-bento">
      <view class="stats-grid">
        <view class="stats-card blue">
          <text class="stats-card-value text-accent">{{summary.count}}</text>
          <text class="stats-card-label">报工条数</text>
        </view>
        <view class="stats-card green">
          <text class="stats-card-value text-green">{{summary.quantity}}</text>
          <text class="stats-card-label">报工总件数</text>
        </view>
        <view class="stats-card amber">
          <text class="stats-card-value text-red">¥{{summary.amount}}</text>
          <text class="stats-card-label">报工总金额</text>
        </view>
      </view>
    </view>

    <view wx:if="{{groupedLogs.length === 0 && !loading}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/worklog.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
      </view>
      <text class="empty-title">暂无报工记录</text>
      <text class="empty-desc">该工序暂无报工记录</text>
    </view>

    <view wx:for="{{groupedLogs}}" wx:for-item="group" wx:key="date" class="card-bento">
      <view class="flex-between" style="margin-bottom:var(--sp-2);padding-bottom:var(--sp-2);border-bottom:1rpx solid var(--border);">
        <text class="font-semibold text-sm">{{group.date}}</text>
        <text class="text-secondary text-xs">{{group.dayQty}}件 · ¥{{group.dayAmount}}</text>
      </view>

      <view wx:for="{{group.items}}" wx:for-item="item" wx:key="_id" class="list-row flex-wrap">
        <view class="flex-1">
          <view class="flex-row gap-1" style="margin-bottom:6rpx;">
            <text class="list-row-title">{{item.user_name || '未知员工'}}</text>
            <text class="badge {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <text class="list-row-subtitle">数量：{{item.quantity || 0}}件  金额：¥{{item.amountDisplay}}</text>
          <text class="list-row-subtitle">结算价 <text class="price-strong">¥{{item.snapshot_price}}</text><text wx:if="{{item.price_changed}}"> · 当前价 <text class="price-strong">¥{{item.current_price}}</text></text></text>
          <text class="list-row-subtitle">备注：{{item.note || '无'}}</text>
        </view>
        <view class="worklog-log-actions">
          <view class="worklog-log-action primary" bindtap="onEditWorkLog" data-log="{{item}}" hover-class="tap-button-hover">编辑</view>
          <view class="worklog-log-action danger" bindtap="onDeleteLog" data-log="{{item}}" hover-class="tap-button-hover">删除</view>
        </view>
      </view>
    </view>
  </block>

  <!-- ========== 报工明细（原有功能） ========== -->
  <block wx:if="{{mainTab === 'detail'}}">
    <view class="card-bento">
      <text class="font-semibold text-md" style="display:block;">报工明细</text>
      <text class="text-secondary text-xs" style="margin-bottom:var(--sp-2);display:block;">按日、按月、按订单查看全员报工记录</text>

      <view class="filter-chips" style="margin-bottom:var(--sp-2);">
        <view class="filter-chip {{viewType === 'day' ? 'filter-chip-active' : ''}}" bindtap="switchViewType" data-type="day">按日</view>
        <view class="filter-chip {{viewType === 'month' ? 'filter-chip-active' : ''}}" bindtap="switchViewType" data-type="month">按月</view>
        <view class="filter-chip {{viewType === 'order' ? 'filter-chip-active' : ''}}" bindtap="switchViewType" data-type="order">按订单</view>
      </view>

      <view wx:if="{{viewType === 'day'}}" class="field-group">
        <text class="field-label">选择日期</text>
        <picker mode="date" value="{{dayDate}}" bindchange="onDayChange">
          <view class="picker-field">
            <text>{{dayDate}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view wx:if="{{viewType === 'month'}}" class="field-group">
        <text class="field-label">选择月份</text>
        <picker mode="date" fields="month" value="{{monthDate}}" bindchange="onMonthChange">
          <view class="picker-field">
            <text>{{monthDate}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <block wx:if="{{viewType === 'order'}}">
        <view class="field-group">
          <text class="field-label">选择订单</text>
          <picker mode="selector" range="{{orders}}" range-key="display" value="{{orderIndex}}" bindchange="onOrderChange">
            <view class="picker-field">
              <text wx:if="{{selectedOrder}}">{{selectedOrder.display}}</text>
              <text wx:else class="text-secondary">请选择订单</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
        <view class="field-group">
          <text class="field-label">限定月份（可快速筛选）</text>
          <picker mode="date" fields="month" value="{{orderMonth}}" bindchange="onOrderMonthChange">
            <view class="picker-field">
              <text>{{orderMonth}}</text>
              <text class="picker-arrow">▼</text>
            </view>
          </picker>
        </view>
      </block>
    </view>

    <view class="card-bento">
      <view class="stats-grid">
        <view class="stats-card blue">
          <text class="stats-card-value text-accent">{{summary.count}}</text>
          <text class="stats-card-label">报工条数</text>
        </view>
        <view class="stats-card green">
          <text class="stats-card-value text-green">{{summary.quantity}}</text>
          <text class="stats-card-label">报工总件数</text>
        </view>
        <view class="stats-card amber">
          <text class="stats-card-value text-red">¥{{summary.amount}}</text>
          <text class="stats-card-label">报工总金额</text>
        </view>
      </view>
    </view>

    <view wx:if="{{groupedLogs.length === 0 && !loading}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/worklog.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
      </view>
      <text class="empty-title">暂无报工记录</text>
      <text class="empty-desc">当前条件下暂无报工记录</text>
    </view>

    <view wx:for="{{groupedLogs}}" wx:for-item="group" wx:key="date" class="card-bento">
      <view class="flex-between" style="margin-bottom:var(--sp-2);padding-bottom:var(--sp-2);border-bottom:1rpx solid var(--border);">
        <text class="font-semibold text-sm">{{group.date}}</text>
        <text class="text-secondary text-xs">{{group.dayQty}}件 · ¥{{group.dayAmount}}</text>
      </view>

      <view wx:for="{{group.items}}" wx:for-item="item" wx:key="_id" class="list-row flex-wrap">
        <view class="flex-1">
          <view class="flex-row gap-1" style="margin-bottom:6rpx;">
            <text class="list-row-title">{{item.user_name || '未知员工'}}</text>
            <text class="badge {{item.statusClass}}">{{item.statusText}}</text>
          </view>
          <text class="list-row-subtitle">{{item.order_name || '未知订单'}} · {{item.process_name || '未知工序'}}</text>
          <text class="list-row-subtitle">数量：{{item.quantity || 0}}件  金额：¥{{item.amountDisplay}}</text>
          <text class="list-row-subtitle">结算价 <text class="price-strong">¥{{item.snapshot_price}}</text><text wx:if="{{item.price_changed}}"> · 当前价 <text class="price-strong">¥{{item.current_price}}</text></text></text>
        </view>
        <view class="worklog-log-actions">
          <view class="worklog-log-action primary" bindtap="onEditWorkLog" data-log="{{item}}" hover-class="tap-button-hover">编辑</view>
          <view class="worklog-log-action danger" bindtap="onDeleteLog" data-log="{{item}}" hover-class="tap-button-hover">删除</view>
        </view>
      </view>
    </view>
  </block>

  <view wx:if="{{loading}}" class="flex-center" style="padding:var(--sp-5);">
    <text class="text-secondary text-xs">加载中...</text>
  </view>
</view>

<!-- 新增报工弹窗 -->
<view wx:if="{{showAddWorkLog}}" class="modal-overlay" bindtap="closeAddWorkLog">
  <view class="modal-sheet" catchtap="stopBubble">
    <text class="modal-sheet-title">新增报工记录</text>
    <view class="modal-sheet-body" style="text-align:left;">
      <view class="card" style="margin-bottom:var(--sp-2);padding:var(--sp-2);">
        <text class="text-secondary text-xs">订单：{{processDetail.order_name}}｜工序：{{processDetail.process_name}}</text>
      </view>
      <view class="field-group">
        <text class="field-label">选择员工</text>
        <picker mode="selector" range="{{processEmployees}}" range-key="name" value="{{processEmployeeIndex}}" bindchange="onAddEmployeeChange">
          <view class="picker-field">
            <text wx:if="{{selectedProcessEmployee}}">{{selectedProcessEmployee.name}}</text>
            <text wx:else class="text-secondary">请选择员工</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view class="field-group">
        <text class="field-label">报工数量</text>
        <input class="field-input" type="number" value="{{addWLQuantity > 0 ? addWLQuantity : ''}}" bindinput="onAddWLQtyInput" placeholder="请输入完成数量" />
      </view>
      <view class="field-group">
        <text class="field-label">备注</text>
        <input class="field-input" placeholder="可选，例如老板代报" value="{{addWLNote}}" bindinput="onAddWLNoteInput" />
      </view>
    </view>
    <view class="modal-sheet-footer">
      <button class="modal-sheet-btn" bindtap="closeAddWorkLog">取消</button>
      <button class="modal-sheet-btn" bindtap="onSubmitAddWorkLog">保存新增</button>
    </view>
  </view>
</view>

<!-- 编辑报工弹窗 -->
<view wx:if="{{showEditWorkLog}}" class="modal-overlay" bindtap="closeEditWorkLog">
  <view class="modal-sheet" catchtap="stopBubble">
    <text class="modal-sheet-title">修改报工记录</text>
    <view class="modal-sheet-body" style="text-align:left;">
      <view class="card" style="margin-bottom:var(--sp-2);padding:var(--sp-2);">
        <text class="text-secondary text-xs">员工：{{editWL.user_name || '未知'}}｜工序：{{editWL.process_name || '未知'}}｜日期：{{editWL.date || ''}}</text>
      </view>
      <view class="field-group">
        <text class="field-label">报工数量</text>
        <input class="field-input" type="number" value="{{editWLQuantity}}" bindinput="onEditWLQtyInput" />
      </view>
      <view class="field-group">
        <text class="field-label">备注</text>
        <input class="field-input" placeholder="可选" value="{{editWLNote}}" bindinput="onEditWLNoteInput" />
      </view>
      <view class="field-group">
        <text class="field-label">修改原因 *</text>
        <picker mode="selector" range="{{editWLReasons}}" value="{{editWLReasonIndex}}" bindchange="onEditWLReasonChange">
          <view class="picker-field">
            <text wx:if="{{editWLReasonIndex >= 0}}">{{editWLReasons[editWLReasonIndex]}}</text>
            <text wx:else class="text-secondary">请选择原因</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
      <view wx:if="{{editWLReasonIndex === 4}}" class="field-group">
        <text class="field-label">详细原因</text>
        <input class="field-input" placeholder="请输入具体原因" value="{{editWLReason}}" bindinput="onEditWLReasonCustom" />
      </view>
    </view>
    <view class="modal-sheet-footer">
      <button class="modal-sheet-btn" bindtap="closeEditWorkLog">取消</button>
      <button class="modal-sheet-btn" bindtap="onSaveEditWorkLog">保存</button>
    </view>
  </view>
</view>
