/* pages/boss/worklog-manage/worklog-manage.wxss */
.container {
  background:
    radial-gradient(circle at 10% 8%, rgba(142, 183, 223, 0.16) 0%, transparent 24%),
    radial-gradient(circle at 88% 12%, rgba(205, 216, 228, 0.18) 0%, transparent 24%),
    linear-gradient(180deg, #eef3f7 0%, #f8fbfd 100%);
}

.hero-panel {
  margin-bottom: 22rpx;
  background: linear-gradient(145deg, #ffffff 0%, #fbfdff 100%);
  border: 2rpx solid #dde6ef;
  border-radius: 24rpx;
}

.hero-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #132544;
  margin-bottom: 6rpx;
}

.hero-subtitle {
  display: block;
  margin-bottom: 18rpx;
  font-size: 28rpx;
  color: #6d7e95;
}

.filter-tabs {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.filter-tab {
  flex: 1 1 180rpx;
  text-align: center;
  min-height: 76rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.filter-chip {
  border-radius: 999rpx;
  border: 2rpx solid #d8e4f3;
  font-size: 30rpx;
  color: #4e6483;
  background: #fff;
  padding: 8rpx 0;
}

.filter-tab-active {
  border-color: #1890ff;
  background: #e8f4ff;
  color: #0b62b4;
  font-weight: bold;
}

.summary-card {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12rpx;
  border: 2rpx solid #e8eef8;
  border-radius: 24rpx;
}

.summary-item {
  flex: 1 1 180rpx;
  text-align: center;
  background: #fbfcff;
  border: 2rpx solid #edf2fa;
  border-radius: 14rpx;
  padding: 22rpx 10rpx;
}

.summary-value {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
  line-height: 1.2;
}

.summary-label {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #556677;
}

.day-card {
  padding: 24rpx;
  border: 2rpx solid #edf1f8;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 24rpx rgba(17, 38, 84, 0.06);
}

.day-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 14rpx;
  padding-bottom: 14rpx;
  border-bottom: 1rpx solid #ecf1f8;
}

.day-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #1f3554;
}

.day-sub {
  font-size: 28rpx;
  color: #6b7f97;
}

.log-row {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  justify-content: space-between;
  gap: 16rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f2f5fa;
}

.log-row:last-child {
  border-bottom: none;
}

.log-main {
  flex: 1;
  min-width: 0;
}

.log-title-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.log-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #25415d;
}

.log-sub {
  display: block;
  font-size: 30rpx;
  color: #5e738f;
  line-height: 1.5;
}

.btn-sm {
  padding: 0 20rpx !important;
  min-height: 78rpx;
  height: 78rpx;
  line-height: 78rpx;
  font-size: 30rpx;
  border-radius: 12rpx;
  white-space: normal;
  width: 100%;
}

/* ===== 主Tab栏 ===== */
.main-tab-bar {
  display: flex;
  gap: 0;
  padding: 8rpx;
  background: #edf2fa;
  border-radius: 16rpx;
}
.main-tab {
  flex: 1;
  text-align: center;
  font-size: 32rpx;
  padding: 18rpx 0;
  border-radius: 12rpx;
  color: #5e738f;
  font-weight: 500;
}
.main-tab-active {
  background: #fff;
  color: #1890ff;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.12);
}

/* ===== 进度总览 ===== */
.overall-card {
  background: linear-gradient(145deg, #1b304f 0%, #2a4a70 100%);
  border: none;
  color: #fff;
}
.overall-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}
.overall-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
}
.overall-stat {
  text-align: center;
}
.overall-num {
  display: block;
  font-size: 48rpx;
  font-weight: bold;
}
.overall-percent {
  color: #5bdf83;
}
.overall-label {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-top: 4rpx;
}

/* 进度条 */
.progress-track {
  height: 20rpx;
  background: #e8eef8;
  border-radius: 10rpx;
  overflow: hidden;
}
.progress-track-lg {
  height: 28rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 14rpx;
}
.progress-fill {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, #1890ff 0%, #52c41a 100%);
  transition: width 0.3s ease;
}
.progress-fill-done {
  background: linear-gradient(90deg, #52c41a 0%, #389e0d 100%);
}

/* 工序进度卡片 */
.progress-card {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f4fa;
}
.progress-card:last-child {
  border-bottom: none;
}
.progress-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.progress-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f3554;
}
.progress-price {
  font-size: 30rpx;
  color: #fa541c;
  font-weight: bold;
}
.progress-meta {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  flex-wrap: wrap;
  gap: 8rpx;
}
.progress-qty {
  font-size: 28rpx;
  color: #1890ff;
  font-weight: 500;
}
.progress-people {
  font-size: 26rpx;
  color: #556677;
}
