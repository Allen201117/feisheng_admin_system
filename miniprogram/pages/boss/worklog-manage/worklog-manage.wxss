.container { padding-bottom: 60rpx; }

.worklog-manage-page {
  background: #F5F5F7;
}

.worklog-manage-page .card-bento {
  border-radius: 28rpx;
  border: 1rpx solid rgba(229,229,234,0.86);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.035);
}

.worklog-progress-card {
  padding: 30rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(229,229,234,0.86);
  box-shadow: 0 2rpx 8rpx rgba(15,23,42,0.035);
  margin-bottom: 24rpx;
}

.worklog-progress-head {
  margin-bottom: 22rpx;
}

.worklog-progress-title {
  display: block;
  font-size: 40rpx;
  line-height: 1.22;
  font-weight: 700;
  color: #1D1D1F;
}

.worklog-stat-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
}

.worklog-stat-cell {
  min-height: 116rpx;
  padding: 18rpx 12rpx;
  border-radius: 20rpx;
  background: #F8FAFC;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  box-sizing: border-box;
}

.worklog-stat-value {
  display: block;
  font-size: 34rpx;
  line-height: 1.1;
  font-weight: 700;
  color: #1D1D1F;
  font-variant-numeric: tabular-nums;
}

.worklog-stat-label {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.35;
  color: #8A8F98;
}

.worklog-overall-bar {
  margin-top: 22rpx;
}

.worklog-process-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(229,229,234,0.86);
  margin-bottom: 16rpx;
}

.worklog-process-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.worklog-process-name {
  flex: 1;
  min-width: 0;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1D1D1F;
}

.worklog-price-pill {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #F5F8FF;
  color: #007AFF;
  font-size: 24rpx;
  font-weight: 700;
}

.worklog-process-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 12rpx;
}

.worklog-process-progress,
.worklog-process-people {
  font-size: 24rpx;
  line-height: 1.35;
}

.worklog-process-progress {
  color: #007AFF;
  font-weight: 600;
}

.worklog-process-people {
  color: #8A8F98;
  text-align: right;
}

.worklog-process-link {
  display: inline-flex;
  margin-top: 12rpx;
  min-height: 48rpx;
  align-items: center;
  color: #007AFF;
  font-size: 25rpx;
  font-weight: 650;
}

.worklog-detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.worklog-add-btn {
  flex-shrink: 0;
  min-width: 104rpx;
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #007AFF;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 650;
}

.worklog-log-actions {
  width: 100%;
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 16rpx;
}

.worklog-log-action {
  min-width: 92rpx;
  min-height: 56rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #F2F4F7;
  color: #475467;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 650;
}

.worklog-log-action.primary {
  background: rgba(0,122,255,0.12);
  color: #007AFF;
}

.worklog-log-action.danger {
  background: rgba(255,59,48,0.09);
  color: #D92D20;
}

.badge.tag-success { background: var(--green-100); color: var(--green-600); }
.badge.tag-pending { background: var(--amber-100); color: var(--amber-600); }
.badge.tag-danger  { background: var(--red-100); color: var(--red-600); }
.badge.tag-info    { background: var(--blue-100); color: var(--blue-600); }
