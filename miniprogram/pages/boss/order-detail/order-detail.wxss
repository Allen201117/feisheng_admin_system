.container { padding-bottom: 60rpx; }

.order-detail-page {
  background: var(--bg-page);
}

.order-detail-page .card-bento {
  border-radius: 28rpx;
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-card);
}

.order-hero-card {
  padding: 30rpx;
}

.order-hero-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.order-title-wrap {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: center;
  gap: 14rpx;
  flex-wrap: wrap;
}

.order-title {
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #1D1D1F;
}

.order-more-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: var(--surface-strong);
  color: var(--text-tertiary);
  font-size: 36rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.order-progress-strip {
  padding: 18rpx 22rpx;
  border-radius: 22rpx;
  background: #F5F8FF;
  border: 1rpx solid rgba(0,122,255,0.10);
  margin-bottom: 18rpx;
}

.order-progress-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.order-progress-label,
.order-progress-days {
  font-size: 25rpx;
  line-height: 1.4;
}

.order-progress-bar {
  margin-top: 12rpx;
  width: 100%;
}

.order-meta-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.order-meta-card {
  min-width: 0;
  padding: 18rpx 16rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: 0 6rpx 16rpx rgba(15,23,42,0.05);
}

.order-meta-label {
  display: block;
  font-size: 24rpx;
  line-height: 1.35;
  color: var(--text-tertiary);
}

.order-meta-value {
  display: block;
  margin-top: 8rpx;
  font-size: 29rpx;
  line-height: 1.25;
  font-weight: 700;
  color: #1D1D1F;
  word-break: break-all;
}

.order-setting-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 22rpx;
  border-radius: 22rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: 0 6rpx 16rpx rgba(15,23,42,0.05);
}

.order-setting-copy {
  flex: 1;
  min-width: 0;
}

.order-setting-title {
  display: block;
  font-size: 29rpx;
  line-height: 1.35;
  font-weight: 650;
  color: #1D1D1F;
}

.order-setting-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--text-tertiary);
}

.order-action-panel {
  margin-top: 18rpx;
}

.order-action-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
}

.order-action-item {
  min-height: 92rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: var(--surface-strong);
  border: 1rpx solid var(--hairline);
  box-sizing: border-box;
}

.order-action-title {
  display: block;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 650;
  color: #1D1D1F;
}

.order-action-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 23rpx;
  line-height: 1.35;
  color: var(--text-tertiary);
}

.order-danger-list {
  margin-top: 12rpx;
  border-radius: 20rpx;
  overflow: hidden;
  border: 1rpx solid rgba(229,229,234,0.76);
  background: #FFFFFF;
}

.order-danger-row {
  min-height: 76rpx;
  padding: 0 22rpx;
  display: flex;
  align-items: center;
  border-bottom: 1rpx solid #F0F0F2;
  font-size: 27rpx;
  font-weight: 600;
  color: #D92D20;
}

.order-danger-row:last-child {
  border-bottom: none;
}

.order-danger-row.amber {
  color: #C87500;
}

.order-assignment-summary {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 12rpx;
  margin-bottom: 18rpx;
}

.order-assignment-cell {
  min-height: 118rpx;
  padding: 18rpx 12rpx;
  border-radius: 20rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  text-align: center;
  box-sizing: border-box;
}

.order-assignment-cell.warning {
  background: #FFF7ED;
}

.order-filter-tabs {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  padding: 6rpx;
  border-radius: 22rpx;
  background: var(--surface-strong);
  border: 1rpx solid var(--hairline);
}

.order-filter-tab {
  min-height: 60rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: var(--text-secondary);
  font-size: 27rpx;
  font-weight: 600;
}

.order-filter-tab.is-active {
  background: #FFFFFF;
  color: #1D1D1F;
  box-shadow: 0 6rpx 16rpx rgba(15,23,42,0.12);
}

.order-filter-count {
  min-width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: #FFE5E5;
  color: #D92D20;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}

.order-add-process-btn {
  min-width: 104rpx;
  min-height: 58rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #007AFF;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 650;
}

.order-add-process-btn.is-cancel {
  background: var(--surface-strong);
  color: var(--text-secondary);
}

.process-search-row {
  display: flex;
  align-items: center;
  gap: var(--sp-1);
  margin-bottom: 10rpx;
}

.process-search-input {
  flex: 1;
  min-width: 0;
  height: 88rpx;
  font-size: var(--fs-sm);
}

.process-search-clear {
  flex-shrink: 0;
  min-width: 96rpx;
}

.process-search-meta {
  margin: -2rpx 0 var(--sp-1);
}

.process-item-card {
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-card);
  margin-bottom: 16rpx;
}

.process-item-card.is-unassigned {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFFCFC 100%);
}

.process-item-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.process-item-main {
  flex: 1;
  min-width: 0;
}

.process-item-name {
  display: block;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1D1D1F;
}

.process-item-note {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--text-tertiary);
}

.process-price-pill {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: var(--green-50);
  color: var(--green-600);
  font-size: 28rpx;
  font-weight: 700;
}

.process-price-pill.muted {
  background: var(--surface-strong);
  color: var(--text-tertiary);
}

.process-assign-state {
  margin: 18rpx 0;
}

.process-inline-link {
  min-height: 52rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #007AFF;
  color: #FFFFFF;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 650;
}

.process-action-row {
  display: grid;
  grid-template-columns: 1.1fr 1fr 1fr;
  gap: 10rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid var(--hairline);
}

.process-action-btn {
  min-height: 58rpx;
  border-radius: 999rpx;
  background: var(--surface-strong);
  color: var(--text-primary);
  font-size: 25rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.process-action-btn.primary {
  background: rgba(0,122,255,0.12);
  color: #007AFF;
}

.process-action-btn.danger {
  background: rgba(255,59,48,0.09);
  color: #D92D20;
}

.badge.tag-success { background: var(--green-100); color: var(--green-600); }
.badge.tag-danger  { background: var(--red-100); color: var(--red-600); }
.badge.tag-info    { background: var(--blue-100); color: var(--blue-600); }
.badge.tag-warning { background: var(--amber-100); color: var(--amber-600); }

.assign-panel {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: var(--bg-page);
  z-index: 2000;
  display: flex;
  flex-direction: column;
}

.assign-topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--bg-card);
  padding: var(--sp-2);
  padding-top: calc(var(--sp-2) + env(safe-area-inset-top));
  border-bottom: 1rpx solid var(--border);
}

.assign-topbar-btn { font-size: var(--fs-base); color: var(--blue-600); }
.assign-topbar-title { font-size: var(--fs-base); font-weight: var(--fw-bold); color: var(--text-primary); text-align: center; flex: 1; min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.assign-process-area { background: var(--bg-card); padding: var(--sp-2); border-bottom: 1rpx solid var(--border); }
.assign-process-scroll { white-space: nowrap; }
.assign-process-chips { display: inline-flex; gap: var(--sp-1); padding: 4rpx 0; }

.assign-process-chip {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  min-width: 180rpx;
  max-width: 240rpx;
  padding: var(--sp-1);
  border-radius: var(--r-sm);
  border: 2rpx solid var(--border);
  background: var(--bg-elevated);
  white-space: normal;
  vertical-align: top;
}

.assign-process-chip-active { border-color: var(--blue-600); background: var(--blue-50); }
.assign-chip-more { justify-content: center; border-style: dashed; }

.apc-mark {
  position: absolute; top: 6rpx; right: 6rpx;
  padding: 2rpx 10rpx; border-radius: var(--r-full);
  background: var(--blue-600); color: #fff;
  font-size: 20rpx; line-height: 1.35; font-weight: var(--fw-bold);
}

.apc-name { font-size: var(--fs-xs); font-weight: var(--fw-semibold); color: var(--text-primary); text-align: center; word-break: break-all; white-space: normal; }
.apc-count { font-size: var(--fs-xs); color: var(--text-tertiary); margin-top: 4rpx; }
.apc-tags { display: flex; flex-wrap: wrap; justify-content: center; gap: 4rpx; margin-top: 6rpx; }
.apc-tag-item { font-size: var(--fs-xs); background: var(--blue-50); color: var(--blue-600); padding: 2rpx 10rpx; border-radius: 4rpx; }
.apc-tag-more { background: var(--bg-elevated); color: var(--text-tertiary); }

.assign-current-hdr {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: var(--sp-1);
  padding: var(--sp-2);
  background: var(--bg-card);
  border-bottom: 1rpx solid var(--border);
}

.assign-clear-btn { flex-shrink: 0; font-size: var(--fs-xs); color: var(--red-600); }

.assign-list-scroll { flex: 1; overflow-y: auto; padding: var(--sp-2); }

.assign-card-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sp-1); }

.assign-emp-card {
  background: var(--bg-card);
  border-radius: var(--r-sm);
  padding: var(--sp-1);
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
  border: 2rpx solid var(--border);
}

.assign-emp-card:active { opacity: 0.8; }
.assign-emp-card-selected { background: var(--green-50); border-color: var(--green-600); }

.assign-card-check {
  position: absolute;
  top: var(--sp-1); right: var(--sp-1);
  width: 44rpx; height: 44rpx;
  border-radius: 50%;
  background: var(--green-600);
  display: flex; align-items: center; justify-content: center;
  font-size: var(--fs-xs); color: #fff; font-weight: var(--fw-bold);
}

.assign-card-avatar {
  width: 72rpx; height: 72rpx;
  border-radius: 50%;
  background: var(--blue-50);
  display: flex; align-items: center; justify-content: center;
  margin-bottom: var(--sp-1);
  font-size: var(--fs-base); font-weight: var(--fw-bold);
  color: var(--blue-600);
}

.assign-emp-card-selected .assign-card-avatar { background: var(--green-50); color: var(--green-600); }

.assign-card-name { font-size: var(--fs-sm); color: var(--text-primary); font-weight: var(--fw-semibold); text-align: center; }
.assign-card-role { font-size: var(--fs-xs); color: var(--text-tertiary); margin-top: 4rpx; }

.assign-bottombar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: var(--sp-1);
  background: var(--bg-card);
  padding: var(--sp-2);
  border-top: 1rpx solid var(--border);
}

.assign-bottom-btn {
  font-size: var(--fs-base);
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--r-sm);
  color: var(--text-tertiary);
  border: 2rpx solid var(--border);
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  background: var(--bg-card);
  line-height: 1.5;
}

.assign-bottom-btn::after { border: none; }

.assign-bottom-btn-primary {
  font-size: var(--fs-base);
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--r-sm);
  background: var(--blue-600);
  color: #fff;
  font-weight: var(--fw-bold);
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 88rpx;
  border: none;
  line-height: 1.5;
  box-shadow: var(--shadow-blue);
}

.assign-bottom-btn-primary::after { border: none; }

.ps-cell {
  flex: 0 0 auto;
  padding: var(--sp-1);
  border: 1rpx solid var(--border);
  font-size: var(--fs-xs);
  display: flex;
  align-items: center;
  box-sizing: border-box;
  word-break: break-all;
  line-height: 1.4;
}

.ps-cell-idx   { flex: 0 0 90rpx; justify-content: center; }
.ps-cell-name  { flex: 1 0 200rpx; }
.ps-cell-price { flex: 0 0 180rpx; justify-content: flex-end; }
.ps-cell-note  { flex: 1 0 200rpx; }
