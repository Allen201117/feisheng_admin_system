<view class="container order-detail-page" wx:if="{{order}}">

  <!-- ========== 区块1：订单概览 ========== -->
  <view class="card-bento order-hero-card">
    <view class="order-hero-head">
      <view class="order-title-wrap">
        <text class="order-title">{{order.order_name}}</text>
        <text class="badge {{order.status_class}}">{{order.status_text}}</text>
      </view>
      <view class="order-more-btn tappable" bindtap="onMoreAction" hover-class="tap-button-hover">⋯</view>
    </view>

    <view wx:if="{{order.end_date}}" class="order-progress-strip">
      <view class="order-progress-meta">
        <text class="order-progress-label">时间进度</text>
        <text class="{{order.overdue ? 'text-red' : 'text-secondary'}} order-progress-days">{{order.days_left_text}}</text>
      </view>
      <view class="progress-bar order-progress-bar">
        <view class="progress-bar-fill {{order.overdue ? 'red' : 'green'}}" style="width: {{order.timeline_progress}}%;"></view>
      </view>
    </view>

    <view class="order-meta-grid">
      <view class="order-meta-card">
        <text class="order-meta-label">总数量</text>
        <text class="order-meta-value">{{order.total_quantity}} 件</text>
      </view>
      <view class="order-meta-card">
        <text class="order-meta-label">开始日期</text>
        <text class="order-meta-value">{{order.start_date}}</text>
      </view>
      <view class="order-meta-card">
        <text class="order-meta-label">截止日期</text>
        <text class="order-meta-value">{{order.end_date || '未设定'}}</text>
      </view>
    </view>

    <!-- 工价隐藏开关 -->
    <view class="order-setting-row">
      <view class="order-setting-copy">
        <text class="order-setting-title">工价隐藏</text>
        <text class="order-setting-desc">开启后，员工将无法查看该订单相关工价信息</text>
      </view>
      <switch checked="{{order.price_hidden}}" bindchange="onTogglePriceHidden" color="#34C759" />
    </view>

    <!-- 工价管理操作 -->
    <view class="order-action-panel">
      <view class="order-action-grid">
        <view class="order-action-item tappable" bindtap="onShowPriceHistory" hover-class="tap-row-hover">
          <text class="order-action-title">工价记录</text>
          <text class="order-action-desc">查看变更历史</text>
        </view>
        <view class="order-action-item tappable" bindtap="onShowProcessSummary" hover-class="tap-row-hover">
          <text class="order-action-title">工序汇总</text>
          <text class="order-action-desc">预览并导出</text>
        </view>
      </view>
      <view class="order-danger-list" wx:if="{{order.status === 'active'}}">
        <view class="order-danger-row tappable" bindtap="onClearAllPrices" hover-class="tap-row-hover">清空所有工价</view>
        <view class="order-danger-row amber tappable" bindtap="onClearOrderWorklogs" hover-class="tap-row-hover">清空报工记录</view>
      </view>
    </view>
  </view>

  <!-- ========== 区块2：工序分配概览 ========== -->
  <view class="card-bento">
    <view class="flex-between" style="margin-bottom:var(--sp-1);">
      <text class="font-bold text-sm">工序分配概览</text>
      <text class="text-secondary text-xs">共 {{processes.length}} 道工序</text>
    </view>

    <view class="order-assignment-summary">
      <view class="order-assignment-cell">
        <text class="stats-card-value text-md">{{processes.length}}</text>
        <text class="stats-card-label">工序总数</text>
      </view>
      <view class="order-assignment-cell">
        <text class="stats-card-value text-green text-md">{{assignedCount}}</text>
        <text class="stats-card-label">已分配</text>
      </view>
      <view class="order-assignment-cell warning">
        <text class="stats-card-value text-red text-md">{{unassignedCount}}</text>
        <text class="stats-card-label">未分配</text>
      </view>
    </view>

    <view class="order-filter-tabs">
      <view class="order-filter-tab {{processFilter === 'all' ? 'is-active' : ''}}" bindtap="onProcessFilter" data-filter="all" hover-class="tap-chip-hover">全部</view>
      <view class="order-filter-tab {{processFilter === 'unassigned' ? 'is-active' : ''}}" bindtap="onProcessFilter" data-filter="unassigned" hover-class="tap-chip-hover">未分配<text class="order-filter-count" wx:if="{{unassignedCount > 0}}">{{unassignedCount}}</text></view>
      <view class="order-filter-tab {{processFilter === 'assigned' ? 'is-active' : ''}}" bindtap="onProcessFilter" data-filter="assigned" hover-class="tap-chip-hover">已分配</view>
    </view>
  </view>

  <!-- ========== 区块3：工序列表 ========== -->
  <view class="card-bento">
    <view class="flex-between" style="margin-bottom:var(--sp-1);">
      <text class="font-bold text-sm">工序列表</text>
      <view class="order-add-process-btn tappable {{showAddProcess ? 'is-cancel' : ''}}" bindtap="toggleAddProcess" wx:if="{{order.status === 'active'}}" hover-class="tap-button-hover">{{showAddProcess ? '收起' : '添加'}}</view>
    </view>

    <view class="process-search-row">
      <input class="field-input process-search-input" placeholder="搜索工序名称" value="{{processSearchKeyword}}" bindinput="onProcessSearchInput" confirm-type="search" />
      <view wx:if="{{processSearchKeyword}}" class="btn-sm btn-sm-secondary process-search-clear tappable" bindtap="clearProcessSearch" hover-class="tap-button-hover">清除</view>
    </view>
    <view wx:if="{{processSearchKeyword}}" class="field-hint process-search-meta">匹配 {{filteredProcesses.length}} / {{processes.length}} 道工序</view>

    <!-- 添加工序表单 -->
    <view wx:if="{{showAddProcess}}" class="card" style="margin-bottom:var(--sp-1);padding:var(--sp-2);">
      <view class="field-group">
        <text class="field-label">工序名称 *</text>
        <input class="field-input" placeholder="如：裁剪、缝制、包装" value="{{newProcess.process_name}}" bindinput="onInputProcessName" />
      </view>
      <view class="field-group">
        <text class="field-label">单价（元/件）*</text>
        <input class="field-input" type="digit" placeholder="如：1.50" value="{{newProcess.current_price}}" bindinput="onInputProcessPrice" />
      </view>
      <button class="btn-primary btn-block" bindtap="onAddProcess" hover-class="tap-button-hover">添加工序</button>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{filteredProcesses.length === 0 && !showAddProcess}}" class="empty">
      <view class="empty-icon">
        <image src="/images/icons/worklog.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
      </view>
      <text class="empty-title">{{processSearchKeyword ? '没有匹配的工序' : (processFilter === 'all' ? '暂无工序' : (processFilter === 'unassigned' ? '没有未分配的工序' : '没有已分配的工序'))}}</text>
    </view>

    <!-- 工序列表 -->
    <view wx:for="{{displayedProcesses}}" wx:for-item="item" wx:key="_id" class="process-item-card {{item.assigned_user_ids.length === 0 ? 'is-unassigned' : 'is-assigned'}}">
      <view class="process-item-head">
        <view class="process-item-main">
          <text class="process-item-name">{{item.process_name}}</text>
          <text class="process-item-note" wx:if="{{item.note}}">{{item.note}}</text>
        </view>
        <text wx:if="{{item.current_price != null}}" class="process-price-pill">¥{{item.current_price}}/件</text>
        <text wx:else class="process-price-pill muted">未设置</text>
      </view>

      <!-- 分配展示 -->
      <view class="process-assign-state">
        <view wx:if="{{item.assigned_user_ids.length > 0}}" class="flex-row flex-wrap gap-1">
          <text class="badge badge-green">已分配 {{item.assigned_user_ids.length}} 人</text>
          <view class="flex-row flex-wrap gap-1">
            <view wx:for="{{item._assignedNames}}" wx:for-item="aname" wx:key="*this" class="badge badge-green" style="border-radius:6rpx;padding:4rpx 12rpx;">{{aname}}</view>
          </view>
        </view>
        <view wx:else class="flex-row gap-1 flex-wrap">
          <text class="badge badge-red">未分配</text>
          <view class="process-inline-link" bindtap="showAssignPanel" data-id="{{item._id}}" data-process-id="{{item._id}}" wx:if="{{order.status === 'active'}}" hover-class="tap-chip-hover">去分配</view>
        </view>
      </view>

      <view class="process-action-row" wx:if="{{order.status === 'active'}}">
        <view class="process-action-btn primary" bindtap="showAssignPanel" data-id="{{item._id}}" data-process-id="{{item._id}}" hover-class="tap-button-hover">分配</view>
        <view class="process-action-btn" bindtap="onEditProcess" data-process="{{item}}" hover-class="tap-button-hover">编辑</view>
        <view class="process-action-btn danger" bindtap="onDeleteProcess" data-process="{{item}}" hover-class="tap-button-hover">删除</view>
      </view>
    </view>

    <view wx:if="{{hasMoreProcesses}}" class="card tappable flex-center" style="min-height:88rpx;padding:var(--sp-1);" bindtap="loadMoreProcesses">
      <text class="text-accent font-medium text-xs">已显示 {{displayedProcesses.length}} / {{filteredProcesses.length}} 道工序，点击加载更多</text>
    </view>
  </view>

  <!-- ========== 双栏分配面板 ========== -->
  <view wx:if="{{showAssign}}" class="assign-panel">
    <view class="assign-topbar">
      <text class="assign-topbar-btn" bindtap="hideAssign">取消</text>
      <text class="assign-topbar-title">工序分配</text>
      <view style="width:80rpx;"></view>
    </view>

    <view class="assign-process-area">
      <text class="text-secondary text-xs" style="margin-bottom:var(--sp-1);display:block;">选择工序（点击切换）</text>
      <scroll-view scroll-x class="assign-process-scroll" scroll-into-view="{{activeAssignProcessIntoView}}">
        <view class="assign-process-chips">
          <view wx:for="{{displayedAssignProcesses}}" wx:for-item="item" wx:key="_id" wx:for-index="pindex" id="assignProcess{{pindex}}" class="assign-process-chip {{activeAssignProcessId === item._id ? 'assign-process-chip-active' : ''}}" bindtap="onSelectAssignProcess" data-id="{{item._id}}" data-process-id="{{item._id}}" data-index="{{pindex}}">
            <text wx:if="{{activeAssignProcessId === item._id}}" class="apc-mark">当前</text>
            <text class="apc-name">{{item.process_name}}</text>
            <text class="apc-count">{{item._assignedCount}} 人</text>
            <view class="apc-tags" wx:if="{{item._assignedCount > 0}}">
              <text wx:for="{{item._assignedNames}}" wx:for-item="aname" wx:key="*this" class="apc-tag-item">{{aname}}</text>
              <text wx:if="{{item._assignedCount > 5}}" class="apc-tag-item apc-tag-more">+{{item._assignedCount - 5}}</text>
            </view>
          </view>
          <view wx:if="{{hasMoreAssignProcesses}}" class="assign-process-chip assign-chip-more" bindtap="loadMoreAssignProcesses">
            <text class="apc-name">加载更多</text>
            <text class="apc-count">{{displayedAssignProcesses.length}}/{{processes.length}} 道</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <view class="assign-current-hdr" wx:if="{{activeAssignProcessId}}">
      <view class="flex-1">
        <text class="font-medium text-sm">当前工序：{{activeAssignProcessName}}</text>
        <text class="text-secondary text-xs" style="display:block;margin-top:2rpx;">已选 {{assignMap[activeAssignProcessId].length}} 人</text>
      </view>
      <text class="assign-clear-btn" bindtap="clearAssignment">清空</text>
    </view>

    <scroll-view scroll-y class="assign-list-scroll">
      <view class="assign-card-grid">
        <view wx:for="{{allEmployees}}" wx:for-item="item" wx:key="_id" class="assign-emp-card {{_currentProcessUserIds.indexOf(item._id) >= 0 ? 'assign-emp-card-selected' : ''}}" bindtap="toggleAssignUser" data-id="{{item._id}}" bindlongpress="onLongPressEmployee" data-id="{{item._id}}">
          <view class="assign-card-check" wx:if="{{_currentProcessUserIds.indexOf(item._id) >= 0}}">✓</view>
          <view class="assign-card-avatar">{{item.name[0] || ''}}</view>
          <text class="assign-card-name">{{item.name}}</text>
          <text class="assign-card-role">{{item.role === 'qc' ? '质检员' : '员工'}}</text>
        </view>
      </view>
      <view wx:if="{{allEmployees.length === 0}}" class="empty" style="padding:60rpx 0;">
        <text class="empty-title">暂无可分配的员工</text>
      </view>
    </scroll-view>

    <view class="assign-bottombar safe-bottom">
      <text class="font-bold text-sm">{{_currentProcessUserIds.length}} 人已选</text>
      <view class="flex-row gap-1" style="width:100%;">
        <button class="assign-bottom-btn" bindtap="hideAssign">取消</button>
        <button class="assign-bottom-btn-primary" bindtap="onConfirmAssign">保存分配</button>
      </view>
    </view>
  </view>

  <!-- 员工已分配工序弹窗 -->
  <view wx:if="{{showEmpProcesses}}">
    <view class="modal-overlay" bindtap="closeEmpProcesses">
      <view class="modal-sheet" catchtap style="max-height:60vh;">
        <view class="flex-between" style="padding:var(--sp-2) var(--sp-2) 0;">
          <text class="font-bold text-sm flex-1">{{empProcessesName}} 的已分配工序</text>
          <text class="btn-sm btn-ghost" bindtap="closeEmpProcesses">关闭</text>
        </view>
        <view class="modal-sheet-body">
          <view wx:for="{{empProcessesList}}" wx:for-item="item" wx:key="*this" class="list-row">
            <text class="list-row-title">{{item}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 工价变更记录面板 ========== -->
  <view wx:if="{{showPriceHistory}}" class="assign-panel">
    <view class="assign-topbar">
      <text class="assign-topbar-btn" bindtap="hidePriceHistory">关闭</text>
      <text class="assign-topbar-title">工价变更记录</text>
      <view style="width:80rpx;"></view>
    </view>

    <scroll-view scroll-y class="assign-list-scroll" style="padding:var(--sp-2);">
      <view wx:if="{{priceChangeLogs.length === 0}}" class="empty" style="padding:80rpx 0;">
        <text class="empty-title">暂无工价变更记录</text>
      </view>

      <view wx:for="{{priceChangeLogs}}" wx:for-item="item" wx:key="_id" class="card" style="margin-bottom:var(--sp-1);">
        <view class="flex-between" style="margin-bottom:var(--sp-1);">
          <text class="badge {{item.action === 'clear_price' ? 'badge-red' : 'badge-blue'}}">{{item.action === 'clear_price' ? '清空工价' : (item.action === 'update_process_price' ? '修改单价' : '编辑工序')}}</text>
          <text class="text-tertiary text-xs">{{item.created_at_display}}</text>
        </view>
        <text class="text-primary text-xs" style="display:block;margin-bottom:4rpx;" wx:if="{{item.process_name}}">工序: {{item.process_name}}</text>
        <text class="text-secondary text-xs" style="display:block;">{{item.details}}</text>
        <view class="divider" style="margin:var(--sp-1) 0;"></view>
        <text class="text-tertiary text-xs">操作人: {{item.operator_name || '系统'}}</text>
      </view>
    </scroll-view>
  </view>

  <!-- ========== 编辑工序弹窗 ========== -->
  <view wx:if="{{showEditProcess}}">
    <view class="modal-overlay" bindtap="closeEditProcess">
      <view class="modal-sheet" style="position:fixed;bottom:0;left:0;right:0;border-radius:var(--r-lg) var(--r-lg) 0 0;max-height:70vh;width:100%;" catchtap>
        <view class="flex-between" style="padding:var(--sp-2) var(--sp-2) 0;">
          <text class="font-bold text-sm flex-1">编辑工序</text>
          <text class="btn-sm btn-ghost" bindtap="closeEditProcess">关闭</text>
        </view>
        <view class="modal-sheet-body" style="text-align:left;">
          <view class="field-group">
            <text class="field-label">工序名称</text>
            <input class="field-input" value="{{editProcessName}}" bindinput="onEditProcessNameInput" />
          </view>
          <view class="field-group">
            <text class="field-label">备注</text>
            <input class="field-input" placeholder="可选，如工艺说明" value="{{editProcessNote}}" bindinput="onEditProcessNoteInput" />
          </view>
          <view class="field-group">
            <text class="field-label">单价（元/件）</text>
            <input class="field-input" type="digit" value="{{editProcessPrice}}" bindinput="onEditProcessPriceInput" />
          </view>
          <view class="notice notice-amber" style="margin-top:var(--sp-1);">修改单价不影响历史报工记录</view>
          <button class="btn-primary btn-block" bindtap="onSaveEditProcess" style="margin-top:var(--sp-1);">保存修改</button>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 编辑订单弹窗 ========== -->
  <view wx:if="{{showEditOrder}}">
    <view class="modal-overlay" bindtap="closeEditOrder">
      <view class="modal-sheet" style="position:fixed;bottom:0;left:0;right:0;border-radius:var(--r-lg) var(--r-lg) 0 0;max-height:70vh;width:100%;" catchtap>
        <view class="flex-between" style="padding:var(--sp-2) var(--sp-2) 0;">
          <text class="font-bold text-sm flex-1">编辑订单</text>
          <text class="btn-sm btn-ghost" bindtap="closeEditOrder">关闭</text>
        </view>
        <view class="modal-sheet-body" style="text-align:left;">
          <view class="field-group">
            <text class="field-label">订单名称</text>
            <input class="field-input" value="{{editOrderName}}" bindinput="onEditOrderNameInput" />
          </view>
          <view class="field-group">
            <text class="field-label">总数量（件）</text>
            <input class="field-input" type="number" value="{{editTotalQuantity}}" bindinput="onEditTotalQuantityInput" />
          </view>
          <view class="field-group">
            <text class="field-label">订单状态</text>
            <picker mode="selector" range="{{statusOptions}}" range-key="text" value="{{editStatusIndex}}" bindchange="onEditStatusChange">
              <view class="picker-field">
                <text>{{statusOptions[editStatusIndex].text}}</text>
                <text class="picker-arrow">▼</text>
              </view>
            </picker>
          </view>
          <view class="field-group">
            <text class="field-label">开始日期</text>
            <picker mode="date" value="{{editStartDate}}" bindchange="onEditStartDateChange">
              <view class="picker-field">
                <text>{{editStartDate || '请选择'}}</text>
                <text class="picker-arrow">▼</text>
              </view>
            </picker>
          </view>
          <view class="field-group">
            <text class="field-label">截止日期</text>
            <picker mode="date" value="{{editEndDate}}" bindchange="onEditEndDateChange">
              <view class="picker-field">
                <text>{{editEndDate || '请选择'}}</text>
                <text class="picker-arrow">▼</text>
              </view>
            </picker>
          </view>
          <view class="notice notice-amber" style="margin-top:var(--sp-1);">注意：如果已报工数量超出新总量，保存将被阻止</view>
          <button class="btn-primary btn-block" bindtap="onSaveEditOrder" style="margin-top:var(--sp-1);">保存修改</button>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 复制订单弹窗 ========== -->
  <view wx:if="{{showCopyOrder}}">
    <view class="modal-overlay" bindtap="closeCopyOrder">
      <view class="modal-sheet" style="position:fixed;bottom:0;left:0;right:0;border-radius:var(--r-lg) var(--r-lg) 0 0;max-height:70vh;width:100%;" catchtap>
        <view class="flex-between" style="padding:var(--sp-2) var(--sp-2) 0;">
          <text class="font-bold text-sm flex-1">复制订单</text>
          <text class="btn-sm btn-ghost" bindtap="closeCopyOrder">关闭</text>
        </view>
        <view class="modal-sheet-body" style="text-align:left;">
          <view class="notice notice-blue" style="margin-bottom:var(--sp-1);">将复制"{{order.order_name}}"的所有工序和员工分配</view>
          <view class="field-group">
            <text class="field-label">新订单总数量（件）</text>
            <input class="field-input" type="number" value="{{copyTotalQuantity}}" bindinput="onCopyTotalQuantityInput" />
          </view>
          <button class="btn-primary btn-block" bindtap="onConfirmCopyOrder" style="margin-top:var(--sp-1);">确认复制</button>
        </view>
      </view>
    </view>
  </view>

  <!-- ========== 工序汇总预览面板 ========== -->
  <view wx:if="{{showProcessSummary}}" class="assign-panel">
    <view class="assign-topbar">
      <text class="assign-topbar-btn" bindtap="onHideProcessSummary">关闭</text>
      <text class="assign-topbar-title">工序汇总 - {{order.order_name}}</text>
      <view style="width:80rpx;"></view>
    </view>

    <scroll-view scroll-y scroll-x class="assign-list-scroll">
      <view style="display:inline-flex;flex-direction:column;min-width:100%;">
        <view style="display:flex;">
          <view class="ps-cell ps-cell-idx" style="background:var(--text-primary);color:#fff;font-weight:var(--fw-bold);">序号</view>
          <view class="ps-cell ps-cell-name" style="background:var(--text-primary);color:#fff;font-weight:var(--fw-bold);">工序名称</view>
          <view class="ps-cell ps-cell-price" style="background:var(--text-primary);color:#fff;font-weight:var(--fw-bold);">工价(元/件)</view>
          <view class="ps-cell ps-cell-note" style="background:var(--text-primary);color:#fff;font-weight:var(--fw-bold);">备注</view>
        </view>
        <view wx:for="{{processSummaryRows}}" wx:for-item="item" wx:key="idx" style="display:flex;{{index % 2 === 1 ? 'background:var(--bg-elevated);' : ''}}">
          <view class="ps-cell ps-cell-idx">{{item.idx}}</view>
          <view class="ps-cell ps-cell-name">{{item.name}}</view>
          <view class="ps-cell ps-cell-price">{{item.price}}</view>
          <view class="ps-cell ps-cell-note">{{item.note}}</view>
        </view>
        <view wx:if="{{processSummaryRows.length === 0}}" class="empty" style="padding:60rpx 0;">
          <text class="empty-title">暂无工序数据</text>
        </view>
      </view>
    </scroll-view>

    <view class="assign-bottombar safe-bottom">
      <text class="font-bold text-sm">共 {{processSummaryRows.length}} 道工序</text>
      <view class="flex-row gap-1" style="width:100%;">
        <button class="assign-bottom-btn" bindtap="onHideProcessSummary">关闭</button>
        <button class="assign-bottom-btn-primary" bindtap="onExportProcessExcel" loading="{{exportingProcess}}">{{exportingProcess ? '导出中...' : '导出Excel'}}</button>
      </view>
    </view>
  </view>

</view>
