.container { padding-bottom: 60rpx; }

/* 月份切换头（与请假日历同款视觉，保持全站一致） */
.att-month-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--sp-2);
}
.att-month-title {
  font-size: var(--fs-md); font-weight: var(--fw-bold); color: var(--text-primary);
}
.att-month-nav {
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; line-height: 1; color: var(--blue-600);
  border-radius: var(--r-md); background: var(--surface-strong);
}
.att-month-nav.disabled { color: var(--text-tertiary); opacity: 0.35; }

/* 本月概览四宫格 */
.att-stat-row {
  display: flex;
  gap: var(--sp-1);
}
.att-stat {
  flex: 1;
  display: flex; flex-direction: column; align-items: center;
  padding: var(--sp-2) 0;
  border-radius: var(--r-md);
  background: var(--bg-card-soft);
}
.att-stat-value { font-size: var(--fs-lg); font-weight: var(--fw-bold); line-height: 1.2; }
.att-stat-label { font-size: var(--fs-2xs); color: var(--text-tertiary); margin-top: 6rpx; }
.att-rule-hint {
  display: block;
  margin-top: var(--sp-1);
  font-size: var(--fs-2xs);
  color: var(--text-tertiary);
}

/* 员工日历抽屉 */
.att-drawer { max-height: 88vh; display: flex; flex-direction: column; }
.att-drawer-body {
  max-height: 72vh;
  padding: var(--sp-2);
  box-sizing: border-box;
}

.att-week { display: flex; margin-bottom: 8rpx; }
.att-week-cell {
  flex: 1; text-align: center;
  font-size: var(--fs-2xs); color: var(--text-tertiary);
}

.att-grid { display: flex; flex-wrap: wrap; }
.att-day {
  width: calc(100% / 7);
  height: 92rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.att-day.empty { visibility: hidden; }

.att-day-inner {
  position: relative;
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  box-sizing: border-box;
}
.att-day-num { font-size: var(--fs-base); line-height: 1; }
/* 请假角标（假/上/下）压在日号右下角，不挤走日号 */
.att-day-badge, .att-day-sub {
  position: absolute;
  right: -4rpx; bottom: -4rpx;
  min-width: 28rpx; height: 28rpx;
  padding: 0 4rpx;
  border-radius: 999rpx;
  font-size: 18rpx; line-height: 28rpx; text-align: center;
  background: var(--amber-600); color: #fff;
  box-sizing: border-box;
}
.att-day-sub { background: var(--amber-500); }

/* 四种状态配色：绿=出勤 橙=请假 红=缺勤 灰=未到 */
.att-day.att-present .att-day-inner { background: var(--green-100); color: var(--green-600); }
.att-day.att-leave   .att-day-inner { background: var(--amber-100); color: var(--amber-600); }
.att-day.att-absent  .att-day-inner { background: var(--red-100); color: var(--red-600); }
.att-day.att-future  .att-day-inner { background: transparent; color: var(--text-tertiary); opacity: 0.4; }
.att-day.today .att-day-inner { border: 2rpx solid var(--blue-500); }

/* 图例 */
.att-legend {
  display: flex; flex-wrap: wrap; gap: var(--sp-2);
  margin-top: var(--sp-2);
  font-size: var(--fs-2xs); color: var(--text-tertiary);
}
.att-legend-item { display: flex; align-items: center; gap: 8rpx; }
.att-dot { width: 24rpx; height: 24rpx; border-radius: 50%; }
.att-dot.att-present { background: var(--green-100); border: 1rpx solid var(--green-500); }
.att-dot.att-leave { background: var(--amber-100); border: 1rpx solid var(--amber-500); }
.att-dot.att-absent { background: var(--red-100); border: 1rpx solid var(--red-500); }
.att-dot.att-future { background: transparent; border: 1rpx solid var(--border); }
