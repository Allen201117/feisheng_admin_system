/* pages/boss/attendance/attendance.wxss */
.container {
  background:
    radial-gradient(circle at 12% 8%, rgba(142, 183, 223, 0.16) 0%, transparent 24%),
    radial-gradient(circle at 90% 10%, rgba(205, 216, 228, 0.18) 0%, transparent 24%),
    linear-gradient(180deg, #eef3f7 0%, #f8fbfd 100%);
}

.tabs {
  display: flex;
  flex-wrap: wrap;
  background: linear-gradient(180deg, #ffffff 0%, #f9fbfe 100%);
  border-radius: 999rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  border: 2rpx solid #dce7f2;
  padding: 8rpx;
  box-shadow: 0 10rpx 20rpx rgba(17, 38, 84, 0.06);
}

.tab {
  flex: 1 1 220rpx;
  text-align: center;
  padding: 18rpx 0;
  font-size: 32rpx;
  color: #4f6584;
  position: relative;
  border-radius: 999rpx;
}

.tab-active {
  color: #135ea8;
  font-weight: 700;
  background: linear-gradient(135deg, #eaf4ff 0%, #f5faff 100%);
}

.tab-active::after {
  display: none;
}

.date-picker {
  font-size: 30rpx;
  color: #135ea8;
  padding: 12rpx 18rpx;
  background: #eef6ff;
  border-radius: 999rpx;
  border: 2rpx solid #d4e5f8;
}

.att-header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 14rpx;
}

.att-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf2f8;
  gap: 20rpx;
}

.att-row:last-child {
  border-bottom: none;
}

.att-name {
  font-size: 34rpx;
  font-weight: 700;
  flex: 1 1 180rpx;
  color: #23415d;
}

.att-date {
  font-size: 30rpx;
  color: #555;
  flex: 1 1 180rpx;
}

.att-times {
  flex: 1 1 220rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.att-hours {
  font-size: 32rpx;
  color: #135ea8;
  font-weight: 700;
  white-space: nowrap;
}

.btn-xs {
  font-size: 30rpx;
  padding: 12rpx 28rpx;
  border-radius: 8rpx;
  border: none;
  min-height: 64rpx;
  line-height: 1.6;
}

.btn-xs::after { border: none; }

.btn-supplement {
  background: #fff4eb;
  color: #c45a25;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-content {
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  width: 85%;
  max-width: calc(100vw - 56rpx);
  border-radius: 24rpx;
  padding: 40rpx;
  border: 2rpx solid #e6edf5;
  box-shadow: 0 18rpx 34rpx rgba(17, 38, 84, 0.16);
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.modal-close {
  font-size: 36rpx;
  color: #666;
  padding: 10rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 12rpx;
  flex-wrap: wrap;
  padding: 14rpx 0;
  font-size: 34rpx;
}

.info-label {
  color: #556677;
}

.picker-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 88rpx;
  border: 2rpx solid #D9D9D9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  background: #fff;
  font-size: 34rpx;
}

.picker-arrow {
  font-size: 28rpx;
  color: #666;
}
