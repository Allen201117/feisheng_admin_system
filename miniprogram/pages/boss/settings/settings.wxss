.container { padding-bottom: 60rpx; }

.settings-header-save {
  width: 132rpx;
  flex-shrink: 0;
}

.settings-segment {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--sp-1);
}

.settings-segment-item {
  min-height: 118rpx;
  padding: 20rpx;
  border-radius: 22rpx;
  border: 1rpx solid var(--hairline);
  background: var(--bg-card-soft);
  box-sizing: border-box;
}

.settings-segment-item.active {
  border-color: var(--blue-500);
  background: var(--blue-50);
}

.settings-segment-title,
.settings-segment-desc {
  display: block;
}

.settings-segment-title {
  font-size: var(--fs-sm);
  line-height: 1.3;
  color: var(--text-primary);
  font-weight: var(--fw-bold);
}

.settings-segment-desc {
  margin-top: 6rpx;
  font-size: var(--fs-xs);
  line-height: 1.35;
  color: var(--text-secondary);
}
