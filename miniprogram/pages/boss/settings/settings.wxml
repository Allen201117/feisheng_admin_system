<view class="container">
  <view class="page-header">
    <view class="page-header-left">
      <text class="page-header-title">设置</text>
      <text class="page-header-subtitle">工厂、考勤与账号配置</text>
    </view>
    <button class="settings-header-save btn-sm btn-sm-primary" bindtap="onSave" disabled="{{loading}}" hover-class="tap-button-hover">{{loading ? '保存中' : '保存'}}</button>
  </view>

  <!-- ============ 考勤打卡 ============ -->
  <text class="settings-section">考勤打卡</text>

  <!-- 打卡点 -->
  <view class="card-bento">
    <view class="settings-head">
      <text class="settings-title">打卡点</text>
      <text class="settings-count">已设 {{checkpointTotal}} 个</text>
    </view>
    <text class="settings-desc">走到工厂各个入口，采样一次就能加一个打卡点。员工在任意打卡点附近都能打卡。</text>

    <button class="btn-primary btn-block" bindtap="getLocation" disabled="{{locating}}" hover-class="tap-button-hover">{{locating ? '正在采样定位...' : '采样当前位置'}}</button>

    <view wx:if="{{locationResult}}" class="notice notice-green settings-gap-sm">
      <text class="text-green text-sm font-medium">采样成功（精度{{locationResult.accuracy}}）</text>
    </view>
    <view wx:if="{{sampledLocation}}" class="settings-action-row">
      <button class="flex-1 btn-sm btn-sm-ghost settings-ghost-btn" bindtap="applySampleToMain" hover-class="tap-button-hover">{{factory_latitude ? '更新主打卡点' : '设为主打卡点'}}</button>
      <button class="flex-1 btn-sm btn-sm-ghost settings-ghost-btn" bindtap="quickAddCheckpoint" hover-class="tap-button-hover">添加为附加打卡点</button>
    </view>

    <view class="settings-sub-card">
      <view wx:if="{{factory_latitude}}" class="list-row">
        <view class="flex-1">
          <text class="list-row-title">主打卡点</text>
          <text class="list-row-subtitle">{{factory_latitude}}, {{factory_longitude}}</text>
        </view>
        <text class="badge badge-blue">主</text>
      </view>
      <view wx:else class="list-row">
        <text class="list-row-subtitle">还没设主打卡点，先点上面「采样当前位置」</text>
      </view>

      <view wx:for="{{checkpoints}}" wx:for-item="item" wx:key="index" class="list-row">
        <view class="flex-1">
          <text class="list-row-title">{{item.name || '附加打卡点 ' + (index + 1)}}</text>
          <text class="list-row-subtitle">{{item.latitude}}, {{item.longitude}}</text>
        </view>
        <text class="settings-remove" data-index="{{index}}" bindtap="removeCheckpoint" hover-class="tap-chip-hover">删除</text>
      </view>
    </view>

    <view class="settings-toggle" bindtap="toggleAdvancedInput" hover-class="tap-row-hover">
      <text class="text-tertiary text-xs">{{showAdvancedInput ? '收起手动输入坐标 ▲' : '手动输入坐标 ▼'}}</text>
    </view>

    <view wx:if="{{showAdvancedInput}}">
      <view class="notice notice-amber">手动输入请使用 GCJ-02 坐标（微信/高德/腾讯地图），不要用百度地图坐标。</view>
      <view class="field-group">
        <text class="field-label">主打卡点纬度</text>
        <input class="field-input" type="digit" placeholder="自动采样获取" value="{{factory_latitude}}" data-field="factory_latitude" bindinput="onInput" />
      </view>
      <view class="field-group">
        <text class="field-label">主打卡点经度</text>
        <input class="field-input" type="digit" placeholder="自动采样获取" value="{{factory_longitude}}" data-field="factory_longitude" bindinput="onInput" />
      </view>
    </view>
  </view>

  <!-- 打卡规则 -->
  <view class="card-bento">
    <view class="settings-head">
      <text class="settings-title">打卡规则</text>
    </view>

    <view class="settings-row">
      <view class="settings-row-main">
        <text class="settings-row-title">打卡范围半径</text>
        <text class="settings-row-desc">所有打卡点共用。GPS 精度差时会自动补偿容差。</text>
      </view>
      <view class="settings-row-input">
        <input class="field-input settings-input" type="number" placeholder="100" value="{{geofence_radius}}" data-field="geofence_radius" bindinput="onInput" />
        <text class="settings-unit">米</text>
      </view>
    </view>

    <view class="settings-row">
      <view class="settings-row-main">
        <text class="settings-row-title">二维码有效期</text>
        <text class="settings-row-desc">考勤二维码多久失效。</text>
      </view>
      <view class="settings-row-input">
        <input class="field-input settings-input" type="number" placeholder="1" value="{{qrcode_expire_days}}" data-field="qrcode_expire_days" bindinput="onInput" />
        <text class="settings-unit">天</text>
      </view>
    </view>

    <view class="settings-row settings-row-last">
      <view class="settings-row-main">
        <text class="settings-row-title">允许居家打卡</text>
        <text class="settings-row-desc">开启后员工在围栏外也能打卡，会标记为居家打卡。</text>
      </view>
      <switch checked="{{allow_home_checkin}}" data-field="allow_home_checkin" bindchange="onSwitchChange" color="#2563EB" />
    </view>
  </view>

  <!-- ============ 工资与统计 ============ -->
  <text class="settings-section">工资与统计</text>

  <view class="card-bento">
    <view class="settings-head">
      <text class="settings-title">发薪机制</text>
    </view>
    <text class="settings-desc">薪酬管理默认按月份结算，还是按订单结算。</text>
    <view class="settings-segment">
      <view class="settings-segment-item {{salary_payroll_mode === 'monthly' ? 'active' : ''}}" data-mode="monthly" bindtap="onPayrollModeTap" hover-class="tap-chip-hover">
        <text class="settings-segment-title">按月发薪</text>
        <text class="settings-segment-desc">按月份汇总员工工资</text>
      </view>
      <view class="settings-segment-item {{salary_payroll_mode === 'order' ? 'active' : ''}}" data-mode="order" bindtap="onPayrollModeTap" hover-class="tap-chip-hover">
        <text class="settings-segment-title">按订单发薪</text>
        <text class="settings-segment-desc">订单完成后按订单结算</text>
      </view>
    </view>

    <view class="settings-row settings-row-last settings-gap">
      <view class="settings-row-main">
        <text class="settings-row-title">合格率阈值</text>
        <text class="settings-row-desc">排行榜用：低于这个合格率不上榜。</text>
      </view>
      <view class="settings-row-input">
        <input class="field-input settings-input" type="number" placeholder="95" value="{{quality_threshold}}" data-field="quality_threshold" bindinput="onInput" />
        <text class="settings-unit">%</text>
      </view>
    </view>
  </view>

  <!-- ============ 数据维护 ============ -->
  <text class="settings-section">数据维护</text>

  <!-- 结算价对账 -->
  <view class="card-bento">
    <view class="settings-head">
      <text class="settings-title">结算价对账</text>
    </view>
    <text class="settings-desc">检查历史报工的结算价有没有跟工序当前工价对齐。改过工价的老数据会在这里被找出来，确认后可一键对齐。</text>
    <button class="btn btn-outline btn-block" bindtap="onCheckSettlementPrices" disabled="{{repairing}}" hover-class="tap-button-hover">{{repairing ? '检查中...' : '检查结算价'}}</button>

    <view wx:if="{{repairReport}}" class="settings-gap">
      <!-- 三种明确状态：全对齐(绿) / 查出问题(橙) / 刚写完库(绿) -->
      <view class="settings-result {{repairReport.status === 'dirty' ? 'is-warn' : 'is-ok'}}">
        <text class="settings-result-icon">{{repairReport.status === 'dirty' ? '!' : '✓'}}</text>
        <view class="flex-1">
          <text class="settings-result-title">{{repairReport.headline}}</text>
          <text class="settings-result-desc">{{repairReport.summaryText}}</text>
        </view>
      </view>

      <view wx:for="{{repairReport.samples}}" wx:key="worklog_id" class="list-row">
        <view class="flex-1">
          <text class="list-row-title">{{item.title}}</text>
          <text class="list-row-subtitle">{{item.detail}}</text>
        </view>
      </view>

      <view wx:if="{{repairReport.manual_review.length > 0}}" class="notice notice-amber settings-gap-sm">下面这些金额对不上账，我没有动，需要你自己确认：</view>
      <view wx:for="{{repairReport.manual_review}}" wx:key="scopeKey" class="list-row">
        <view class="flex-1">
          <text class="list-row-title text-red">{{item.user_name}} · {{item.scope}}</text>
          <text class="list-row-subtitle">实发 ¥{{item.recordedTotal}}｜{{item.reason}}</text>
        </view>
      </view>

      <button wx:if="{{repairReport.total_fix_count > 0}}" class="btn-primary btn-block settings-gap" bindtap="onApplySettlementRepair" disabled="{{repairing}}" hover-class="tap-button-hover">一键对齐这 {{repairReport.total_fix_count}} 条</button>
    </view>
  </view>

  <!-- 奖惩冲正清理 -->
  <view class="card-bento">
    <view class="settings-head">
      <text class="settings-title">奖惩冲正清理</text>
    </view>
    <text class="settings-desc">早期版本会把「按订单发薪」误当成「按月发薪」，于是删奖惩时没真删，只加了一条反向的冲正记录抵消，原记录还留在明细里。这里把这些误判留下的冲正找出来，确认后一次清干净。已发薪期次的冲正是账目痕迹，不会动。</text>
    <button class="btn btn-outline btn-block" bindtap="onCheckAdjustmentReversals" disabled="{{reversalChecking}}" hover-class="tap-button-hover">{{reversalChecking ? '检查中...' : '检查奖惩冲正'}}</button>

    <view wx:if="{{reversalReport}}" class="settings-gap">
      <view class="settings-result {{reversalReport.status === 'dirty' ? 'is-warn' : 'is-ok'}}">
        <text class="settings-result-icon">{{reversalReport.status === 'dirty' ? '!' : '✓'}}</text>
        <view class="flex-1">
          <text class="settings-result-title">{{reversalReport.headline}}</text>
          <text class="settings-result-desc">{{reversalReport.summaryText}}</text>
        </view>
      </view>

      <view wx:for="{{reversalReport.rows}}" wx:key="key" class="list-row">
        <view class="flex-1">
          <text class="list-row-title">{{item.title}}</text>
          <text class="list-row-subtitle">{{item.detail}}</text>
        </view>
        <text class="badge badge-amber">{{item.badgeText}}</text>
      </view>

      <view wx:if="{{reversalReport.manual_review.length > 0}}" class="notice notice-amber settings-gap-sm">下面这些已经发过薪了，动了会和实发总额对不上，我没有改，需要你自己确认：</view>
      <view wx:for="{{reversalReport.manual_review}}" wx:key="key" class="list-row">
        <view class="flex-1">
          <text class="list-row-title text-red">{{item.title}}</text>
          <text class="list-row-subtitle">{{item.detail}}</text>
        </view>
      </view>

      <button wx:if="{{reversalReport.total_fix_count > 0}}" class="btn-primary btn-block settings-gap" bindtap="onApplyAdjustmentReversals" disabled="{{reversalChecking}}" hover-class="tap-button-hover">清掉这 {{reversalReport.total_group_count}} 组</button>
    </view>
  </view>

  <!-- 历史半天请假识别 -->
  <view class="card-bento">
    <view class="settings-head">
      <text class="settings-title">历史半天请假</text>
    </view>
    <text class="settings-desc">半天请假是新功能。在这之前记的假，「上午/下午」只能写在备注里，系统按整天算。这里把备注里能读出半天的老记录找出来，转成真正的半天（请假天数会从 1 天变 0.5 天）。</text>
    <button class="btn btn-outline btn-block" bindtap="onCheckLegacyHalfDay" disabled="{{halfDayChecking}}" hover-class="tap-button-hover">{{halfDayChecking ? '检查中...' : '检查历史请假备注'}}</button>

    <view wx:if="{{halfDayReport}}" class="settings-gap">
      <view class="settings-result {{halfDayReport.status === 'dirty' ? 'is-warn' : 'is-ok'}}">
        <text class="settings-result-icon">{{halfDayReport.status === 'dirty' ? '!' : '✓'}}</text>
        <view class="flex-1">
          <text class="settings-result-title">{{halfDayReport.headline}}</text>
          <text class="settings-result-desc">{{halfDayReport.summaryText}}</text>
        </view>
      </view>

      <view wx:for="{{halfDayReport.rows}}" wx:key="_id" class="list-row">
        <view class="flex-1">
          <text class="list-row-title">{{item.title}}</text>
          <text class="list-row-subtitle">{{item.detail}}</text>
        </view>
        <text class="badge badge-amber">{{item.kindText}}</text>
      </view>

      <view wx:if="{{halfDayReport.unmatched.length > 0}}" class="notice notice-amber settings-gap-sm">下面这些备注看不出是不是半天，系统不敢替你改。右边是它们现在的时段——本来就是全天的（事假 / 病假 / 有事）不用管；确实是半天的点「改时段」，改完这里的时段会跟着变。</view>
      <view wx:for="{{halfDayReport.unmatched}}" wx:key="_id" class="list-row">
        <view class="flex-1">
          <text class="list-row-title">{{item.title}}</text>
          <text class="list-row-subtitle">备注：{{item.reason}}</text>
        </view>
        <view class="settings-kind-cell">
          <text class="badge {{item.kindClass}}">{{item.kindText}}</text>
          <text class="text-tertiary text-xs">{{item.dayText}}</text>
        </view>
        <text class="settings-inline-btn" data-id="{{item._id}}" data-title="{{item.title}}" bindtap="onFixLeaveKind" hover-class="tap-chip-hover">改时段</text>
      </view>

      <button wx:if="{{halfDayReport.total_fix_count > 0}}" class="btn-primary btn-block settings-gap" bindtap="onApplyLegacyHalfDay" disabled="{{halfDayChecking}}" hover-class="tap-button-hover">转换这 {{halfDayReport.total_fix_count}} 条</button>
    </view>
  </view>

  <!-- ============ 账号与服务 ============ -->
  <text class="settings-section">账号与服务</text>

  <view class="card-bento">
    <view class="list-row tappable" bindtap="goSubscription" hover-class="tap-row-hover">
      <view class="flex-1">
        <text class="list-row-title">服务状态与续费</text>
        <text class="list-row-subtitle">当前版本、到期时间，复制开通信息给平台管理员</text>
      </view>
      <text class="settings-arrow">›</text>
    </view>
    <view class="list-row tappable" bindtap="goPrivacyPolicy" hover-class="tap-row-hover">
      <text class="flex-1 list-row-title">隐私政策</text>
      <text class="settings-arrow">›</text>
    </view>
    <view class="list-row tappable settings-row-last" bindtap="goUserAgreement" hover-class="tap-row-hover">
      <text class="flex-1 list-row-title">用户服务协议</text>
      <text class="settings-arrow">›</text>
    </view>
  </view>

  <view class="safe-bottom"></view>
</view>
