.container { padding-bottom: 60rpx; }

.leave-item {
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--border-light);
}
.leave-item:last-child { border-bottom: none; }

.leave-new-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: var(--red-500);
  flex-shrink: 0;
}

.leave-dates {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--text-primary);
}

.leave-reason {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-2xs);
  color: var(--text-secondary);
}
