.container { padding-bottom: 60rpx; }

.leave-add-btn {
  flex-shrink: 0;
  min-height: 60rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: var(--blue-600);
  color: #fff;
  display: flex;
  align-items: center;
  font-size: var(--fs-sm);
  font-weight: var(--fw-semibold);
}

/* 代录弹窗内员工搜索选择 */
.emp-pick-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}
.emp-pick-chip {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--surface-strong);
  border: 1rpx solid var(--hairline);
  color: var(--text-primary);
  font-size: 26rpx;
}
.emp-pick-chip.is-selected {
  background: var(--blue-50);
  border-color: var(--blue-600);
  color: var(--blue-600);
  font-weight: 600;
}

/* 代录弹窗内日历（与员工请假页同款视觉） */
.leave-cal-head {
  display: flex; align-items: center; justify-content: space-between;
  margin-bottom: var(--sp-2);
}
.leave-cal-title {
  font-size: var(--fs-md); font-weight: var(--fw-bold); color: var(--text-primary);
}
.leave-cal-nav {
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; line-height: 1; color: var(--blue-600);
  border-radius: var(--r-md); background: var(--surface-strong);
}
.leave-cal-nav.disabled { color: var(--text-tertiary); opacity: 0.4; }

.leave-week { display: flex; margin-bottom: 8rpx; }
.leave-week-cell {
  flex: 1; text-align: center;
  font-size: var(--fs-2xs); color: var(--text-tertiary);
}

.leave-grid { display: flex; flex-wrap: wrap; }
.leave-day {
  width: calc(100% / 7);
  height: 92rpx;
  display: flex; align-items: center; justify-content: center;
  box-sizing: border-box;
}
.leave-day.empty { visibility: hidden; }

.leave-day-inner {
  width: 72rpx; height: 72rpx;
  display: flex; align-items: center; justify-content: center;
  border-radius: 50%;
  font-size: var(--fs-base); color: var(--text-primary);
  box-sizing: border-box;
  transition: all 0.15s var(--ease-apple);
}
.leave-day.disabled .leave-day-inner { color: var(--text-tertiary); opacity: 0.35; }
.leave-day.today .leave-day-inner { border: 2rpx solid var(--blue-500); }
.leave-day.selected .leave-day-inner {
  background: var(--blue-500); color: #fff;
  font-weight: var(--fw-semibold);
  border: none;
  box-shadow: var(--shadow-blue);
}

.leave-summary {
  margin-top: var(--sp-2);
  padding: var(--sp-1) var(--sp-2);
  border-radius: var(--r-md);
  background: var(--surface-blue);
  font-size: var(--fs-sm); color: var(--blue-600); font-weight: var(--fw-medium);
}
.leave-summary.muted { background: var(--surface-strong); color: var(--text-secondary); font-weight: var(--fw-regular); }

.leave-item {
  padding: var(--sp-2) 0;
  border-bottom: 1rpx solid var(--border-light);
}
.leave-item:last-child { border-bottom: none; }

.leave-new-dot {
  width: 16rpx; height: 16rpx;
  border-radius: 50%;
  background: var(--red-500);
  flex-shrink: 0;
}

.leave-dates {
  display: block;
  margin-top: 8rpx;
  font-size: var(--fs-sm);
  color: var(--text-primary);
}

.leave-reason {
  display: block;
  margin-top: 4rpx;
  font-size: var(--fs-2xs);
  color: var(--text-secondary);
}

.leave-item-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12rpx;
}

.leave-del-btn {
  min-height: 52rpx;
  padding: 0 26rpx;
  border-radius: 999rpx;
  background: rgba(217,45,32,0.09);
  color: #D92D20;
  border: 1rpx solid rgba(217,45,32,0.20);
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
}

/* 半天请假：连点日期在 全天/上午/下午 间循环，半天用浅底+角标区分于全天的实心蓝 */
.leave-day-inner { position: relative; }
.leave-day.selected.half .leave-day-inner {
  background: var(--blue-50);
  color: var(--blue-600);
  border: 2rpx solid var(--blue-500);
  box-shadow: none;
}
.leave-day-half {
  position: absolute;
  right: -6rpx; bottom: -6rpx;
  min-width: 28rpx; height: 28rpx;
  padding: 0 4rpx;
  border-radius: 999rpx;
  background: var(--blue-600); color: #fff;
  font-size: 18rpx; line-height: 28rpx; text-align: center;
}
