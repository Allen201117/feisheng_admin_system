<import src="/templates/shared.wxml" />

<view class="container boss-home-page">

  <!-- 今日概览 -->
  <view class="boss-overview">
    <view class="boss-overview-head">
      <view class="boss-overview-titlewrap">
        <text class="boss-kicker">{{todayDate}}</text>
        <text class="boss-title">{{userInfo.org_name || '飞盛'}}</text>
        <text class="boss-subtitle">{{userInfo.name}} · 管理后台</text>
      </view>
      <view class="boss-logout" bindtap="onLogout" hover-class="tap-button-hover">退出</view>
    </view>
    <view class="boss-salary-panel tappable" bindtap="onStatTap" data-target="salary" hover-class="tap-card-hover" hover-stay-time="80">
      <view>
        <text class="boss-panel-label">本月薪资支出</text>
        <text class="boss-panel-value">¥{{stats.monthSalary}}</text>
      </view>
      <view class="boss-panel-action">明细</view>
    </view>
  </view>

  <!-- 订阅状态 -->
  <view wx:if="{{subscription}}" class="subscription-bar {{subscriptionStatusClass}} tappable" bindtap="goSubscription" hover-class="tap-card-hover" hover-stay-time="80">
    <view class="subscription-bar-main">
      <text class="subscription-bar-title">服务状态：{{subscription.billing_status_label}}</text>
      <text class="subscription-bar-meta">{{subscription.plan_name}} | 到期 {{subscription.current_period_end_text}}</text>
    </view>
    <view class="subscription-bar-action">查看</view>
  </view>

  <!-- 经营概览 -->
  <view class="card-bento">
    <view class="menu-group-head">
      <text class="menu-group-title">经营概览</text>
      <text class="menu-group-note">点击卡片直达</text>
    </view>
    <view class="stats-grid">
      <view class="stats-card blue tappable" bindtap="onStatTap" data-target="employees" hover-class="tap-card-hover" hover-stay-time="80">
        <text class="stats-card-label">员工总数</text>
        <text class="stats-card-value">{{stats.totalEmployees}}</text>
        <text class="stats-card-note">员工管理</text>
      </view>
      <view class="stats-card green tappable" bindtap="onStatTap" data-target="attendance" hover-class="tap-card-hover" hover-stay-time="80">
        <text class="stats-card-label">今日出勤</text>
        <text class="stats-card-value">{{stats.todayAttendance}}</text>
        <text class="stats-card-note">考勤管理</text>
      </view>
      <view class="stats-card amber tappable" bindtap="onStatTap" data-target="orders" hover-class="tap-card-hover" hover-stay-time="80">
        <text class="stats-card-label">进行中订单</text>
        <text class="stats-card-value">{{stats.activeOrders}}</text>
        <text class="stats-card-note">订单管理</text>
      </view>
      <view class="stats-card blue tappable" bindtap="onStatTap" data-target="qc" hover-class="tap-card-hover" hover-stay-time="80">
        <text class="stats-card-label">待质检</text>
        <text class="stats-card-value">{{stats.pendingQC}}</text>
        <text class="stats-card-note">质检工作台</text>
      </view>
    </view>
  </view>

  <!-- 人员管理 -->
  <view class="card-bento">
    <view class="menu-group-head">
      <text class="menu-group-title">人员管理</text>
      <text class="menu-group-note">员工、考勤与质检</text>
    </view>
    <view class="menu-grid">
      <view class="menu-item tappable" bindtap="goTo" data-page="employees" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon blue">
          <image src="/images/icons/employees.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">员工管理</text>
      </view>
      <view class="menu-item tappable" bindtap="goTo" data-page="attendance" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon green">
          <image src="/images/icons/attendance.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">考勤管理</text>
      </view>
      <view class="menu-item tappable" bindtap="goToQC" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon amber">
          <image src="/images/icons/qc.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">质检管理</text>
      </view>
      <view class="menu-item tappable" bindtap="goTo" data-page="leaderboard" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon slate">
          <image src="/images/icons/leaderboard.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">排行榜</text>
      </view>
    </view>
  </view>

  <!-- 生产管理 -->
  <view class="card-bento">
    <view class="menu-group-head">
      <text class="menu-group-title">生产管理</text>
      <text class="menu-group-note">订单、报工与数据</text>
    </view>
    <view class="menu-grid">
      <view class="menu-item tappable" bindtap="goTo" data-page="orders" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon blue">
          <image src="/images/icons/orders.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">订单管理</text>
      </view>
      <view class="menu-item tappable" bindtap="goTo" data-page="worklog-manage" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon green">
          <image src="/images/icons/worklog.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">报工管理</text>
      </view>
      <view class="menu-item tappable" bindtap="goTo" data-page="qrcode" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon amber">
          <image src="/images/icons/qrcode-icon.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">考勤码</text>
      </view>
      <view class="menu-item tappable" bindtap="goTo" data-page="data-center" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon slate">
          <image src="/images/icons/database.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">数据中心</text>
      </view>
    </view>
  </view>

  <!-- 薪酬与报表 -->
  <view class="card-bento">
    <view class="menu-group-head">
      <text class="menu-group-title">薪酬与报表</text>
      <text class="menu-group-note">工资发放与数据导出</text>
    </view>
    <view class="menu-grid">
      <view class="menu-item tappable" bindtap="goTo" data-page="salary" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon red" style="position:relative;">
          <image src="/images/icons/salary.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
          <text wx:if="{{leaveUnread > 0}}" class="home-menu-dot">{{leaveUnread}}</text>
        </view>
        <text class="menu-item-label">薪酬管理<text wx:if="{{leaveUnread > 0}}" class="home-menu-hint">· {{leaveUnread}}条请假</text></text>
      </view>
      <view class="menu-item tappable" bindtap="goTo" data-page="export" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon amber">
          <image src="/images/icons/export.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">导出报表</text>
      </view>
    </view>
  </view>

  <!-- 系统工具 -->
  <view class="card-bento">
    <view class="menu-group-head">
      <text class="menu-group-title">系统工具</text>
    </view>
    <view class="menu-grid">
      <view class="menu-item tappable" bindtap="goTo" data-page="settings" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon slate">
          <image src="/images/icons/settings.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">系统设置</text>
      </view>
      <view class="menu-item tappable" bindtap="openChangePwd" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon slate">
          <image src="/images/icons/lock.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">修改密码</text>
      </view>
      <view class="menu-item tappable" bindtap="goSubscription" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="menu-item-icon blue">
          <image src="/images/icons/profile.svg" mode="aspectFit" style="width:40rpx;height:40rpx;" />
        </view>
        <text class="menu-item-label">服务续费</text>
      </view>
    </view>
  </view>

  <!-- 修改密码弹窗 -->
  <view wx:if="{{showChangePwd}}">
    <view class="modal-overlay" bindtap="closeChangePwd">
      <view class="modal-sheet" catchtap>
        <text class="modal-sheet-title">修改密码</text>
        <view class="modal-sheet-body">
          <view class="field-group">
            <text class="field-label">旧密码</text>
            <view class="flex-row gap-1">
              <input class="field-input flex-1" type="{{showOldPwd ? 'text' : 'password'}}" placeholder="请输入旧密码" value="{{changePwdData.oldPassword}}" bindinput="onOldPwdInput" />
              <text class="btn-sm btn-ghost" bindtap="toggleOldPwd" hover-class="tap-chip-hover">{{showOldPwd ? '隐藏' : '显示'}}</text>
            </view>
          </view>
          <view class="field-group">
            <text class="field-label">新密码</text>
            <view class="flex-row gap-1">
              <input class="field-input flex-1" type="{{showNewPwd ? 'text' : 'password'}}" placeholder="至少8位，含字母和数字" value="{{changePwdData.newPassword}}" bindinput="onNewPwdInput" />
              <text class="btn-sm btn-ghost" bindtap="toggleNewPwd" hover-class="tap-chip-hover">{{showNewPwd ? '隐藏' : '显示'}}</text>
            </view>
          </view>
          <view class="field-group">
            <text class="field-label">确认新密码</text>
            <input class="field-input" type="password" placeholder="再次输入新密码" value="{{changePwdData.confirmPassword}}" bindinput="onConfirmPwdInput" />
          </view>
        </view>
        <view class="modal-sheet-footer">
          <view class="modal-sheet-btn" bindtap="closeChangePwd" hover-class="tap-row-hover">取消</view>
          <view class="modal-sheet-btn {{changePwdLoading ? 'btn-disabled' : ''}}" bindtap="onSubmitChangePwd" hover-class="tap-row-hover">{{changePwdLoading ? '提交中...' : '确认修改'}}</view>
        </view>
      </view>
    </view>
  </view>

</view>
