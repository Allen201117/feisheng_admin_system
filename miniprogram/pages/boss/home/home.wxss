.boss-home-page {
  padding: 24rpx 24rpx 72rpx;
  background: var(--bg-page);
}

.boss-overview {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-elevated);
}

.boss-overview-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.boss-overview-titlewrap {
  flex: 1;
  min-width: 0;
}

.boss-kicker {
  display: block;
  font-size: 24rpx;
  color: var(--text-tertiary);
  line-height: 1.3;
}

.boss-title {
  display: block;
  margin-top: 6rpx;
  font-size: 44rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #111827;
}

.boss-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.35;
  color: var(--text-primary);
}

.boss-logout {
  min-width: 96rpx;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: var(--surface-strong);
  color: var(--text-primary);
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.boss-salary-panel {
  margin-top: 28rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, var(--surface-strong) 0%, var(--bg-card-soft) 100%);
  border: 1rpx solid var(--hairline);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.boss-panel-label {
  display: block;
  font-size: 26rpx;
  color: var(--text-primary);
  line-height: 1.4;
}

.boss-panel-value {
  display: block;
  margin-top: 8rpx;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
  color: #111827;
  font-variant-numeric: tabular-nums;
}

.boss-panel-action {
  min-width: 88rpx;
  min-height: 56rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #0066CC;
  font-size: 24rpx;
  font-weight: 700;
  border: 1rpx solid rgba(0,102,204,0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.boss-home-page .subscription-bar,
.boss-home-page .card-bento {
  border-radius: 28rpx;
  border: 1rpx solid var(--hairline);
  box-shadow: var(--shadow-card);
}

.boss-home-page .menu-group-title {
  font-size: 28rpx;
  color: var(--text-primary);
  letter-spacing: 0;
  text-transform: none;
}

.boss-home-page .menu-group-note {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.boss-home-page .stats-card {
  border: 1rpx solid var(--hairline);
  border-radius: 22rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  box-shadow: var(--shadow-card);
  padding: 26rpx;
}

.boss-home-page .stats-card.blue,
.boss-home-page .stats-card.green,
.boss-home-page .stats-card.amber,
.boss-home-page .stats-card.slate {
  border-left: none;
}

.boss-home-page .stats-card-label {
  font-size: 25rpx;
  color: var(--text-primary);
}

.boss-home-page .stats-card-value {
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1;
  color: #111827;
}

.boss-home-page .stats-card-note {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: var(--text-tertiary);
}

.boss-home-page .menu-grid {
  gap: 14rpx;
}

.boss-home-page .menu-item {
  min-height: 128rpx;
  padding: 22rpx 16rpx;
  border: 1rpx solid var(--hairline);
  border-radius: 24rpx;
  background: linear-gradient(180deg, #FFFFFF 0%, var(--bg-card-soft) 100%);
  box-shadow: var(--shadow-card);
}

.boss-home-page .menu-item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  margin-bottom: 10rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.76);
}

.boss-home-page .menu-item-label {
  font-size: 28rpx;
  color: #1D2939;
}
