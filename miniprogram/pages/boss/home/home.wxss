.boss-home-page {
  padding: 24rpx 24rpx 72rpx;
  background: #F5F5F7;
}

.boss-overview {
  margin-bottom: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(226,232,240,0.9);
  box-shadow: 0 10rpx 30rpx rgba(15,23,42,0.05);
}

.boss-overview-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
}

.boss-overview-titlewrap {
  flex: 1;
  min-width: 0;
}

.boss-kicker {
  display: block;
  font-size: 24rpx;
  color: #8A8F98;
  line-height: 1.3;
}

.boss-title {
  display: block;
  margin-top: 6rpx;
  font-size: 44rpx;
  line-height: 1.12;
  font-weight: 700;
  color: #111827;
}

.boss-subtitle {
  display: block;
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.35;
  color: #6B7280;
}

.boss-logout {
  min-width: 96rpx;
  min-height: 60rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #F2F4F7;
  color: #475467;
  font-size: 26rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.boss-salary-panel {
  margin-top: 28rpx;
  padding: 26rpx;
  border-radius: 26rpx;
  background: linear-gradient(180deg, #F8FAFC 0%, #F3F6FA 100%);
  border: 1rpx solid rgba(226,232,240,0.92);
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.boss-panel-label {
  display: block;
  font-size: 26rpx;
  color: #667085;
  line-height: 1.4;
}

.boss-panel-value {
  display: block;
  margin-top: 8rpx;
  font-size: 56rpx;
  line-height: 1;
  font-weight: 700;
  color: #111827;
  font-variant-numeric: tabular-nums;
}

.boss-panel-action {
  min-width: 88rpx;
  min-height: 56rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #0066CC;
  font-size: 24rpx;
  font-weight: 700;
  border: 1rpx solid rgba(0,102,204,0.16);
  display: flex;
  align-items: center;
  justify-content: center;
}

.boss-home-page .subscription-bar,
.boss-home-page .card-bento {
  border-radius: 28rpx;
  border: 1rpx solid rgba(226,232,240,0.88);
  box-shadow: 0 8rpx 24rpx rgba(15,23,42,0.045);
}

.boss-home-page .menu-group-title {
  font-size: 28rpx;
  color: #475467;
  letter-spacing: 0;
  text-transform: none;
}

.boss-home-page .menu-group-note {
  font-size: 24rpx;
  color: #98A2B3;
}

.boss-home-page .stats-card {
  border: none;
  border-radius: 22rpx;
  background: #F8FAFC;
  box-shadow: none;
  padding: 26rpx;
}

.boss-home-page .stats-card.blue,
.boss-home-page .stats-card.green,
.boss-home-page .stats-card.amber,
.boss-home-page .stats-card.slate {
  border-left: none;
}

.boss-home-page .stats-card-label {
  font-size: 25rpx;
  color: #667085;
}

.boss-home-page .stats-card-value {
  margin-top: 12rpx;
  font-size: 44rpx;
  line-height: 1;
  color: #111827;
}

.boss-home-page .stats-card-note {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #98A2B3;
}

.boss-home-page .menu-grid {
  gap: 14rpx;
}

.boss-home-page .menu-item {
  min-height: 128rpx;
  padding: 22rpx 16rpx;
  border: none;
  border-radius: 24rpx;
  background: #F8FAFC;
  box-shadow: none;
}

.boss-home-page .menu-item-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  margin-bottom: 10rpx;
  box-shadow: none;
}

.boss-home-page .menu-item-label {
  font-size: 28rpx;
  color: #1D2939;
}
