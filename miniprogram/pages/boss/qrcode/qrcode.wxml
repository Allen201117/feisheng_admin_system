<view class="container qrcode-page">
  <view class="card-bento">
    <text class="text-center font-bold text-md" style="display:block;">考勤二维码</text>
    <text class="text-center text-tertiary text-xs" style="display:block;margin-bottom:var(--sp-2);">
      员工使用微信扫一扫此码，即可快速进入打卡页面
    </text>

    <!-- 二维码显示区域 -->
    <view class="flex-center" style="margin:var(--sp-2) auto;" bindtap="onPreview">
      <image
        wx:if="{{qrcodeUrl && qrType !== 'text'}}"
        src="{{qrcodeUrl}}"
        mode="aspectFit"
        show-menu-by-longpress="true"
        style="width:500rpx;height:500rpx;border-radius:var(--r-sm);border:1rpx solid var(--border);"
      />
      <view wx:if="{{qrType === 'text'}}" style="width:500rpx;height:500rpx;border-radius:var(--r-sm);border:2rpx dashed var(--border);display:flex;align-items:center;justify-content:center;flex-direction:column;background:var(--bg-elevated);padding:var(--sp-2);box-sizing:border-box;">
        <text class="text-tertiary text-base">当前环境无小程序码权限</text>
        <text class="text-tertiary text-base" style="margin-top:var(--sp-2);">已生成场景码：{{scene}}</text>
        <button class="btn-outline btn-block" style="margin-top:var(--sp-2);" bindtap="onCopyScene">复制场景码</button>
        <button wx:if="{{debugPath}}" class="btn-outline btn-block" style="margin-top:var(--sp-2);" bindtap="onCopyDebugPath">复制联调路径</button>
      </view>
      <view wx:if="{{!qrcodeUrl && qrType !== 'text'}}" style="width:500rpx;height:500rpx;border-radius:var(--r-sm);border:2rpx dashed var(--border);display:flex;align-items:center;justify-content:center;flex-direction:column;background:var(--bg-elevated);padding:var(--sp-2);box-sizing:border-box;">
        <text class="text-tertiary text-base">点击下方按钮生成二维码</text>
      </view>
    </view>
    <!-- 体验版普通二维码提示 -->
    <view wx:if="{{qrType === 'fallback'}}" class="flex-col flex-center gap-1" style="margin-top:var(--sp-2);">
      <text class="badge badge-amber">体验版模式</text>
      <text class="text-amber text-xs">员工需在小程序内点"扫码打卡"扫此码</text>
    </view>
    <view wx:if="{{qrType === 'scheme'}}" class="flex-col flex-center gap-1" style="margin-top:var(--sp-2);">
      <text class="badge badge-green">直跳模式</text>
      <text class="text-green text-xs">员工可直接微信扫一扫跳转并打卡</text>
    </view>

    <!-- 二维码信息 -->
    <view wx:if="{{lastGenerated}}" class="card" style="margin-top:var(--sp-2);padding:var(--sp-2);">
      <view class="list-row" style="padding:8rpx 0;">
        <text class="list-row-subtitle">生成时间:</text>
        <text class="list-row-extra text-xs">{{lastGenerated}}</text>
      </view>
      <view class="list-row" style="padding:8rpx 0;" wx:if="{{expireTime}}">
        <text class="list-row-subtitle">有效期至:</text>
        <text class="text-amber text-xs">{{expireTime}}</text>
      </view>
    </view>
    <view wx:if="{{qrId}}" class="card" style="margin-top:var(--sp-1);padding:var(--sp-2);">
      <view class="list-row" style="padding:8rpx 0;">
        <text class="list-row-subtitle">二维码ID:</text>
        <text class="list-row-extra text-xs">{{qrId}}</text>
      </view>
      <view class="list-row" style="padding:8rpx 0;" wx:if="{{scene}}">
        <text class="list-row-subtitle">场景参数:</text>
        <text class="list-row-extra text-xs">{{scene}}</text>
      </view>
    </view>

    <!-- 操作按钮 -->
    <view class="qrcode-actions">
      <button
        class="qrcode-action primary"
        bindtap="onGenerate"
        disabled="{{generating}}"
        hover-class="tap-button-hover"
      >
        {{generating ? '生成中...' : (qrcodeUrl ? '重新生成' : '生成考勤二维码')}}
      </button>
      <button
        wx:if="{{qrcodeUrl && qrType !== 'text'}}"
        class="qrcode-action"
        bindtap="onSaveImage"
        hover-class="tap-button-hover"
      >
        保存到手机相册
      </button>
      <button
        wx:if="{{qrId}}"
        class="qrcode-action danger"
        bindtap="onRevoke"
        hover-class="tap-button-hover"
      >
        作废当前二维码
      </button>
    </view>
  </view>

  <!-- 说明 -->
  <view class="card-bento">
    <text class="menu-group-title" style="display:block;margin-bottom:var(--sp-2);">使用说明</text>
    <view class="flex-col" style="gap:10rpx;">
      <text class="text-tertiary text-sm">1. 点击"生成考勤二维码"按钮</text>
      <text class="text-tertiary text-sm">2. 将二维码展示给员工或保存并打印</text>
      <text class="text-tertiary text-sm">3. 员工用微信扫码后自动进入打卡页面</text>
      <text class="text-tertiary text-sm">4. 扫码打卡会标记为"扫码入口"，便于审计</text>
      <text class="text-tertiary text-sm">5. 二维码有效期默认24小时，可在设置中修改</text>
      <text class="text-tertiary text-sm">6. 若账号能力不足，将自动回退为小程序内扫码模式</text>
    </view>
  </view>
</view>
