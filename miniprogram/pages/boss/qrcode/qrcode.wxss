.container { padding-bottom: 60rpx; }

.qrcode-page {
  background: var(--bg-page);
}

.qrcode-actions {
  display: grid;
  grid-template-columns: 1fr;
  gap: 12rpx;
  margin-top: 34rpx;
}

.qrcode-action {
  width: 100%;
  min-height: 78rpx;
  border-radius: 22rpx;
  border: none;
  background: var(--surface-strong);
  color: var(--text-primary);
  font-size: 28rpx;
  font-weight: 650;
  display: flex;
  align-items: center;
  justify-content: center;
}

.qrcode-action.primary {
  background: #007AFF;
  color: #FFFFFF;
  box-shadow: var(--shadow-blue);
}

.qrcode-action.danger {
  background: rgba(255,59,48,0.09);
  color: #D92D20;
}

.qrcode-action::after {
  border: none;
}
