.container { padding-bottom: 60rpx; }

.subscription-status-card {
  border-left: none;
  background: linear-gradient(180deg, #FFFFFF 0%, #F8FAFC 100%);
}

.subscription-status-card.status-active {
  background: linear-gradient(180deg, #FFFFFF 0%, #F5F8FF 100%);
}

.subscription-status-card.status-trial {
  background: linear-gradient(180deg, #FFFFFF 0%, #F6FBF7 100%);
}

.subscription-status-card.status-grace_period {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8ED 100%);
}

.subscription-status-card.status-expired {
  background: linear-gradient(180deg, #FFFFFF 0%, #FFF8F8 100%);
}
