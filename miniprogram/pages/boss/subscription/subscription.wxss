page,
view,
text,
button {
  box-sizing: border-box;
}

page {
  background: #f4f7fb;
  overflow-x: hidden;
}

.container {
  width: 100%;
  max-width: 100vw;
  min-height: 100vh;
  padding: 24rpx;
  overflow-x: hidden;
}

.status-panel {
  width: 100%;
  margin-bottom: 24rpx;
  padding: 32rpx;
  border: 3rpx solid #2367a0;
  border-radius: 20rpx;
  background: #eef7ff;
}

.status-normal {
  border-color: #2367a0;
  background: #eef7ff;
}

.status-trial {
  border-color: #2f7d52;
  background: #effaf3;
}

.status-grace {
  border-color: #b7791f;
  background: #fff8e8;
}

.status-expired {
  border-color: #b42318;
  background: #fff2f0;
}

.status-label,
.factory-name,
.status-main,
.status-line,
.body-text,
.copy-text,
.empty-title {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.status-label {
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: bold;
  color: #2367a0;
}

.factory-name {
  margin-top: 14rpx;
  font-size: 42rpx;
  line-height: 1.3;
  font-weight: bold;
  color: #203650;
}

.status-main {
  margin-top: 18rpx;
  font-size: 52rpx;
  line-height: 1.25;
  font-weight: bold;
  color: #1f3550;
}

.status-line {
  margin-top: 12rpx;
  font-size: 32rpx;
  line-height: 1.5;
  color: #516a83;
}

.info-card {
  width: 100%;
  border-radius: 18rpx;
  box-shadow: none;
}

.body-text {
  font-size: 32rpx;
  line-height: 1.65;
  color: #425b75;
}

.button-stack {
  width: 100%;
  margin-top: 26rpx;
}

.button-stack .btn-default {
  margin-top: 18rpx;
}

.copy-box {
  width: 100%;
  padding: 24rpx;
  border: 2rpx solid #d8e4f1;
  border-radius: 16rpx;
  background: #f8fbff;
}

.copy-text {
  white-space: pre-wrap;
  font-size: 30rpx;
  line-height: 1.65;
  color: #283f58;
}

.empty-card {
  width: 100%;
  text-align: center;
}

.empty-title {
  margin-bottom: 24rpx;
  font-size: 34rpx;
  line-height: 1.5;
  color: #53677d;
}

.contact-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(15, 30, 46, 0.54);
}

.contact-dialog {
  width: 100%;
  max-width: 650rpx;
  max-height: 92vh;
  padding: 32rpx 28rpx 28rpx;
  border-radius: 20rpx;
  background: #fff;
  overflow-y: auto;
}

.contact-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.contact-title {
  font-size: 38rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #203650;
}

.contact-close {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
  color: #70869f;
}

.contact-desc,
.contact-hint {
  display: block;
  max-width: 100%;
  overflow-wrap: anywhere;
  word-break: break-all;
}

.contact-desc {
  margin-top: 12rpx;
  font-size: 30rpx;
  line-height: 1.55;
  color: #425b75;
}

.contact-qr {
  width: 100%;
  margin-top: 24rpx;
  border-radius: 12rpx;
  background: #f7f9fb;
}

.contact-hint {
  margin-top: 14rpx;
  text-align: center;
  font-size: 26rpx;
  line-height: 1.45;
  color: #6d8196;
}

.contact-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.contact-btn {
  flex: 1 1 0;
  min-width: 0;
  font-size: 30rpx;
}
