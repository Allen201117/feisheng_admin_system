<view class="container">
  <view class="page-header">
    <view class="page-header-left">
      <text class="page-header-title">数据中心</text>
      <text class="page-header-subtitle">查看工资、订单和生产数据</text>
    </view>
  </view>

  <view class="tab-bar">
    <view class="tab-item {{viewMode === 'month' ? 'tab-item-active' : ''}}" bindtap="switchMode" data-mode="month" hover-class="tap-chip-hover">按月查看</view>
    <view class="tab-item {{viewMode === 'order' ? 'tab-item-active' : ''}}" bindtap="switchMode" data-mode="order" hover-class="tap-chip-hover">按订单查看</view>
    <view class="tab-item {{viewMode === 'year' ? 'tab-item-active' : ''}}" bindtap="switchMode" data-mode="year" hover-class="tap-chip-hover">按年查看</view>
  </view>

  <block wx:if="{{viewMode !== 'order'}}">
    <view class="card-bento">
      <view wx:if="{{viewMode === 'month'}}" class="field-group">
        <text class="field-label">选择月份</text>
        <picker mode="date" fields="month" value="{{month}}" bindchange="onMonthChange">
          <view class="picker-field" hover-class="tap-row-hover">
            <text>{{month}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view wx:if="{{viewMode === 'year'}}" class="field-group">
        <text class="field-label">选择年份</text>
        <picker mode="date" fields="year" value="{{year}}" bindchange="onYearChange">
          <view class="picker-field" hover-class="tap-row-hover">
            <text>{{year}}</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>

      <view class="filter-chips" style="margin-bottom:var(--sp-2);">
        <view class="filter-chip {{reportType === 'summary' ? 'filter-chip-active' : ''}}" bindtap="switchReportType" data-type="summary" hover-class="tap-chip-hover">汇总表</view>
        <view class="filter-chip {{reportType === 'detail' ? 'filter-chip-active' : ''}}" bindtap="switchReportType" data-type="detail" hover-class="tap-chip-hover">明细表</view>
      </view>

      <view class="notice notice-blue">
        <text class="text-primary text-xs">{{pathHint}}</text>
      </view>
    </view>

    <view style="padding:var(--sp-1) 0;">
      <text class="font-bold text-primary text-md">{{periodDisplayLabel}} 报表预览</text>
    </view>

    <view wx:if="{{tableLoaded && tableRows.length > 0}}" class="card-bento">
      <view class="stats-grid">
        <view class="stats-card blue">
          <text class="stats-card-value">{{tableRows.length}}</text>
          <text class="stats-card-label">数据行数</text>
        </view>
        <view class="stats-card blue">
          <text class="stats-card-value">{{tableHeaders.length}}</text>
          <text class="stats-card-label">字段数量</text>
        </view>
      </view>
    </view>

    <view wx:if="{{tableLoaded}}" class="card-bento">
      <view class="flex-row gap-1" style="margin-bottom:var(--sp-2);">
        <text class="menu-group-title">{{tableTitle}}</text>
        <text class="badge badge-blue">预览</text>
      </view>

      <scroll-view scroll-x="true" style="width:100%;" wx:if="{{tableRows.length > 0}}">
        <view style="display:inline-flex;flex-direction:column;min-width:100%;">
          <view style="display:flex;">
            <view wx:for="{{tableHeaders}}" wx:key="index" wx:for-item="header" style="flex:0 0 {{tableColMeta[index].width || 200}}rpx;width:{{tableColMeta[index].width || 200}}rpx;padding:18rpx 16rpx;border:1rpx solid var(--border);font-size:var(--fs-xs);display:flex;align-items:center;box-sizing:border-box;background:var(--text-primary);color:#fff;font-weight:var(--fw-bold);">
              <text style="width:100%;word-break:break-all;line-height:1.3;text-align:{{tableColMeta[index].align || 'center'}};">{{header}}</text>
            </view>
          </view>

          <view wx:for="{{tableRows}}" wx:for-item="row" wx:for-index="rowIdx" style="display:flex;">
            <view wx:for="{{row}}" wx:for-item="cell" wx:for-index="colIdx" style="flex:0 0 {{tableColMeta[colIdx].width || 200}}rpx;width:{{tableColMeta[colIdx].width || 200}}rpx;padding:18rpx 16rpx;border:1rpx solid var(--border);font-size:var(--fs-xs);display:flex;align-items:center;box-sizing:border-box;{{rowIdx % 2 === 1 ? 'background:var(--bg-elevated);' : ''}}">
              <text class="{{tableColMeta[colIdx].isPrice ? 'price-strong' : ''}}" style="width:100%;word-break:break-all;line-height:1.3;text-align:{{tableColMeta[colIdx].align || 'center'}};">{{cell}}</text>
            </view>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{tableRows.length === 0}}" class="empty">
        <view class="empty-icon">
          <image src="/images/icons/database.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
        </view>
        <text class="empty-title">暂无数据</text>
        <text class="empty-desc">当前筛选条件下暂无数据，可调整时间或重新加载。</text>
        <view class="empty-action secondary" bindtap="loadPeriodTable" hover-class="tap-button-hover">重新加载</view>
      </view>
    </view>
  </block>

  <block wx:if="{{viewMode === 'order'}}">
    <block wx:if="{{selectedOrder}}">
      <view class="card-bento">
        <view class="tappable" bindtap="onBackToOrders" style="padding-bottom:var(--sp-2);border-bottom:1rpx solid var(--border);margin-bottom:var(--sp-2);" hover-class="tap-row-hover">
          <text class="text-accent font-semibold text-xs">← 返回订单列表</text>
        </view>
        <view class="flex-between">
          <text class="order-card-name">{{selectedOrder.order_name}}</text>
          <text class="badge {{selectedOrder.status === 'completed' ? 'badge-green' : selectedOrder.status === 'cancelled' ? 'badge-red' : 'badge-blue'}}">{{selectedOrder.statusText}}</text>
        </view>
      </view>

      <view class="card-bento">
        <view class="stats-grid">
          <view class="stats-card blue">
            <text class="stats-card-value text-accent">{{orderProgress.length}}</text>
            <text class="stats-card-label">工序数</text>
          </view>
          <view class="stats-card green">
            <text class="stats-card-value text-green">{{orderTotalReported}}</text>
            <text class="stats-card-label">总报工量</text>
          </view>
          <view class="stats-card amber">
            <text class="stats-card-value text-accent">{{orderOverallProgress}}%</text>
            <text class="stats-card-label">整体进度</text>
          </view>
        </view>
      </view>

      <view wx:if="{{orderProgress.length > 0}}" class="card-bento">
        <text class="menu-group-title" style="display:block;margin-bottom:var(--sp-2);">工序进度（实时工价）</text>
        <view wx:for="{{orderProgress}}" wx:for-item="item" wx:key="_id" class="list-row flex-wrap">
          <view class="flex-col gap-1" style="width:180rpx;flex-shrink:0;">
            <text class="list-row-title text-xs">{{item.process_name}}</text>
            <text wx:if="{{item.current_price === null || item.current_price === undefined}}" class="list-row-subtitle">工价未设置</text>
            <text wx:else class="price-strong">¥{{item.current_price}}/件</text>
          </view>
          <view class="progress-bar" style="flex:1;">
            <view class="progress-bar-fill" style="width: {{item.progress_percent || 0}}%;"></view>
          </view>
          <text class="text-accent font-semibold text-xs" style="width:80rpx;text-align:right;flex-shrink:0;">{{item.progress_percent || 0}}%</text>
        </view>
      </view>

      <view class="filter-chips" style="margin:var(--sp-2) 0;">
        <view class="filter-chip {{orderReportType === 'detail' ? 'filter-chip-active' : ''}}" bindtap="switchOrderReportType" data-type="detail" hover-class="tap-chip-hover">报工核算表</view>
        <view class="filter-chip {{orderReportType === 'summary' ? 'filter-chip-active' : ''}}" bindtap="switchOrderReportType" data-type="summary" hover-class="tap-chip-hover">工资核算表</view>
      </view>

      <view wx:if="{{orderTableLoaded}}" class="card-bento">
        <view class="flex-row gap-1" style="margin-bottom:var(--sp-2);">
          <text class="menu-group-title">{{orderTableTitle}}</text>
          <text class="badge badge-blue">预览</text>
        </view>

        <scroll-view scroll-x="true" style="width:100%;" wx:if="{{orderTableRows.length > 0}}">
          <view style="display:inline-flex;flex-direction:column;min-width:100%;">
            <view style="display:flex;">
              <view wx:for="{{orderTableHeaders}}" wx:key="index" wx:for-item="header" style="flex:0 0 {{orderTableColMeta[index].width || 200}}rpx;width:{{orderTableColMeta[index].width || 200}}rpx;padding:18rpx 16rpx;border:1rpx solid var(--border);font-size:var(--fs-xs);display:flex;align-items:center;box-sizing:border-box;background:var(--text-primary);color:#fff;font-weight:var(--fw-bold);">
                <text style="width:100%;word-break:break-all;line-height:1.3;text-align:{{orderTableColMeta[index].align || 'center'}};">{{header}}</text>
              </view>
            </view>

            <view wx:for="{{orderTableRows}}" wx:for-item="row" wx:for-index="rowIdx" style="display:flex;">
              <view wx:for="{{row}}" wx:for-item="cell" wx:for-index="colIdx" style="flex:0 0 {{orderTableColMeta[colIdx].width || 200}}rpx;width:{{orderTableColMeta[colIdx].width || 200}}rpx;padding:18rpx 16rpx;border:1rpx solid var(--border);font-size:var(--fs-xs);display:flex;align-items:center;box-sizing:border-box;{{rowIdx % 2 === 1 ? 'background:var(--bg-elevated);' : ''}}">
                <text class="{{orderTableColMeta[colIdx].isPrice ? 'price-strong' : ''}}" style="width:100%;word-break:break-all;line-height:1.3;text-align:{{orderTableColMeta[colIdx].align || 'center'}};">{{cell}}</text>
              </view>
            </view>
          </view>
        </scroll-view>

        <view wx:if="{{orderTableRows.length === 0}}" class="empty" style="padding:var(--sp-3) 0;">
          <view class="empty-icon">
            <image src="/images/icons/worklog.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
          </view>
          <text class="empty-title">此订单暂无报工</text>
          <text class="empty-desc">返回订单列表查看其他订单。</text>
          <view class="empty-action secondary" bindtap="onBackToOrders" hover-class="tap-button-hover">返回订单列表</view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view style="padding:var(--sp-1) 0;">
        <text class="font-bold text-primary text-md">全部订单</text>
      </view>

      <view wx:if="{{orderList.length === 0 && !loading}}" class="empty">
        <view class="empty-icon">
          <image src="/images/icons/orders.svg" mode="aspectFit" style="width:48rpx;height:48rpx;" />
        </view>
        <text class="empty-title">暂无订单</text>
        <text class="empty-desc">当前工厂还没有订单数据，刷新后可再次确认。</text>
        <view class="empty-action secondary" bindtap="loadOrders" hover-class="tap-button-hover">刷新订单</view>
      </view>

      <view wx:for="{{orderList}}" wx:for-item="item" wx:key="_id" class="order-card" bindtap="onOrderTap" data-order="{{item}}" hover-class="tap-card-hover" hover-stay-time="80">
        <view class="order-card-head">
          <text class="order-card-name">{{item.order_name}}</text>
          <text class="badge {{item.status === 'completed' ? 'badge-green' : item.status === 'cancelled' ? 'badge-red' : 'badge-blue'}}">{{item.statusText}}</text>
        </view>
        <view class="flex-between" style="margin-top:var(--sp-1);">
          <text class="list-row-subtitle">总量 {{item.totalQuantity}} 件 · {{item.processCount}} 道工序</text>
          <text class="text-accent text-xs">查看核算表 ▼</text>
        </view>
      </view>
    </block>
  </block>

  <view wx:if="{{loading}}" class="card-bento">
    <view class="skeleton skeleton-title"></view>
    <view class="skeleton skeleton-card"></view>
    <view class="skeleton skeleton-line"></view>
  </view>
</view>
