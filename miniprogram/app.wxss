/* app.wxss - 全局样式（老年人友好大字体版） */

/*
 * 全局字号体系（老年人友好）:
 *   --font-xs:   28rpx   辅助/次要信息
 *   --font-sm:   32rpx   次要正文
 *   --font-base: 36rpx   基础正文
 *   --font-lg:   40rpx   卡片标题/按钮
 *   --font-xl:   48rpx   页面标题/高亮数字
 *   --font-xxl:  64rpx   数据大字
 *   最小点击热区: 88rpx
 */

page {
  background:
    radial-gradient(circle at 12% 6%, rgba(145, 205, 255, 0.16) 0%, transparent 24%),
    radial-gradient(circle at 88% 10%, rgba(255, 212, 145, 0.16) 0%, transparent 24%),
    linear-gradient(180deg, #f3f8fd 0%, #f8fbfe 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', sans-serif;
  font-size: 36rpx;
  color: #23384f;
  box-sizing: border-box;
  line-height: 1.6;
}

/* 通用容器 */
.container {
  padding: 24rpx 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 卡片样式 */
.card {
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  border-radius: 22rpx;
  padding: 32rpx;
  margin-bottom: 28rpx;
  border: 2rpx solid #e6edf5;
  box-shadow: 0 10rpx 24rpx rgba(17, 38, 84, 0.08);
}

/* 标题 */
.section-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #1e3550;
  margin-bottom: 24rpx;
}

.sub-title {
  font-size: 32rpx;
  color: #8da0b4;
  margin-bottom: 18rpx;
}

/* 按钮样式 - 增大点击热区与字号 */
.btn-primary {
  background: linear-gradient(135deg, #1766b7 0%, #3f94ef 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 40rpx;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  min-height: 88rpx;
  line-height: 1.4;
  box-shadow: 0 12rpx 24rpx rgba(23, 102, 183, 0.18);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: normal;
  word-break: break-all;
}
.btn-primary:active { background: linear-gradient(135deg, #15599f 0%, #3387e3 100%); }

.btn-success {
  background: linear-gradient(135deg, #2f9558 0%, #57be80 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 40rpx;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  min-height: 88rpx;
  line-height: 1.4;
  box-shadow: 0 12rpx 24rpx rgba(47, 149, 88, 0.16);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: normal;
  word-break: break-all;
}
.btn-success:active { background: linear-gradient(135deg, #28824d 0%, #49aa70 100%); }

.btn-danger {
  background: linear-gradient(135deg, #d95243 0%, #ef7a6d 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 40rpx;
  font-size: 36rpx;
  font-weight: bold;
  text-align: center;
  min-height: 88rpx;
  line-height: 1.4;
  box-shadow: 0 12rpx 24rpx rgba(217, 82, 67, 0.14);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: normal;
  word-break: break-all;
}
.btn-danger:active { background: linear-gradient(135deg, #c5493b 0%, #e16d61 100%); }

.btn-warning {
  background: linear-gradient(135deg, #d99717 0%, #efbf5b 100%);
  color: #fff;
  border: none;
  border-radius: 16rpx;
  padding: 24rpx 40rpx;
  font-size: 36rpx;
  font-weight: bold;
  min-height: 88rpx;
  line-height: 1.4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: normal;
  word-break: break-all;
}

.btn-default {
  background: linear-gradient(180deg, #ffffff 0%, #f9fbfe 100%);
  color: #2a425d;
  border: 2rpx solid #d8e4f1;
  border-radius: 16rpx;
  padding: 24rpx 40rpx;
  font-size: 36rpx;
  min-height: 88rpx;
  line-height: 1.4;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  white-space: normal;
  word-break: break-all;
}

.btn-block {
  display: block;
  width: 100%;
}

.btn-lg {
  padding: 30rpx 50rpx;
  font-size: 40rpx;
  min-height: 100rpx;
}

.btn-disabled {
  opacity: 0.5;
  pointer-events: none;
}

/* 输入框 - 增大行高与字号 */
.input-group {
  margin-bottom: 32rpx;
}

.input-label {
  font-size: 34rpx;
  color: #62788f;
  margin-bottom: 12rpx;
  display: block;
}

.input-field {
  width: 100%;
  height: 96rpx;
  border: 2rpx solid #d8e4f1;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 36rpx;
  box-sizing: border-box;
  background: #fcfdff;
  color: #1f3554;
}
.input-field:focus { border-color: #1890FF; background: #fff; }

/* 列表 - 增大行高 */
.list-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 0;
  border-bottom: 1rpx solid #edf2f8;
  min-height: 88rpx;
}
.list-item:last-child { border-bottom: none; }

/* 状态标签 */
.tag {
  display: inline-block;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
  font-weight: bold;
}
.tag-pending { background: #fff4e4; color: #d58c10; }
.tag-success { background: #edf9f1; color: #2f9558; }
.tag-danger  { background: #fff1f0; color: #d95243; }
.tag-info    { background: #e8f4ff; color: #1766b7; }

/* 网格菜单 */
.grid-menu {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}
.grid-item {
  width: 30%;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 30rpx 0;
  margin-bottom: 20rpx;
}
.grid-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  font-size: 44rpx;
}
.grid-text {
  font-size: 30rpx;
  color: #666;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 88rpx 0;
}
.empty-text {
  font-size: 34rpx;
  color: #8ea0b2;
}

/* Flex 工具类 */
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.flex-center { display: flex; justify-content: center; align-items: center; }
.flex-1 { flex: 1; }

/* 间距工具类 */
.mt-20 { margin-top: 20rpx; }
.mt-30 { margin-top: 30rpx; }
.mb-20 { margin-bottom: 20rpx; }
.mb-30 { margin-bottom: 30rpx; }
.ml-20 { margin-left: 20rpx; }
.mr-20 { margin-right: 20rpx; }
.p-20 { padding: 20rpx; }
.p-30 { padding: 30rpx; }

/* 文字工具类 - 老年人友好字号 */
.text-center { text-align: center; }
.text-right { text-align: right; }
.text-bold { font-weight: bold; }
.text-sm { font-size: 28rpx; }
.text-md { font-size: 34rpx; }
.text-lg { font-size: 40rpx; }
.text-xl { font-size: 48rpx; }
.text-xxl { font-size: 64rpx; }
.text-primary { color: #1890FF; }
.text-success { color: #2f9558; }
.text-danger  { color: #d95243; }
.text-warning { color: #d99717; }
.text-gray { color: #8ea0b2; }
.text-dark { color: #23384f; }

/* 加载状态 */
.loading-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(255, 255, 255, 0.8);
  display: flex; align-items: center; justify-content: center;
  z-index: 999;
}

/* 数据统计卡片 */
.stat-card {
  background: linear-gradient(135deg, #15569d 0%, #2e81da 100%);
  border-radius: 22rpx;
  padding: 36rpx;
  color: #fff;
  margin-bottom: 28rpx;
  border: 2rpx solid rgba(195, 224, 255, 0.45);
  box-shadow: 0 16rpx 30rpx rgba(20, 86, 157, 0.18);
}
.stat-value {
  font-size: 64rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}
.stat-label {
  font-size: 30rpx;
  opacity: 0.85;
}

/* 通用弹窗 */
.modal-mask {
  position: fixed; top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  z-index: 1000;
  display: flex; align-items: center; justify-content: center;
}
.modal-content {
  width: 85%; max-height: 80vh;
  background: linear-gradient(180deg, #ffffff 0%, #fbfdff 100%);
  border-radius: 24rpx;
  border: 2rpx solid #e5edf5;
  box-shadow: 0 18rpx 36rpx rgba(17, 38, 84, 0.16);
  padding: 40rpx; overflow-y: auto;
}
.modal-header {
  display: flex; justify-content: space-between; align-items: center;
  margin-bottom: 30rpx;
}
.modal-close {
  font-size: 40rpx; color: #8ea0b2; padding: 10rpx;
}

/* 底部安全区 */
.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 选择器字段通用样式 */
.picker-field {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 96rpx;
  border: 2rpx solid #d8e4f1;
  border-radius: 16rpx;
  padding: 0 24rpx;
  background: #fcfdff;
  font-size: 34rpx;
}
.picker-arrow {
  font-size: 28rpx;
  color: #8ea0b2;
}

/* Tab 切换通用 */
.tabs, .tab-bar {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}
.tab, .tab-item {
  flex: 1;
  text-align: center;
  padding: 24rpx 0;
  font-size: 34rpx;
  color: #666;
  position: relative;
  min-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.tab-active {
  color: #1890FF;
  font-weight: bold;
  border-bottom: 4rpx solid #1890FF;
}

/* 小按钮 - 保证点击热区 */
.btn-xs {
  font-size: 28rpx;
  padding: 10rpx 20rpx;
  border-radius: 8rpx;
  border: none;
  min-height: 64rpx;
  line-height: 1.6;
  background: #E6F7FF;
  color: #1890FF;
}
.btn-xs::after { border: none; }
